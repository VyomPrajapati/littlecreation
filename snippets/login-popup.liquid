<div class="login-popup" id="login-popup" data-login-popup aria-hidden="true">
  <div class="login-popup__overlay" data-close-login onclick="document.getElementById('login-popup').classList.remove('is-open'); document.body.style.overflow = '';"></div>
  <div class="login-popup__content" role="dialog" aria-modal="true" aria-labelledby="login-popup-title">
    <button class="login-popup__close" data-close-login aria-label="Close">
      {% render 'icon-close' %}
    </button>
    
    <div class="login-popup__inner">
      <div class="login-popup__view" id="popup-view-login">
        <h2 id="login-popup-title" class="text-center">Sign in</h2>
        {%- form 'customer_login', novalidate: 'novalidate', class: 'mt-md' -%}
          <div class="field">
            <input type="email" name="customer[email]" placeholder="Email" class="field__input" required>
          </div>
          <div class="field mt-sm">
            <input type="password" name="customer[password]" placeholder="Password" class="field__input" required>
          </div>
          <button class="button button--full-width mt-md">Sign in</button>
          
          <div class="text-center mt-sm">
            <button type="button" class="text-link" onclick="document.getElementById('popup-view-login').style.display='none';document.getElementById('popup-view-recover').style.display='block';">Forgot password?</button>
            <br><br>
            <button type="button" class="text-link" onclick="document.getElementById('popup-view-login').style.display='none';document.getElementById('popup-view-register').style.display='block';">Create account</button>
          </div>
        {%- endform -%}
      </div>

      <div class="login-popup__view" id="popup-view-register" style="display:none;">
        <h2 class="text-center">Create account</h2>
        {%- form 'create_customer', novalidate: 'novalidate', class: 'mt-md' -%}
          <div class="field">
            <input type="text" name="customer[first_name]" placeholder="First name" class="field__input">
          </div>
          <div class="field mt-sm">
            <input type="text" name="customer[last_name]" placeholder="Last name" class="field__input">
          </div>
          <div class="field mt-sm">
            <input type="email" name="customer[email]" placeholder="Email" class="field__input" required>
          </div>
          <div class="field mt-sm">
            <input type="password" name="customer[password]" placeholder="Password" class="field__input" required>
          </div>
          <button class="button button--full-width mt-md">Create</button>
          <div class="text-center mt-sm">
            <button type="button" class="text-link" onclick="document.getElementById('popup-view-register').style.display='none';document.getElementById('popup-view-login').style.display='block';">Already have an account? Sign in</button>
          </div>
        {%- endform -%}
      </div>

      <div class="login-popup__view" id="popup-view-recover" style="display:none;">
        <h2 class="text-center">Reset password</h2>
        <p class="text-center">We will send you an email to reset your password.</p>
        {%- form 'recover_customer_password', class: 'mt-md' -%}
          <div class="field">
            <input type="email" name="email" placeholder="Email" class="field__input" required>
          </div>
          <button class="button button--full-width mt-md">Submit</button>
          <div class="text-center mt-sm">
            <button type="button" class="text-link" onclick="document.getElementById('popup-view-recover').style.display='none';document.getElementById('popup-view-login').style.display='block';">Cancel</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
.login-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 99999 !important;
  visibility: hidden;
  opacity: 0;
  display: none;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.login-popup.is-open {
  visibility: visible !important;
  opacity: 1 !important;
  display: block !important;
}
.login-popup__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(2px);
  cursor: pointer;
}
.login-popup__content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.95);
  width: 100%;
  max-width: 450px;
  background: var(--color-background);
  border-radius: var(--border-radius);
  padding: var(--spacing-lg);
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  transition: transform 0.3s ease;
}
.login-popup.is-open .login-popup__content {
  transform: translate(-50%, -50%) scale(1);
}
.login-popup__close {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
.text-link {
  background: none;
  border: none;
  color: var(--color-primary);
  text-decoration: underline;
  cursor: pointer;
  font-family: inherit;
  font-size: 0.9rem;
  padding: 0;
}
</style>

<script>
document.addEventListener('click', function(e) {
  const toggleBtn = e.target.closest('[data-login-toggle], a[href*="/account/login"], a[href*="/account/register"]');
  if (toggleBtn) {
    if (!window.location.pathname.includes('/account')) {
      e.preventDefault();
      const popup = document.getElementById('login-popup');
      if (popup) {
        popup.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        
        const isRegister = toggleBtn.href && toggleBtn.href.includes('register');
        const loginView = document.getElementById('popup-view-login');
        const registerView = document.getElementById('popup-view-register');
        
        if (loginView && registerView) {
          if (isRegister) {
            loginView.style.display = 'none';
            registerView.style.display = 'block';
          } else {
            registerView.style.display = 'none';
            loginView.style.display = 'block';
          }
        }
      }
    }
  }
  
  const closeBtn = e.target.closest('[data-close-login]');
  if (closeBtn) {
    e.preventDefault();
    const popup = document.getElementById('login-popup');
    if (popup) {
      popup.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  }
});
</script>
