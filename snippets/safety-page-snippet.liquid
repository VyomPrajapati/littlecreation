        <li class="pdf-item"><span class="pdf-num">2.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Lion Rattle Teether Safety Declaration</u></a></li>
        <li class="pdf-item"><span class="pdf-num">3.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Cooling Teether Safety Declaration</u></a></li>
        <li class="pdf-item"><span class="pdf-num">4.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Swan Wooden Ring Teether Declaration</u></a></li>
      </ol>
    </div>

  </div>
</section>

