{%- comment -%}
  Predictive Live Search Modal Overlay
  Little Creation Shopify Theme
{%- endcomment -%}

<div class="search-modal" data-search-modal aria-hidden="true">
  <div class="search-modal__backdrop" data-search-close></div>

  <div class="search-modal__content">
    <div class="search-modal__header">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
        <span class="search-modal__form-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </span>
        <input type="search"
               name="q"
               class="search-modal__input"
               placeholder="Search our teethers & rattles..."
               autocomplete="off"
               autocorrect="off"
               autocapitalize="off"
               spellcheck="false"
               data-search-input>
        <button type="button" class="search-modal__clear" data-search-clear aria-label="Clear search" style="display:none;">&times;</button>
      </form>
      <button type="button" class="search-modal__close" data-search-close aria-label="Close search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Quick Tags -->
    <div class="search-modal__quick-tags">
      <span class="search-modal__quick-label">Popular Searches:</span>
      <button type="button" class="search-tag" data-quick-search="Rattle">🧸 Rattle Teether</button>
      <button type="button" class="search-tag" data-quick-search="Water">💧 Water-Filled</button>
      <button type="button" class="search-tag" data-quick-search="Swan">🪵 Swan Wooden</button>
    </div>

    <!-- Live Results Section -->
    <div class="search-modal__results" data-search-results>
      <div class="search-modal__initial-state">
        <p>Type above to start searching products instantly...</p>
      </div>
    </div>
  </div>
</div>

<style>
.search-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 80px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}
.search-modal.is-open {
  opacity: 1;
  visibility: visible;
}

.search-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 17, 17, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.search-modal__content {
  position: relative;
  width: 90%;
  max-width: 680px;
  background: var(--color-white, #FFFFFF);
  border-radius: var(--radius-xl, 24px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  border: 1.5px solid var(--color-border, #E8D5C4);
  padding: 24px;
  transform: translateY(-20px);
  transition: transform 0.25s ease;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.search-modal.is-open .search-modal__content {
  transform: translateY(0);
}

.search-modal__header {
  display: flex;
  align-items: center;
  gap: 12px;
}
.search-modal__form {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}
.search-modal__form-icon {
  position: absolute;
  left: 16px;
  color: var(--color-primary-dark, #A07855);
  pointer-events: none;
  display: flex;
}
.search-modal__input {
  width: 100%;
  padding: 14px 44px 14px 50px;
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-pill, 999px);
  font-family: var(--font-body-family);
  font-size: 1rem;
  color: var(--color-heading, #111111);
  background: var(--color-skin-pale, #FBF0E8);
  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.search-modal__input:focus {
  border-color: var(--color-primary, #C69A7C);
  background: var(--color-white);
  box-shadow: 0 0 0 3px rgba(198,154,124,0.18);
}
.search-modal__clear {
  position: absolute;
  right: 16px;
  background: none;
  border: none;
  font-size: 1.4rem;
  color: #999;
  cursor: pointer;
  line-height: 1;
}
.search-modal__close {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid var(--color-border, #E8D5C4);
  background: var(--color-white);
  color: var(--color-heading);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease;
  flex-shrink: 0;
}
.search-modal__close:hover {
  background: var(--color-skin-pale, #FBF0E8);
}

.search-modal__quick-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--color-border, #E8D5C4);
}
.search-modal__quick-label {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted, #7A6A5A);
}
.search-tag {
  background: var(--color-skin-pale, #FBF0E8);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-pill, 999px);
  padding: 5px 14px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-heading, #111111);
  cursor: pointer;
  transition: all 0.2s ease;
}
.search-tag:hover {
  background: var(--color-primary, #C69A7C);
  color: #fff;
  border-color: var(--color-primary);
}

.search-modal__results {
  margin-top: 16px;
  overflow-y: auto;
  flex: 1;
}
.search-modal__initial-state {
  text-align: center;
  padding: 30px 0;
  color: var(--color-text-muted, #7A6A5A);
  font-size: 0.9rem;
}

.search-modal__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
}
.search-modal__item {
  display: flex;
  flex-direction: column;
  background: var(--color-white);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-md, 16px);
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.search-modal__item:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md, 0 6px 18px rgba(0,0,0,0.06));
}
.search-modal__item-img {
  aspect-ratio: 1/1;
  background: var(--color-skin-pale, #FBF0E8);
  width: 100%;
  object-fit: cover;
}
.search-modal__item-info {
  padding: 12px;
}
.search-modal__item-title {
  font-family: var(--font-heading-family);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--color-heading, #111111);
  margin: 0 0 4px 0;
  line-height: 1.3;
}
.search-modal__item-price {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--color-primary-dark, #A07855);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const searchModal = document.querySelector('[data-search-modal]');
  if (!searchModal) return;

  const searchInput = searchModal.querySelector('[data-search-input]');
  const searchResults = searchModal.querySelector('[data-search-results]');
  const searchClear = searchModal.querySelector('[data-search-clear]');
  const closeBtns = searchModal.querySelectorAll('[data-search-close]');
  const quickTags = searchModal.querySelectorAll('[data-quick-search]');

  const openModal = () => {
    searchModal.classList.add('is-open');
    searchModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => searchInput && searchInput.focus(), 150);
  };

  const closeModal = () => {
    searchModal.classList.remove('is-open');
    searchModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  // Toggle buttons in header
  document.querySelectorAll('[data-search-toggle]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  closeBtns.forEach(btn => btn.addEventListener('click', closeModal));

  // ESC key to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchModal.classList.contains('is-open')) {
      closeModal();
    }
  });

  // Clear button
  if (searchInput && searchClear) {
    searchInput.addEventListener('input', () => {
      searchClear.style.display = searchInput.value.length > 0 ? 'block' : 'none';
      handleSearch(searchInput.value.trim());
    });
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.style.display = 'none';
      searchResults.innerHTML = '<div class="search-modal__initial-state"><p>Type above to start searching products instantly...</p></div>';
      searchInput.focus();
    });
  }

  // Quick Tags
  quickTags.forEach(tag => {
    tag.addEventListener('click', () => {
      const q = tag.dataset.quickSearch;
      if (searchInput) {
        searchInput.value = q;
        if (searchClear) searchClear.style.display = 'block';
        handleSearch(q);
      }
    });
  });

  // Predictive API Fetch
  let debounceTimer;
  function handleSearch(query) {
    clearTimeout(debounceTimer);
    if (!query) {
      searchResults.innerHTML = '<div class="search-modal__initial-state"><p>Type above to start searching products instantly...</p></div>';
      return;
    }

    debounceTimer = setTimeout(() => {
      searchResults.innerHTML = '<div class="search-modal__initial-state"><p>Searching products...</p></div>';

      fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`)
        .then(res => res.json())
        .then(data => {
          const products = data.resources?.results?.products || [];
          if (!products.length) {
            searchResults.innerHTML = `<div class="search-modal__initial-state"><p>No products found for "${query}".</p></div>`;
            return;
          }

          let html = '<div class="search-modal__grid">';
          products.forEach(p => {
            html += `
              <a href="${p.url}" class="search-modal__item">
                <img src="${p.image || p.featured_image?.url || ''}" alt="${p.title}" class="search-modal__item-img" loading="lazy">
                <div class="search-modal__item-info">
                  <h5 class="search-modal__item-title">${p.title}</h5>
                  <span class="search-modal__item-price">${p.price ? '£' + (p.price).toFixed(2) : ''}</span>
                </div>
              </a>
            `;
          });
          html += '</div>';
          searchResults.innerHTML = html;
        })
        .catch(() => {
          searchResults.innerHTML = '<div class="search-modal__initial-state"><p>Error fetching search results.</p></div>';
        });
    }, 200);
  }
});
</script>
