{%- comment -%}
  Cleaning & Care Instructions Snippet
  Little Creation Shopify Theme
{%- endcomment -%}

{%- assign cleaning_type = '' -%}
{%- assign product_tags_lower = product.tags | join: ',' | downcase -%}
{%- assign product_title_lower = product.title | downcase -%}

{%- comment -%} Check Product Tags First {%- endcomment -%}
{%- if product_tags_lower contains 'water-filled' or product_tags_lower contains 'water_filled' or product_tags_lower contains 'water' -%}
  {%- assign cleaning_type = 'water_filled' -%}
{%- elsif product_tags_lower contains 'swan-wooden' or product_tags_lower contains 'swan_wooden' or product_tags_lower contains 'wooden' or product_tags_lower contains 'wood' or product_tags_lower contains 'swan' -%}
  {%- assign cleaning_type = 'swan_wooden' -%}
{%- elsif product_tags_lower contains 'rattle' -%}
  {%- assign cleaning_type = 'rattle' -%}
{%- comment -%} Fallback to Title Keyword Matching if no tags present {%- endcomment -%}
{%- elsif product_title_lower contains 'water' -%}
  {%- assign cleaning_type = 'water_filled' -%}
{%- elsif product_title_lower contains 'swan' or product_title_lower contains 'wood' -%}
  {%- assign cleaning_type = 'swan_wooden' -%}
{%- else -%}
  {%- assign cleaning_type = 'rattle' -%}
{%- endif -%}

<div class="cleaning-card">
  <details class="cleaning-card__accordion" open>
    <summary class="cleaning-card__summary">
      <div class="cleaning-card__title">
        <span class="cleaning-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
          </svg>
        </span>
        <div>
          <h3 class="cleaning-card__heading">Cleaning & Care Instructions</h3>
          <span class="cleaning-card__subheading">
            {% if cleaning_type == 'water_filled' %}
              Water-Filled Teether Care Guide
            {% elsif cleaning_type == 'swan_wooden' %}
              Swan Wooden Teether Care Guide
            {% else %}
              Rattle Teether Care Guide
            {% endif %}
          </span>
        </div>
      </div>
      <span class="cleaning-card__toggle-icon" aria-hidden="true">
        <svg class="icon-chevron-down" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </span>
    </summary>

    <div class="cleaning-card__content">

      {% if cleaning_type == 'water_filled' %}
        <!-- 1. WATER-FILLED TEETHER INSTRUCTIONS -->
        <div class="cleaning-card__section">
          <div class="cleaning-badges">
            <span class="cleaning-badge cleaning-badge--info">💧 Water-Filled</span>
            <span class="cleaning-badge cleaning-badge--warn">❄️ Refrigerator Only</span>
            <span class="cleaning-badge cleaning-badge--alert">🚫 Do Not Boil</span>
          </div>

          <ul class="cleaning-steps">
            <li>
              <strong class="cleaning-step__title">First Use & Daily Cleaning:</strong>
              <p>Wash with warm soapy water before first use and rinse thoroughly to remove all soap residue. Wash with soapy water and rinse well before each daily use.</p>
            </li>
            <li>
              <strong class="cleaning-step__title">Drying & Storage:</strong>
              <p>After washing, wipe dry with a clean cloth and place in a well-ventilated, dry place.</p>
            </li>
            <li class="cleaning-step--highlight-cool">
              <strong class="cleaning-step__title">Cooling Instructions:</strong>
              <p>Cool ONLY in the refrigerator. <strong>Do NOT place in the freezer compartment.</strong></p>
            </li>
          </ul>

          <div class="cleaning-warnings">
            <div class="cleaning-warning__title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>Important Warnings (DO NOTs):</span>
            </div>
            <ul class="cleaning-donts">
              <li><strong>DO NOT Boil, Microwave, or Sterilize:</strong> High heat will deform the water-filled chamber or cause leaks.</li>
              <li><strong>Keep Heat Under 140°F / 60°C:</strong> Always avoid exposure to extreme temperatures.</li>
              <li><strong>DO NOT Place in Freezer:</strong> Freezing makes liquid solid and rigid, which can damage the teether and hurt baby's gums.</li>
              <li><strong>DO NOT Use Harsh Chemicals:</strong> Avoid abrasive detergents, alcohol, or harsh cleaners.</li>
              <li><strong>DO NOT Place in Dishwasher:</strong> Dishwasher heat cycles will cause damage.</li>
            </ul>
          </div>
        </div>

      {% elsif cleaning_type == 'swan_wooden' %}
        <!-- 2. SWAN WOODEN TEETHER INSTRUCTIONS -->
        <div class="cleaning-card__section">
          <div class="cleaning-badges">
            <span class="cleaning-badge cleaning-badge--info">🪵 Natural Wood & Silicone</span>
            <span class="cleaning-badge cleaning-badge--warn">🧼 Hand Wash Only</span>
            <span class="cleaning-badge cleaning-badge--alert">🚫 Do Not Submerge Wood</span>
          </div>

          <ul class="cleaning-steps">
            <li>
              <strong class="cleaning-step__title">First Use & Daily Cleaning:</strong>
              <p>Wash silicone parts with warm soapy water before first use and rinse thoroughly to remove soap residue. Clean before each daily use with mild soapy water and rinse well.</p>
            </li>
            <li>
              <strong class="cleaning-step__title">Drying & Storage:</strong>
              <p>After washing, immediately wipe dry with a clean, soft cloth and leave in a dry, ventilated area to air dry completely.</p>
            </li>
          </ul>

          <div class="cleaning-warnings">
            <div class="cleaning-warning__title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>Important Warnings (DO NOTs):</span>
            </div>
            <ul class="cleaning-donts">
              <li><strong>DO NOT Boil, Microwave, or Sterilize:</strong> High heat damages wooden components.</li>
              <li><strong>Keep Heat Under 140°F / 60°C:</strong> Protect natural wood and food-grade silicone.</li>
              <li><strong>DO NOT Submerge Wooden Parts:</strong> Do not leave wooden teether soaking in water.</li>
              <li><strong>DO NOT Use Harsh Chemicals:</strong> Avoid strong detergents or bleach.</li>
              <li><strong>DO NOT Place in Dishwasher:</strong> Dishwashers cause wood to swell or crack.</li>
            </ul>
          </div>
        </div>

      {% else %}
        <!-- 3. RATTLE TEETHER INSTRUCTIONS (Both Colours) -->
        <div class="cleaning-card__section">
          <div class="cleaning-badges">
            <span class="cleaning-badge cleaning-badge--info">🧸 Silicone & Rattle</span>
            <span class="cleaning-badge cleaning-badge--success">♨️ Boil Safe (3 mins)</span>
            <span class="cleaning-badge cleaning-badge--warn">🧼 Hand Wash</span>
          </div>

          <ul class="cleaning-steps">
            <li>
              <strong class="cleaning-step__title">First Use & Daily Cleaning:</strong>
              <p>Wash silicone teether with warm soapy water before first use and rinse thoroughly to remove soap residue. Wash with soapy water and rinse well before each daily use.</p>
            </li>
            <li>
              <strong class="cleaning-step__title">Disinfection (Optional):</strong>
              <p>Can be disinfected in boiling water for <strong>3 minutes maximum</strong> after washing.</p>
            </li>
            <li>
              <strong class="cleaning-step__title">Drying & Storage:</strong>
              <p>After washing, wipe dry with a clean cloth and place in a ventilated, dry area.</p>
            </li>
          </ul>

          <div class="cleaning-warnings">
            <div class="cleaning-warning__title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>Important Care Warnings:</span>
            </div>
            <ul class="cleaning-donts">
              <li><strong>Do Not Heat Over 140°F / 60°C:</strong> Avoid prolonged extreme heat beyond the 3 min boiling limit.</li>
              <li><strong>DO NOT Microwave or Steam Sterilize:</strong> Use gentle boiling water or hand washing only.</li>
              <li><strong>DO NOT Use Harsh Chemicals:</strong> Avoid aggressive cleaning agents or solvents.</li>
              <li><strong>DO NOT Place in Dishwasher:</strong> Hand washing ensures longest product life.</li>
            </ul>
          </div>
        </div>
      {% endif %}

    </div>
  </details>
</div>

<style>
.cleaning-card {
  margin-top: var(--spacing-md, 24px);
  background: var(--color-white, #ffffff);
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 20px);
  box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.04));
  overflow: hidden;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.cleaning-card:hover {
  border-color: var(--color-primary, #C69A7C);
  box-shadow: var(--shadow-md, 0 4px 16px rgba(0,0,0,0.06));
}

.cleaning-card__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  cursor: pointer;
  list-style: none;
  background: var(--color-skin-pale, #FBF0E8);
  user-select: none;
}
.cleaning-card__summary::-webkit-details-marker { display: none; }

.cleaning-card__title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.cleaning-card__icon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-primary-dark, #A07855);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.cleaning-card__heading {
  font-family: var(--font-heading-family);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-heading, #111111);
  margin: 0;
  line-height: 1.2;
}
.cleaning-card__subheading {
  font-size: 0.78rem;
  color: var(--color-primary-dark, #A07855);
  font-weight: 600;
  display: block;
  margin-top: 2px;
}
.cleaning-card__toggle-icon {
  color: var(--color-primary-dark, #A07855);
  transition: transform 0.25s ease;
}
.cleaning-card__accordion[open] .cleaning-card__toggle-icon {
  transform: rotate(180deg);
}

.cleaning-card__content {
  padding: 20px;
  background: var(--color-white);
}

.cleaning-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.cleaning-badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 20px;
  letter-spacing: 0.02em;
}
.cleaning-badge--info {
  background: #EBF5FF;
  color: #1E40AF;
}
.cleaning-badge--warn {
  background: #FEF3C7;
  color: #92400E;
}
.cleaning-badge--alert {
  background: #FEE2E2;
  color: #991B1B;
}
.cleaning-badge--success {
  background: #D1FAE5;
  color: #065F46;
}

.cleaning-steps {
  list-style: none;
  padding: 0;
  margin: 0 0 18px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cleaning-steps li {
  position: relative;
  padding-left: 24px;
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--color-text, #3A2E27);
}
.cleaning-steps li::before {
  content: "✓";
  position: absolute;
  left: 0;
  top: 1px;
  font-weight: 900;
  color: #059669;
  font-size: 1rem;
}
.cleaning-steps p {
  margin: 2px 0 0 0;
  color: var(--color-text);
  font-size: 0.88rem;
}
.cleaning-step__title {
  color: var(--color-heading, #111111);
  font-weight: 700;
}
.cleaning-step--highlight-cool {
  background: #EFF6FF;
  border-left: 3px solid #2563EB;
  padding: 10px 12px 10px 14px !important;
  border-radius: 8px;
  margin-top: 4px;
}
.cleaning-step--highlight-cool::before {
  display: none;
}

.cleaning-warnings {
  background: #FFF5F5;
  border: 1px solid #FECDD3;
  border-radius: 12px;
  padding: 14px 16px;
  margin-top: 16px;
}
.cleaning-warning__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 0.85rem;
  color: #991B1B;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 10px;
}
.cleaning-warning__title svg { stroke: #991B1B; }

.cleaning-donts {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.cleaning-donts li {
  position: relative;
  padding-left: 20px;
  font-size: 0.84rem;
  line-height: 1.45;
  color: #7F1D1D;
}
.cleaning-donts li::before {
  content: "✕";
  position: absolute;
  left: 0;
  top: 1px;
  font-weight: 800;
  color: #DC2626;
  font-size: 0.85rem;
}
</style>
