{%- comment -%}
  Interactive Wholesale / Distributor Application Form Snippet
{%- endcomment -%}

<div class="custom-app-form-wrapper">
  <div class="custom-app-form-card">

    <div class="custom-app-form-header">
      <span class="custom-app-badge">Partner With Us</span>
      <h2 class="custom-app-title">Distributor Application Form</h2>
      <p class="custom-app-subtitle">Fill out the form below with your business details and our partner team will review your application within 24 hours.</p>
    </div>

    {%- form 'contact', id: 'WholesaleApplicationFormSnippet', class: 'custom-app-form-body' -%}

      {%- if form.posted_successfully? -%}
        <div class="custom-app-alert custom-app-alert--success">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Thanks for applying! Our wholesale team will review your details and reach out shortly.</span>
        </div>
      {%- elsif form.errors -%}
        <div class="custom-app-alert custom-app-alert--error">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>Please check your wholesale details and try again.</span>
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Form Subject]" value="Wholesale / Distributor Application">

      <div class="custom-app-grid">

        <div class="custom-app-field">
          <label for="Wholesale-name">Full Name *</label>
          <input type="text" id="Wholesale-name" name="contact[Full Name]" class="custom-app-input" placeholder="e.g. Sarah Jenkins" required>
        </div>

        <div class="custom-app-field">
          <label for="Wholesale-email">Email Address *</label>
          <input type="email" id="Wholesale-email" name="contact[email]" class="custom-app-input" placeholder="e.g. sarah@example.com" required>
        </div>

        <div class="custom-app-field">
          <label for="Wholesale-biz">Business Name & Website / Social Links *</label>
          <input type="text" id="Wholesale-biz" name="contact[Business Name & Website]" class="custom-app-input" placeholder="e.g. BabyBoutique / www.babyboutique.co.uk" required>
        </div>

        <div class="custom-app-field">
          <label for="Wholesale-storetype">Store Type *</label>
          <select id="Wholesale-storetype" name="contact[Store Type]" class="custom-app-input custom-app-select" required>
            <option value="" disabled selected>Select Store Type...</option>
            <option value="Online Only">Online Store</option>
            <option value="Brick & Mortar Shop">Brick & Mortar Retail Shop</option>
            <option value="Both (Online & Physical Shop)">Both (Online & Physical Store)</option>
            <option value="Distributor / Chain Store">Distributor / Pharmacy Chain</option>
          </select>
        </div>

        <div class="custom-app-field">
          <label for="Wholesale-qty">Estimated Initial Order Quantity *</label>
          <input type="text" id="Wholesale-qty" name="contact[Estimated Initial Order Quantity]" class="custom-app-input" placeholder="e.g. 50 - 100 units" required>
        </div>

        <div class="custom-app-field">
          <label for="Wholesale-location">Location / Country *</label>
          <input type="text" id="Wholesale-location" name="contact[Location / Country]" class="custom-app-input" placeholder="e.g. London, United Kingdom" required>
        </div>

        <div class="custom-app-field custom-app-field--full">
          <label for="Wholesale-body">Additional Details / Product Inquiries (Optional)</label>
          <textarea id="Wholesale-body" name="contact[Additional Details]" class="custom-app-input custom-app-textarea" rows="3" placeholder="Tell us more about your store and products you are interested in stocking...">{{- form.body -}}</textarea>
        </div>

        <div class="custom-app-field custom-app-field--full">
          <button type="submit" class="custom-app-btn">
            <span>Submit Distributor Application</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>

      </div>

    {%- endform -%}

  </div>
</div>

<style>
.custom-app-form-wrapper {
  width: 100% !important;
  max-width: 900px !important;
  margin: 30px auto 50px auto !important;
  padding: 0 15px !important;
  box-sizing: border-box !important;
}

.custom-app-form-card {
  background-color: #FBF0E8 !important;
  border: 1.5px solid #E8D5C4 !important;
  border-radius: 24px !important;
  padding: 40px 45px !important;
  box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05) !important;
  box-sizing: border-box !important;
}

@media screen and (max-width: 768px) {
  .custom-app-form-card {
    padding: 24px 20px !important;
    border-radius: 18px !important;
  }
}

.custom-app-form-header {
  text-align: center !important;
  margin-bottom: 32px !important;
}

.custom-app-badge {
  display: inline-block !important;
  background-color: #E8D5C4 !important;
  color: #4A3E37 !important;
  font-size: 0.75rem !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.1em !important;
  padding: 6px 16px !important;
  border-radius: 50px !important;
  margin-bottom: 12px !important;
}

.custom-app-title {
  font-family: inherit !important;
  font-size: 2rem !important;
  font-weight: 800 !important;
  color: #111111 !important;
  margin: 0 0 10px 0 !important;
  padding: 0 !important;
  border: none !important;
}

.custom-app-subtitle {
  font-size: 1rem !important;
  color: #55443B !important;
  margin: 0 !important;
  line-height: 1.5 !important;
}

.custom-app-grid {
  display: grid !important;
  grid-template-columns: repeat(2, 1fr) !important;
  gap: 20px 24px !important;
}

@media screen and (max-width: 640px) {
  .custom-app-grid {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }
}

.custom-app-field {
  display: flex !important;
  flex-direction: column !important;
  gap: 6px !important;
}

.custom-app-field--full {
  grid-column: 1 / -1 !important;
}

.custom-app-field label {
  font-size: 0.8rem !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  color: #222222 !important;
  margin: 0 !important;
}

.custom-app-input {
  width: 100% !important;
  height: 48px !important;
  padding: 10px 16px !important;
  background-color: #FFFFFF !important;
  border: 1.5px solid #E8D5C4 !important;
  border-radius: 12px !important;
  font-size: 0.95rem !important;
  color: #111111 !important;
  box-sizing: border-box !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  appearance: auto !important;
}

.custom-app-textarea {
  height: auto !important;
  min-height: 100px !important;
  resize: vertical !important;
}

.custom-app-input:focus {
  outline: none !important;
  border-color: #A07855 !important;
  box-shadow: 0 0 0 3px rgba(160, 120, 85, 0.2) !important;
}

.custom-app-btn {
  width: 100% !important;
  height: 52px !important;
  background: linear-gradient(135deg, #C69A7C, #A07855) !important;
  color: #FFFFFF !important;
  border: none !important;
  border-radius: 50px !important;
  font-size: 1.05rem !important;
  font-weight: 700 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10px !important;
  cursor: pointer !important;
  box-shadow: 0 6px 18px rgba(160, 120, 85, 0.3) !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease !important;
  margin-top: 10px !important;
}

.custom-app-btn:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 8px 25px rgba(160, 120, 85, 0.4) !important;
}

.custom-app-alert {
  padding: 14px 18px !important;
  border-radius: 12px !important;
  margin-bottom: 20px !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  font-size: 0.92rem !important;
  font-weight: 600 !important;
}
.custom-app-alert--success {
  background: #EBFBEE !important;
  color: #2B8A3E !important;
  border: 1px solid #B2F2BB !important;
}
.custom-app-alert--error {
  background: #FFF5F5 !important;
  color: #E03131 !important;
  border: 1px solid #FFC9C9 !important;
}
</style>
