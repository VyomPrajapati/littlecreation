{%- comment -%}
  Interactive Wholesale / Distributor Application Form Snippet
{%- endcomment -%}

<div class="affiliate-app-section">
  <div class="container">
    <div class="affiliate-app-card">

      <div class="affiliate-app-header text-center">
        <span class="section-label">Wholesale Opportunities</span>
        <h2 class="affiliate-app-title">Apply for a Wholesale Account</h2>
        <p class="affiliate-app-subtext">Fill out the form below with your business details and our wholesale team will review your application within 24 hours.</p>
      </div>

      {%- form 'contact', id: 'WholesaleApplicationFormSnippet', class: 'affiliate-form' -%}

        {%- if form.posted_successfully? -%}
          <div class="affiliate-form__alert affiliate-form__alert--success">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Thanks for applying! Our wholesale team will review your details and reach out shortly.</span>
          </div>
        {%- elsif form.errors -%}
          <div class="affiliate-form__alert affiliate-form__alert--error">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Please check your wholesale details and try again.</span>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[Form Subject]" value="Wholesale / Distributor Application">

        <div class="affiliate-form-grid">

          <div class="affiliate-form-field">
            <label for="Wholesale-name">Full Name *</label>
            <input type="text" id="Wholesale-name" name="contact[Full Name]" placeholder="e.g. Sarah Jenkins" required>
          </div>

          <div class="affiliate-form-field">
            <label for="Wholesale-email">Email Address *</label>
            <input type="email" id="Wholesale-email" name="contact[email]" placeholder="e.g. sarah@example.com" required>
          </div>

          <div class="affiliate-form-field">
            <label for="Wholesale-biz">Business Name & Website / Social Links *</label>
            <input type="text" id="Wholesale-biz" name="contact[Business Name & Website]" placeholder="e.g. BabyBoutique / www.babyboutique.co.uk" required>
          </div>

          <div class="affiliate-form-field">
            <label for="Wholesale-storetype">Store Type *</label>
            <select id="Wholesale-storetype" name="contact[Store Type]" class="affiliate-form-select" required>
              <option value="" disabled selected>Select Store Type...</option>
              <option value="Online Only">Online Store</option>
              <option value="Brick & Mortar Shop">Brick & Mortar Retail Shop</option>
              <option value="Both (Online & Physical Shop)">Both (Online & Physical Store)</option>
              <option value="Distributor / Chain Store">Distributor / Pharmacy Chain</option>
            </select>
          </div>

          <div class="affiliate-form-field">
            <label for="Wholesale-qty">Estimated Initial Order Quantity *</label>
            <input type="text" id="Wholesale-qty" name="contact[Estimated Initial Order Quantity]" placeholder="e.g. 50 - 100 units" required>
          </div>

          <div class="affiliate-form-field">
            <label for="Wholesale-location">Location / Country *</label>
            <input type="text" id="Wholesale-location" name="contact[Location / Country]" placeholder="e.g. London, United Kingdom" required>
          </div>

          <div class="affiliate-form-field affiliate-form-field--full">
            <label for="Wholesale-body">Additional Details / Product Inquiries (Optional)</label>
            <textarea id="Wholesale-body" name="contact[Additional Details]" rows="3" placeholder="Tell us more about your store and products you are interested in stocking...">{{- form.body -}}</textarea>
          </div>

          <div class="affiliate-form-field affiliate-form-field--full">
            <button type="submit" class="affiliate-submit-btn">
              <span>Submit Wholesale Application</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>

        </div>

      {%- endform -%}

    </div>
  </div>
</div>

<style>
.affiliate-form-select {
  width: 100%;
  padding: 12px 16px;
  background: #FFFFFF;
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: 12px;
  font-size: 0.95rem;
  color: #111111;
  font-family: inherit;
}
.affiliate-form-select:focus {
  outline: none;
  border-color: var(--color-primary-dark, #A07855);
  box-shadow: 0 0 0 3px rgba(160, 120, 85, 0.15);
}
</style>
