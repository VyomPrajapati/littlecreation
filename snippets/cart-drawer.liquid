{% comment %} Cart Drawer - renders live cart data {% endcomment %}
<div class="cart-drawer" data-cart-drawer>
  <div class="cart-drawer__overlay" data-close-cart></div>
  <div class="cart-drawer__content">

    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart <span class="cart-drawer__count" id="CartDrawerCount">({{ cart.item_count }})</span></h2>
      <button class="cart-drawer__close" data-close-cart aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="cart-drawer__body" id="CartDrawerBody">
      {% render 'cart-drawer-items' %}
    </div>

    <div class="cart-drawer__footer" id="CartDrawerFooter" {% if cart.item_count == 0 %}style="display:none"{% endif %}>
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong id="CartDrawerSubtotal">{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-drawer__taxes">Taxes and shipping calculated at checkout</p>
      <a href="{{ routes.checkout_url }}" class="button button--full-width cart-drawer__checkout">
        Checkout
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">View full cart</a>
    </div>

  </div>
</div>

<style>
/* ---- Cart Drawer Shell ---- */
.cart-drawer {
  position: fixed;
  inset: 0;
  z-index: 500;
  visibility: hidden;
  pointer-events: none;
}
.cart-drawer.is-open {
  visibility: visible;
  pointer-events: all;
}
.cart-drawer__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 0.3s ease;
  cursor: pointer;
}
.cart-drawer.is-open .cart-drawer__overlay { opacity: 1; }

.cart-drawer__content {
  position: absolute;
  top: 0; right: 0;
  width: min(420px, 95vw);
  height: 100%;
  background: var(--color-background, #fff);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
  box-shadow: -8px 0 40px rgba(0,0,0,0.12);
}
.cart-drawer.is-open .cart-drawer__content { transform: translateX(0); }

/* ---- Header ---- */
.cart-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid var(--color-border, #E8D5C4);
  flex-shrink: 0;
  background: var(--color-skin-pale, #FBF0E8);
}
.cart-drawer__title {
  font-family: var(--font-heading-family);
  font-size: 1.3rem;
  color: var(--color-heading);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 6px;
}
.cart-drawer__count {
  font-size: 0.9rem;
  opacity: 0.6;
  font-weight: 400;
}
.cart-drawer__close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-heading);
  padding: 6px;
  border-radius: var(--radius-md, 8px);
  display: flex;
  align-items: center;
  transition: background-color 0.2s;
}
.cart-drawer__close:hover { background: var(--color-skin-light, #F5DEC8); }

/* ---- Body ---- */
.cart-drawer__body {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

/* ---- Empty state ---- */
.cart-drawer__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  height: 100%;
  min-height: 300px;
  padding: 40px 24px;
  text-align: center;
}
.cart-drawer__empty-icon { font-size: 3rem; opacity: 0.3; }
.cart-drawer__empty p {
  color: var(--color-text);
  opacity: 0.65;
  font-size: 0.95rem;
  margin: 0;
}

/* ---- Cart Items ---- */
.cart-drawer__items { padding: 16px 24px; display: flex; flex-direction: column; gap: 16px; }

.cart-item-row {
  display: flex;
  gap: 14px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--color-border, #E8D5C4);
}
.cart-item-row:last-child { border-bottom: none; padding-bottom: 0; }

.cart-item-row__img {
  width: 80px;
  height: 80px;
  border-radius: var(--radius-lg, 16px);
  object-fit: cover;
  flex-shrink: 0;
  background: var(--color-skin-pale, #FBF0E8);
}
.cart-item-row__details { flex: 1; min-width: 0; }
.cart-item-row__name {
  font-family: var(--font-heading-family);
  font-size: 0.9rem;
  color: var(--color-heading);
  text-decoration: none;
  display: block;
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cart-item-row__variant { font-size: 0.78rem; color: var(--color-text); opacity: 0.6; margin-bottom: 8px; }
.cart-item-row__bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cart-item-row__price { font-weight: 700; font-size: 0.9rem; color: var(--color-heading); }
.cart-item-row__price s { font-weight: 400; font-size: 0.8rem; color: #999; margin-right: 4px; }

/* Qty controls */
.cart-item-qty {
  display: flex;
  align-items: center;
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-pill, 50px);
  overflow: hidden;
  height: 32px;
}
.cart-item-qty__btn {
  background: none;
  border: none;
  width: 30px;
  height: 30px;
  cursor: pointer;
  font-size: 1rem;
  color: var(--color-heading);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s;
}
.cart-item-qty__btn:hover { background: var(--color-skin-pale, #FBF0E8); }
.cart-item-qty__val { font-size: 0.85rem; font-weight: 600; min-width: 22px; text-align: center; }

.cart-item-row__remove {
  background: none;
  border: none;
  cursor: pointer;
  color: #bbb;
  padding: 4px;
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  gap: 3px;
  transition: color 0.2s;
}
.cart-item-row__remove:hover { color: var(--color-primary, #C69A7C); }

/* ---- Footer ---- */
.cart-drawer__footer {
  padding: 20px 24px;
  border-top: 1px solid var(--color-border, #E8D5C4);
  flex-shrink: 0;
  background: var(--color-skin-pale, #FBF0E8);
}
.cart-drawer__subtotal {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  font-size: 1rem;
}
.cart-drawer__subtotal strong { font-family: var(--font-heading-family); font-size: 1.15rem; }
.cart-drawer__taxes { font-size: 0.75rem; color: var(--color-text); opacity: 0.55; margin: 0 0 16px; }
.cart-drawer__checkout { font-size: 1rem; padding: 16px; }
.cart-drawer__view-cart {
  display: block;
  text-align: center;
  margin-top: 10px;
  font-size: 0.82rem;
  color: var(--color-text);
  opacity: 0.6;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.cart-drawer__view-cart:hover { opacity: 1; color: var(--color-primary); }

/* Loading state */
.cart-drawer__body.is-loading { opacity: 0.5; pointer-events: none; }
</style>
