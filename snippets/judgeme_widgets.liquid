{%- comment -%}
  Judge.me Review Widgets Snippet
  Auto-generated / compatibility stub for Shopify Judge.me Product Reviews
{%- endcomment -%}

<style>
  :root, body, .jdgm-widget, .jdgm-review-widget, .jdgm-rev-widg, div[class*="jdgm"] {
    --jdgm-primary-color: #C69A7C !important;
    --jdgm-star-color: #FFB800 !important;
    --jdgm-button-color: #C69A7C !important;
    --jdgm-write-review-bg: #C69A7C !important;
    --jdgm-secondary-color: #C69A7C !important;
    --jdgm-badge-color: #FFB800 !important;
  }

  /* Force Star Colors & Replace Empty Boxes with Native Stars */
  /* High Specificity Star Overrides */
  html body .jdgm-widget .jdgm-star,
  html body .jdgm-widget [class*="jdgm-star"],
  html body .jdgm-rev-widg__star,
  html body .jdgm-prev-badge__stars .jdgm-star,
  html body .jdgm-rev-widg__summary-stars .jdgm-star,
  html body .jdgm-rev__rating .jdgm-star,
  html body .jdgm-star {
    color: #FFB800 !important;
    font-family: Arial, Helvetica, sans-serif !important;
    font-style: normal !important;
  }

  html body .jdgm-widget .jdgm-star:before,
  html body .jdgm-widget .jdgm-rev-widg__star:before,
  html body .jdgm-star:before,
  html body .jdgm-star.jdgm--on:before,
  html body .jdgm-star.jdgm--full:before {
    content: "★" !important;
    color: #FFB800 !important;
  }

  html body .jdgm-widget .jdgm-star.jdgm--off:before,
  html body .jdgm-widget .jdgm-star.jdgm--empty:before {
    content: "★" !important;
    color: #E2E8F0 !important;
  }

  /* Force Button Styling & Override Judge.me Green */
  html body .jdgm-widget .jdgm-write-rev-btn,
  html body .jdgm-widget .jdgm-rev-widg__write-rev-btn,
  html body .jdgm-widget a.jdgm-write-rev-btn,
  html body .jdgm-widget button.jdgm-write-rev-btn,
  html body .jdgm-widget .jdgm-submit-rev,
  html body .jdgm-widget button.jdgm-submit-rev,
  html body .jdgm-write-rev-btn,
  html body .jdgm-rev-widg__write-rev-btn {
    background-color: #C69A7C !important;
    background: #C69A7C !important;
    border-color: #C69A7C !important;
    color: #FFFFFF !important;
    border-radius: 50px !important;
  }

  html body .jdgm-widget .jdgm-btn:hover,
  html body .jdgm-widget .jdgm-write-rev-btn:hover,
  html body .jdgm-widget a.jdgm-write-rev-btn:hover,
  html body .jdgm-widget button.jdgm-write-rev-btn:hover {
    background-color: #A07855 !important;
    background: #A07855 !important;
    border-color: #A07855 !important;
  }
</style>

<script>
  window.jdgm = window.jdgm || {};
  window.jdgm.SHOP_DOMAIN = "{{ shop.permanent_domain }}";
  window.jdgm.PLATFORM = "shopify";
</script>
<script src="https://cdn.judge.me/assets/installed_judgeme.js" async></script>

{%- case widget_type -%}
  {%- when 'judgeme_review_widget' -%}
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  {%- when 'judgeme_preview_badge' -%}
    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.badge }}
    </div>
  {%- when 'judgeme_featured_carousel' -%}
    <div class="jdgm-widget jdgm-carousel-wrapper">
      {{ shop.metafields.judgeme.featured_carousel }}
    </div>
{%- endcase -%}
