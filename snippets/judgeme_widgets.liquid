{%- comment -%}
  Judge.me Review Widgets Snippet
  Auto-generated / compatibility stub for Shopify Judge.me Product Reviews
{%- endcomment -%}

<style>
  /* ── Judge.me Brand Colour Overrides ──────────────────────────────────────
     Strategy: CSS custom properties + targeted selectors.
     IMPORTANT: We do NOT override font-family on star elements because
     Judge.me uses a proprietary icon font to render stars. Replacing it
     with a system font causes the icon code-points to render as squares.
  ── ──────────────────────────────────────────────────────────────────── */

  :root {
    --jdgm-primary-color: #C69A7C;
    --jdgm-star-color: #FFB800;
    --jdgm-button-color: #C69A7C;
    --jdgm-write-review-bg: #C69A7C;
    --jdgm-secondary-color: #C69A7C;
    --jdgm-badge-color: #FFB800;
  }

  /* ── Stars: colour only, DO NOT touch font-family ─────────────────────── */
  html body .jdgm-star,
  html body [class*="jdgm-star"],
  html body .jdgm-rev-widg__star,
  html body .jdgm-prev-badge__stars .jdgm-star,
  html body .jdgm-rev-widg__summary-stars .jdgm-star,
  html body .jdgm-rev__rating .jdgm-star {
    color: #FFB800 !important;
    /* font-family intentionally NOT overridden — icon font must stay */
  }

  html body .jdgm-star.jdgm--on,
  html body .jdgm-star.jdgm--full,
  html body .jdgm-star:not(.jdgm--off):not(.jdgm--empty) {
    color: #FFB800 !important;
  }

  html body .jdgm-star.jdgm--off,
  html body .jdgm-star.jdgm--empty {
    color: #D1D5DB !important;
    opacity: 0.6 !important;
  }

  /* ── Buttons & Links: override Judge.me green ──────────────────────────── */
  html body .jdgm-write-rev-btn,
  html body .jdgm-rev-widg__write-rev-btn,
  html body a.jdgm-write-rev-btn,
  html body button.jdgm-write-rev-btn,
  html body .jdgm-submit-rev,
  html body button.jdgm-submit-rev,
  html body input.jdgm-submit-rev {
    background-color: #C69A7C !important;
    background: #C69A7C !important;
    border-color: #C69A7C !important;
    color: #FFFFFF !important;
    border-radius: 50px !important;
    box-shadow: 0 4px 12px rgba(198,154,124,0.3) !important;
  }

  html body .jdgm-write-rev-btn:hover,
  html body a.jdgm-write-rev-btn:hover,
  html body button.jdgm-write-rev-btn:hover {
    background-color: #A07855 !important;
    background: #A07855 !important;
    border-color: #A07855 !important;
    color: #FFFFFF !important;
  }

  /* ── Tabs / active indicators ──────────────────────────────────────────── */
  html body .jdgm-tab.jdgm--active,
  html body .jdgm-tab-group .jdgm--active {
    border-bottom-color: #C69A7C !important;
    color: #C69A7C !important;
  }

  /* ── Links ─────────────────────────────────────────────────────────────── */
  html body .jdgm-widget a,
  html body .jdgm-rev-widg a {
    color: #C69A7C !important;
  }
</style>

<script>
  window.jdgm = window.jdgm || {};
  window.jdgm.SHOP_DOMAIN = "{{ shop.permanent_domain }}";
  window.jdgm.PLATFORM = "shopify";
</script>
<script src="https://cdn.judge.me/assets/installed_judgeme.js" async></script>

{%- case widget_type -%}
  {%- when 'judgeme_review_widget' -%}
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  {%- when 'judgeme_preview_badge' -%}
    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.badge }}
    </div>
  {%- when 'judgeme_featured_carousel' -%}
    <div class="jdgm-widget jdgm-carousel-wrapper">
      {{ shop.metafields.judgeme.featured_carousel }}
    </div>
{%- endcase -%}
