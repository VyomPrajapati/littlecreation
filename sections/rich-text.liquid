<section class="rich-text section-padding text-center" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="rich-text__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="rich-text__heading animate-on-scroll" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="rich-text__content rte animate-on-scroll delay-1" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <div class="rich-text__button-wrap animate-on-scroll delay-2" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.button_link }}" class="button {% if block.settings.button_style == 'outline' %}button--outline{% endif %}">
                  {{ block.settings.button_label }}
                </a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.rich-text__inner {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}
.rich-text__heading {
  color: var(--color-heading);
}
.rich-text__heading::after {
  content: '';
  display: block;
  width: 56px;
  height: 3px;
  background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-pill);
  margin: var(--spacing-sm) auto 0;
}
.rich-text__content {
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--color-text);
  opacity: 0.95;
  max-width: 960px;
  text-align: left;
}
.rich-text__content p { margin-bottom: 0.75em; }
.rich-text__content p:last-child { margin-bottom: 0; }
.rich-text__content strong {
  color: var(--color-heading);
  font-weight: 700;
}
.rich-text__button-wrap {
  display: flex;
  justify-content: center;
}

@media screen and (max-width: 768px) {
  .rich-text__content,
  .rich-text__content p {
    text-align: justify !important;
    text-justify: inter-word;
    hyphens: auto;
  }
}
</style>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Talk about your brand"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "filled", "label": "Filled (skin)" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "filled"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
