<script>
  document.addEventListener('DOMContentLoaded', function() {
    const lightbox = document.getElementById('SafetyLightbox');
    const lightboxImg = document.getElementById('SafetyLightboxImg');
    const lightboxCaption = document.getElementById('SafetyLightboxCaption');
    const closeBtn = document.getElementById('SafetyLightboxClose');
    const overlay = document.getElementById('SafetyLightboxOverlay');
    const triggers = document.querySelectorAll('.safety-lightbox-trigger');

    function openLightbox(imgSrc, title) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = imgSrc;
      lightboxCaption.textContent = title || '';
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggers.forEach(function(img) {
      img.addEventListener('click', function() {
        const fullUrl = this.getAttribute('data-full-img') || this.src;
        const title = this.getAttribute('data-title') || this.alt || '';
        openLightbox(fullUrl, title);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (overlay) overlay.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) {
        closeLightbox();
      }
    });
  });
</script>
