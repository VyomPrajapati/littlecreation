{%- comment -%}
  100% Fully Editable Product Safety Standards & Commitment Section
  Little Creation Theme
{%- endcomment -%}

<section class="safety-page-section" style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }}; padding-top: 0;">
  <!-- 1. Full-Width Edge-to-Edge Hero Banner -->
  <div class="safety-hero-full">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | image_url: width: 2200 }}" 
           alt="{{ section.settings.hero_image.alt | default: 'Product Safety Banner' }}" 
           class="safety-hero-img-full" loading="eager">
      <div class="safety-hero-overlay"></div>
      <div class="safety-hero-content">
        <span class="safety-hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          UKCA & EN71 Certified
        </span>
        <h1 class="safety-hero-title">{{ section.settings.commitment_heading | default: 'Our Commitment to Safety' }}</h1>
        <p class="safety-hero-subtitle">100% Premium Food-Grade Platinum Silicone · Non-Toxic & BPA-Free · Rigorously Tested for Your Baby</p>
      </div>
    {% else %}
      <div class="safety-hero-placeholder-full">
        <span class="safety-img-placeholder__icon">🖼️</span>
        <strong>[ Hero Banner Image Placeholder: Upload Full-Width Top Banner Photo ]</strong>
        <span>Select image under Top Hero Banner Image setting on the right sidebar</span>
      </div>
    {% endif %}
  </div>

  <div class="safety-page__inner section-padding">
    <!-- 2. Commitment Box -->
      <div class="safety-banner-box">
        <h2>{{ section.settings.commitment_heading | default: 'Our Commitment to Safety' }}</h2>
        <div class="rte">
          {% if section.settings.commitment_text != blank %}
            {{ section.settings.commitment_text }}
          {% else %}
            <p>At Little Creation, your little one's safety and well-being is always at the heart of what we do. We use exclusively <strong>100% Premium Food-Grade Platinum Silicone</strong> across our entire teether collection — completely free from BPA, BPS, PVC, phthalates, lead, latex, and heavy metals.</p>
            <p>Every product undergoes strict, independent lab testing to meet and exceed <strong>UK (UKCA)</strong> and <strong>EU (EN71-1, 2, 3)</strong> safety standards. Whether it is playtime or teething time, you can trust that every Little Creation piece is made to be 100% safe, gentle, and worry-free for your baby.</p>
          {% endif %}
        </div>
      </div>

      <!-- 3. Why Parents Love Silicone -->
      <div class="safety-silicone-intro mb-lg">
        <div class="safety-silicone-card">
          <div class="safety-silicone-image-wrap">
            {% if section.settings.silicone_image != blank %}
              <img src="{{ section.settings.silicone_image | image_url: width: 1200 }}" 
                   alt="{{ section.settings.silicone_heading | default: 'Why Parents & Specialists Love Silicone' }}" 
                   class="safety-silicone-img" loading="lazy">
            {% else %}
              <div class="safety-silicone-placeholder">
                <span class="safety-img-placeholder__icon">📷</span>
                <strong>[ Feature Image Placeholder: Why Parents & Specialists Love Silicone ]</strong>
                <span>Select photo under 3. Silicone Intro Section in the theme editor sidebar</span>
              </div>
            {% endif %}
          </div>

          <div class="safety-silicone-content">
            <h3>{{ section.settings.silicone_heading | default: "Why Parents & Specialists Love Silicone" }}</h3>
            <div class="rte">
              {% if section.settings.silicone_text != blank %}
                {{ section.settings.silicone_text }}
              {% else %}
                <p>Food-grade platinum silicone is soft, resilient, and baby-tough. Formulated from natural silica elements, it provides the ideal balance of gentle flexibility to comfort tender gums without sacrificing durability. From cooling teethers to rattles, silicone is non-porous, naturally hygienic, and effortless to clean.</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Feature Table -->
      <h3>{{ section.settings.table_heading | default: "Why We're All About Platinum Silicone" }}</h3>
      
      <div class="safety-table-wrap">
        <table class="safety-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Key Feature</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>1</strong></td>
              <td><strong>{{ section.settings.feature_1_title | default: "Flexible & Durable" }}</strong></td>
              <td>{{ section.settings.feature_1_desc | default: "Built for daily baby life. Resists cracks, scuffs, and fading — even after endless washes, intense teething bites, and floor drops." }}</td>
            </tr>
            <tr>
              <td><strong>2</strong></td>
              <td><strong>{{ section.settings.feature_2_title | default: "Heat & Cold Resistant" }}</strong></td>
              <td>{{ section.settings.feature_2_desc | default: "From refrigerator cooling to boiling water sanitization — withstands extreme temperatures without warping, melting, or degrading." }}</td>
            </tr>
            <tr>
              <td><strong>3</strong></td>
              <td><strong>{{ section.settings.feature_3_title | default: "Bacteria & Odor Resistant" }}</strong></td>
              <td>{{ section.settings.feature_3_desc | default: "Non-porous molecular structure means zero micro-cracks for moisture or germs to hide. Naturally repels odors and stays fresh." }}</td>
            </tr>
            <tr>
              <td><strong>4</strong></td>
              <td><strong>{{ section.settings.feature_4_title | default: "UKCA & EN71 Certified" }}</strong></td>
              <td>{{ section.settings.feature_4_desc | default: "Independently tested by accredited safety labs to exceed UK (UKCA) and European (EN71) child toy safety requirements." }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 5. 4-Image Grid -->
      <div class="safety-4grid">
        <div class="safety-4grid__item">
          {% if section.settings.grid_image_1 != blank %}
            <img src="{{ section.settings.grid_image_1 | image_url: width: 800 }}" 
                 data-full-img="{{ section.settings.grid_image_1 | image_url: width: 2000 }}"
                 data-title="{{ section.settings.feature_1_title | default: 'Flexible & Durable' }}"
                 alt="{{ section.settings.feature_1_title }}" 
                 class="safety-grid-img safety-lightbox-trigger" loading="lazy">
          {% else %}
            <span class="safety-img-placeholder__icon">📷</span>
            <strong>[ {{ section.settings.feature_1_title | default: "Flexible & Durable" }} ]</strong>
            <span>Upload photo on right sidebar</span>
          {% endif %}
        </div>
        <div class="safety-4grid__item">
          {% if section.settings.grid_image_2 != blank %}
            <img src="{{ section.settings.grid_image_2 | image_url: width: 800 }}" 
                 data-full-img="{{ section.settings.grid_image_2 | image_url: width: 2000 }}"
                 data-title="{{ section.settings.feature_2_title | default: 'Heat & Cold Resistant' }}"
                 alt="{{ section.settings.feature_2_title }}" 
                 class="safety-grid-img safety-lightbox-trigger" loading="lazy">
          {% else %}
            <span class="safety-img-placeholder__icon">📷</span>
            <strong>[ {{ section.settings.feature_2_title | default: "Heat & Cold Resistant" }} ]</strong>
            <span>Upload photo on right sidebar</span>
          {% endif %}
        </div>
        <div class="safety-4grid__item">
          {% if section.settings.grid_image_3 != blank %}
            <img src="{{ section.settings.grid_image_3 | image_url: width: 800 }}" 
                 data-full-img="{{ section.settings.grid_image_3 | image_url: width: 2000 }}"
                 data-title="{{ section.settings.feature_3_title | default: 'Bacteria & Odor Free' }}"
                 alt="{{ section.settings.feature_3_title }}" 
                 class="safety-grid-img safety-lightbox-trigger" loading="lazy">
          {% else %}
            <span class="safety-img-placeholder__icon">📷</span>
            <strong>[ {{ section.settings.feature_3_title | default: "Bacteria & Odor Free" }} ]</strong>
            <span>Upload photo on right sidebar</span>
          {% endif %}
        </div>
        <div class="safety-4grid__item">
          {% if section.settings.grid_image_4 != blank %}
            <img src="{{ section.settings.grid_image_4 | image_url: width: 800 }}" 
                 data-full-img="{{ section.settings.grid_image_4 | image_url: width: 2000 }}"
                 data-title="{{ section.settings.feature_4_title | default: 'UKCA & EN71 Certified' }}"
                 alt="{{ section.settings.feature_4_title }}" 
                 class="safety-grid-img safety-lightbox-trigger" loading="lazy">
          {% else %}
            <span class="safety-img-placeholder__icon">📷</span>
            <strong>[ {{ section.settings.feature_4_title | default: "UKCA & EN71 Certified" }} ]</strong>
            <span>Upload photo on right sidebar</span>
          {% endif %}
        </div>
      </div>

      <!-- Fullscreen Image Lightbox Modal -->
      <div class="safety-lightbox" id="SafetyLightbox" aria-hidden="true" role="dialog">
        <div class="safety-lightbox__overlay" id="SafetyLightboxOverlay"></div>
        <div class="safety-lightbox__content">
          <button type="button" class="safety-lightbox__close" id="SafetyLightboxClose" aria-label="Close modal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
          <img src="" alt="" class="safety-lightbox__img" id="SafetyLightboxImg">
          <div class="safety-lightbox__caption" id="SafetyLightboxCaption"></div>
        </div>
      </div>

      <!-- 6. Understanding Silicone Purity -->
      <div class="safety-purity-section mb-xl">
        <div class="safety-purity-card">
          <div class="safety-purity-content">
            <h3>{{ section.settings.purity_heading | default: "Understanding Platinum Silicone Purity" }}</h3>
            <div class="rte">
              {% if section.settings.purity_text != blank %}
                {{ section.settings.purity_text }}
              {% else %}
                <p>Not all silicone is created equal. Little Creation uses <strong>100% Platinum-Cured Food-Grade Silicone</strong> — the highest standard of silicone purity. Unlike lower-grade silicones cured with peroxide, platinum curing leaves zero chemical fillers or residues behind.</p>
                <p>Every single production batch is independently inspected and tested so you can give our products to your baby with absolute peace of mind.</p>
              {% endif %}
            </div>
          </div>

          <div class="safety-purity-image-wrap">
            {% if section.settings.purity_image != blank %}
              <img src="{{ section.settings.purity_image | image_url: width: 1200 }}" 
                   alt="{{ section.settings.purity_heading | default: 'Platinum Silicone Purity' }}" 
                   class="safety-purity-img" loading="lazy">
            {% else %}
              <div class="safety-purity-placeholder">
                <span class="safety-img-placeholder__icon">📷</span>
                <strong>[ Large Feature Image Placeholder: Understanding Platinum Silicone Purity ]</strong>
                <span>Select photo under 6. Silicone Purity Section in the theme editor sidebar</span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- 7. FAQ Section -->
      <div class="safety-faq-card">
        <h4>{{ section.settings.faq_heading | default: "FAQ: Why does new silicone sometimes have a slight packaging scent?" }}</h4>
        <div class="rte">
          {% if section.settings.faq_text != blank %}
            {{ section.settings.faq_text }}
          {% else %}
            <p>You might notice a subtle "fresh" scent when unboxing your new Little Creation products. This is completely normal, harmless, and safe.</p>
            <p><strong>The Science:</strong> Our 100% Platinum Silicone is cured at high temperatures during manufacturing. Because items are hygienically sealed immediately after cooling to protect them during transit, natural warm air can remain trapped inside the airtight package.</p>
            <p>This is <em>not</em> toxic chemical off-gassing. It is simply trapped air from the thermal stabilization process.</p>
          {% endif %}
        </div>

        <div class="safety-boil-guide">
          <h5>{{ section.settings.boil_guide_heading | default: "How to refresh it instantly:" }}</h5>
          <div class="rte">
            {% if section.settings.boil_guide_text != blank %}
              {{ section.settings.boil_guide_text }}
            {% else %}
              <p><strong>♨️ The 5-Minute Boil Test:</strong> Place the silicone product in a pot of boiling water for 5 minutes.</p>
              <p><strong>🌬️ Air Dry:</strong> Allow it to air dry completely in a clean, ventilated area.</p>
              <p>The gentle heat allows any residual trapped moisture to evaporate, leaving pure, completely odorless silicone.</p>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- 8. Declaration of Conformity Section -->
      <div id="declaration-of-conformity" style="margin-top: 48px; padding-top: 32px; border-top: 1.5px solid var(--color-border, #E8D5C4);">
        <h3>{{ section.settings.declaration_heading | default: 'Declaration of Conformity' }}</h3>
        <p>{{ section.settings.declaration_subtext }}</p>
        
        <ol class="safety-pdf-list">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <li class="pdf-item" {{ block.shopify_attributes }}>
                <span class="pdf-num">{{ forloop.index }}.</span>
                <a href="{{ block.settings.pdf_url | default: '#' }}" target="_blank" rel="noopener" class="pdf-link"><u>{{ block.settings.title | default: 'Safety Document' }}</u></a>
              </li>
            {% endfor %}
          {% else %}
            <li class="pdf-item"><span class="pdf-num">1.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Safety module</u></a></li>
            <li class="pdf-item"><span class="pdf-num">2.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Lion Rattle Teether Safety Declaration</u></a></li>
            <li class="pdf-item"><span class="pdf-num">3.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Cooling Teether Safety Declaration</u></a></li>
            <li class="pdf-item"><span class="pdf-num">4.</span> <a href="#" target="_blank" rel="noopener" class="pdf-link"><u>Swan Wooden Ring Teether Declaration</u></a></li>
          {% endif %}
        </ol>
      </div>

    </div>
</section>

<style>
.safety-hero-full {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
  margin-bottom: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 380px;
}
.safety-hero-img-full {
  width: 100%;
  height: 100%;
  min-height: 380px;
  max-height: 520px;
  display: block;
  object-fit: cover;
  object-position: center top;
}
.safety-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0.5) 100%);
  pointer-events: none;
  z-index: 1;
}
.safety-hero-content {
  position: absolute;
  z-index: 2;
  text-align: center;
  color: #ffffff;
  padding: 32px 20px;
  max-width: 850px;
  margin: 0 auto;
}
.safety-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.95);
  color: #111111;
  font-family: var(--font-body-family);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 6px 18px;
  border-radius: 999px;
  margin-bottom: 14px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}
.safety-hero-title {
  font-family: var(--font-heading-family);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700 !important;
  color: #ffffff !important;
  line-height: 1.15;
  margin: 0 0 12px 0;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}
.safety-hero-subtitle {
  font-size: clamp(0.95rem, 1.8vw, 1.15rem);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  margin: 0;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}
.safety-hero-placeholder-full {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  background: #F8FAFC;
  border-top: 1px solid #E2E8F0;
  border-bottom: 1px solid #E2E8F0;
  padding: 64px 20px;
  text-align: center;
  margin-bottom: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #475569;
}
.safety-hero-placeholder-full strong {
  font-size: 1.15rem;
  color: #1E293B;
}
.safety-hero-placeholder-full span {
  font-size: 0.88rem;
  color: #64748B;
}

.safety-page__inner {
  max-width: 1400px;
  margin: 0 auto;
  padding-left: var(--spacing-container, 32px);
  padding-right: var(--spacing-container, 32px);
}
@media screen and (max-width: 767px) {
  .safety-page__inner {
    padding-left: 16px;
    padding-right: 16px;
  }
}

.safety-banner-box {
  background: var(--color-skin-pale, #FBF0E8);
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 20px);
  padding: 24px;
  margin-bottom: 28px;
}
.safety-banner-box h2 {
  margin-top: 0 !important;
}

.safety-silicone-card {
  background: var(--color-white, #FFFFFF);
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 24px);
  padding: 28px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}
@media screen and (min-width: 900px) {
  .safety-silicone-card {
    grid-template-columns: 0.9fr 1.1fr;
    gap: 36px;
    padding: 36px;
  }
}
.safety-silicone-content h3 {
  margin-top: 0 !important;
  font-family: var(--font-heading-family);
  font-size: clamp(1.5rem, 2.5vw, 2.1rem);
  color: var(--color-heading, #111111);
  margin-bottom: 16px;
}
.safety-silicone-image-wrap {
  width: 100%;
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}
.safety-silicone-img {
  width: 100%;
  height: 100%;
  min-height: 280px;
  max-height: 440px;
  object-fit: cover;
  display: block;
}
.safety-silicone-placeholder {
  background: #F8FAFC;
  border: 1.5px solid #E2E8F0;
  border-radius: 18px;
  padding: 48px 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #475569;
  min-height: 260px;
}
.safety-silicone-placeholder strong {
  font-size: 1.05rem;
  color: #1E293B;
}
.safety-silicone-placeholder span {
  font-size: 0.85rem;
  color: #64748B;
}

.safety-table-wrap {
  overflow-x: auto;
  margin: 20px 0 28px 0;
}
.safety-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
  background: var(--color-white);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: 12px;
  overflow: hidden;
}
.safety-table th, .safety-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--color-border, #E8D5C4);
  text-align: left;
}
.safety-table th {
  background: var(--color-skin-pale, #FBF0E8);
  color: var(--color-heading, #111111);
  font-family: var(--font-heading-family);
  font-weight: 700;
}

.safety-4grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin: 32px 0 44px 0;
}
@media screen and (max-width: 1024px) {
  .safety-4grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}
@media screen and (max-width: 550px) {
  .safety-4grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
}
.safety-4grid__item {
  background: #FFFFFF;
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 24px);
  padding: 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #475569;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  aspect-ratio: 1 / 1;
  min-height: 280px;
}
.safety-4grid__item:hover {
  transform: translateY(-6px);
  box-shadow: 0 14px 32px rgba(198, 154, 124, 0.25);
}
.safety-grid-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 24px;
  cursor: zoom-in;
  transition: transform 0.5s ease;
}
.safety-4grid__item:hover .safety-grid-img {
  transform: scale(1.04);
}

/* Fullscreen Lightbox Modal */
.safety-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  padding: 20px;
}
.safety-lightbox.is-open {
  opacity: 1;
  visibility: visible;
}
.safety-lightbox__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  cursor: zoom-out;
}
.safety-lightbox__content {
  position: relative;
  z-index: 2;
  max-width: 90vw;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: scale(0.92);
  transition: transform 0.3s ease;
}
.safety-lightbox.is-open .safety-lightbox__content {
  transform: scale(1);
}
.safety-lightbox__img {
  max-width: 90vw;
  max-height: 80vh;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 16px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}
.safety-lightbox__close {
  position: absolute;
  top: -48px;
  right: 0;
  width: 44px;
  height: 44px;
  background: rgba(255, 255, 255, 0.95);
  color: #111111;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease, background 0.2s ease;
}
.safety-lightbox__close:hover {
  transform: scale(1.1);
  background: #ffffff;
  color: var(--color-primary-dark, #A07855);
}
.safety-lightbox__caption {
