<section class="story-hero">
  <div class="story-hero__wrapper">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" 
           alt="{{ section.settings.heading | default: 'Our Story' | escape }}" 
           class="story-hero__img" 
           loading="eager">
    {% else %}
      <div class="story-hero__placeholder">
        <span class="story-hero__placeholder-icon">🖼️</span>
        <strong>[ Select Hero Banner Photo ]</strong>
        <span>Upload background image under Story Hero Banner in the theme editor sidebar</span>
      </div>
    {% endif %}

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="container story-hero__container">
        <div class="story-hero__content">
          {% if section.settings.heading != blank %}
            <h1 class="story-hero__title">{{ section.settings.heading }}</h1>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <span class="story-hero__subtitle">{{ section.settings.subheading }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
.story-hero {
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
  margin-bottom: 40px;
}
.story-hero__wrapper {
  position: relative;
  width: 100%;
  min-height: 680px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-skin-pale, #FBF0E8);
}
.story-hero__img {
  width: 100%;
  height: 100%;
  min-height: 680px;
  object-fit: cover;
  object-position: center;
  display: block;
}
@media screen and (max-width: 768px) {
  .story-hero {
    margin-bottom: 24px;
  }
  .story-hero__wrapper {
    min-height: auto !important;
    height: auto !important;
  }
  .story-hero__img {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    object-fit: contain !important;
  }
  .story-hero__container {
    padding: 12px 16px;
  }
  .story-hero__card {
    padding: 16px 20px !important;
    border-radius: 16px !important;
  }
  .story-hero__title {
    font-size: 1.65rem !important;
    margin-bottom: 4px !important;
  }
  .story-hero__subtitle {
    font-size: 0.82rem !important;
  }
}
.story-hero__overlay {
  display: none !important;
}
.story-hero__container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  z-index: 2;
  text-align: center;
  padding: 20px;
}
.story-hero__content {
  max-width: 750px;
  margin: 0 auto;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}
.story-hero__title {
  font-family: var(--font-heading-family);
  font-size: clamp(2rem, 4.5vw, 3.4rem);
  font-weight: 800;
  color: var(--color-heading, #111111) !important;
  margin: 0 0 8px 0;
  line-height: 1.15;
  text-shadow: none;
}
.story-hero__subtitle {
  display: block;
  font-size: clamp(0.95rem, 1.8vw, 1.25rem);
  font-weight: 700;
  color: var(--color-primary-dark, #A07855) !important;
  text-shadow: none;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.story-hero__placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #F8FAFC;
  border: 1.5px solid #CBD5E1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #475569;
}
.story-hero__placeholder-icon {
  font-size: 2.2rem;
}
</style>

{% schema %}
{
  "name": "Story Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Banner Background Image (1920x600 recommended)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Optional)",
      "default": "Reimagining Early Childhood Development"
    }
  ],
  "presets": [
    {
      "name": "Story Hero Banner"
    }
  ]
}
{% endschema %}
