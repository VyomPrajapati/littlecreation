<section class="story-hero">
  <div class="story-hero__wrapper">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" 
           alt="{{ section.settings.heading | default: 'Our Story' | escape }}" 
           class="story-hero__img" 
           loading="eager">
    {% else %}
      <div class="story-hero__placeholder">
        <span class="story-hero__placeholder-icon">🖼️</span>
        <strong>[ Select Hero Banner Photo ]</strong>
        <span>Upload background image under Story Hero Banner in the theme editor sidebar</span>
      </div>
    {% endif %}

    <div class="story-hero__overlay"></div>

    <div class="container story-hero__container">
      <div class="story-hero__content">
        {% if section.settings.heading != blank %}
          <h1 class="story-hero__title">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <span class="story-hero__subtitle">{{ section.settings.subheading }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.story-hero {
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
  margin-bottom: 40px;
}
.story-hero__wrapper {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-skin-pale, #FBF0E8);
  min-height: 220px;
}
.story-hero__img {
  width: 100%;
  height: auto;
  max-height: 80vh;
  object-fit: contain;
  display: block;
}
.story-hero__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.5) 100%);
  z-index: 1;
  pointer-events: none;
}
.story-hero__container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  z-index: 2;
  text-align: center;
  color: #ffffff;
  padding: 20px;
}
.story-hero__content {
  max-width: 800px;
  margin: 0 auto;
}
.story-hero__title {
  font-family: var(--font-heading-family);
  font-size: clamp(2.2rem, 5.5vw, 4.2rem);
  font-weight: 800;
  color: #ffffff !important;
  margin: 0 0 10px 0;
  line-height: 1.15;
  text-shadow: 0 3px 12px rgba(0, 0, 0, 0.5);
}
.story-hero__subtitle {
  display: block;
  font-size: clamp(0.95rem, 2vw, 1.35rem);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  letter-spacing: 0.04em;
}
.story-hero__placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #F8FAFC;
  border: 1.5px solid #CBD5E1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #475569;
}
.story-hero__placeholder-icon {
  font-size: 2.2rem;
}
</style>

{% schema %}
{
  "name": "Story Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Banner Background Image (1920x600 recommended)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Optional)",
      "default": "Reimagining Early Childhood Development"
    }
  ],
  "presets": [
    {
      "name": "Story Hero Banner"
    }
  ]
}
{% endschema %}
