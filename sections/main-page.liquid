{%- if page.handle == 'contact' or page.handle == 'contact-us' or page.title == 'Contact' or page.title == 'Contact Us' -%}
  {% section 'contact-form' %}
{%- elsif page.handle contains 'safety' or page.title contains 'Safety' or page.handle contains 'conformity' or page.title contains 'Conformity' -%}
  {%- comment -%} Suppress default page header and empty text box on safety pages so safety-page hero banner sits at the very top {%- endcomment -%}
{%- else -%}
  <section class="main-page section-padding">
    <div class="container">
      <div class="main-page__inner">

        <header class="main-page__header animate-on-scroll">
          <h1 class="main-page__title">{{ page.title | escape }}</h1>
          <div class="main-page__divider"></div>
        </header>

        {%- if page.handle contains 'affiliate' or page.title contains 'Affiliate' -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            <h2 style="font-size: 1.6rem; font-weight: 800; color: #111111; margin-top: 0; border-bottom: none !important;">Join the Little Creation Brand Ambassador Program</h2>
            <p style="font-size: 1.05rem; line-height: 1.8; color: #3A2E27; margin-bottom: 14px;">Do you love beautifully crafted, sustainable baby products? Are you a parent, influencer, content creator, or blogger passionate about sharing gentle teething solutions with your community?</p>
            <p style="font-size: 1.05rem; line-height: 1.8; color: #3A2E27; margin-bottom: 24px;">We invite you to partner with <strong>Little Creation</strong> and earn commissions while sharing products parents truly trust!</p>

            <h3 style="font-size: 1.3rem; font-weight: 800; color: #111111; margin-top: 24px; border-bottom: none !important;">Program Perks & Benefits</h3>
            <ul style="padding-left: 1.4rem; font-size: 1.05rem; line-height: 1.8; color: #3A2E27; margin-bottom: 32px;">
              <li><strong>10% Commission:</strong> Earn 10% on every valid sale generated through your unique link or discount code.</li>
              <li><strong>Exclusive Discounts:</strong> Get a custom discount code to offer your followers and friends.</li>
              <li><strong>Free Product Samples:</strong> Top-performing affiliates get early access to new product launches and free samples.</li>
              <li><strong>30-Day Cookie Window:</strong> Receive credit for any purchases made within 30 days of clicking your link.</li>
              <li><strong>Real-Time Tracking:</strong> Access your personal dashboard to track clicks, sales, and payouts.</li>
            </ul>
          </div>
        {%- elsif page.content != blank -%}
          {%- assign clean_content = page.content | replace: 'distributor for</p>', 'distributor for Little Creation. We are a UK-based baby brand dedicated to crafting non-toxic, 100% food-grade silicone teething toys that blend safety, developmental play, and modern aesthetics.</p>' | replace: 'distributor for ', 'distributor for Little Creation. We are a UK-based baby brand dedicated to crafting non-toxic, 100% food-grade silicone teething toys that blend safety, developmental play, and modern aesthetics. ' | replace: 'distributor for', 'distributor for Little Creation. We are a UK-based baby brand dedicated to crafting non-toxic, 100% food-grade silicone teething toys that blend safety, developmental play, and modern aesthetics.' -%}
          {%- assign clean_content = clean_content | replace: 'or fill out our contact form with the following details:', '<p style="font-weight: 700; margin-top: 24px;">Please fill out our distributor application form below:</p>' | replace: 'fill out our contact form with the following details:', '<p style="font-weight: 700; margin-top: 24px;">Please fill out our distributor application form below:</p>' -%}
          {%- if clean_content contains 'Apply for a Wholesale Account' -%}
            {%- assign content_parts = clean_content | split: 'Apply for a Wholesale Account' -%}
            {%- assign clean_content = content_parts[0] -%}
          {%- endif -%}
          {%- if clean_content contains '<form' -%}
            {%- assign content_parts = clean_content | split: '<form' -%}
            {%- assign clean_content = content_parts[0] -%}
          {%- endif -%}

          <div class="main-page__content rte animate-on-scroll delay-1">
            {{ clean_content }}
          </div>
        {%- elsif page.handle contains 'wholesale' or page.handle contains 'distributor' or page.title contains 'Distributor' -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            <p style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text); margin-bottom: 24px;">Interested in stocking Little Creation products in your retail store or becoming an authorized regional distributor? We partner with select boutiques, nursery retailers, and international distributors who share our passion for premium, non-toxic baby essentials. Fill out the application form below and our wholesale team will get back to you within 24 hours.</p>
          </div>
        {%- elsif page.handle contains 'shipping' or page.title contains 'Shipping' or page.handle contains 'return' or page.title contains 'Return' -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            <h2>UK Shipping Policy</h2>
            <p>We pack and dispatch all Little Creation orders with care from our UK fulfillment center. All orders are processed within 1-2 business days.</p>
            <ul>
              <li><strong>Standard UK Delivery (3-5 Business Days):</strong> Free on all orders over £40 (or £3.95 for orders under £40).</li>
              <li><strong>Express UK Delivery (1-2 Business Days):</strong> £5.95 next-day dispatch service.</li>
            </ul>

            <h2>30-Day Hassle-Free Returns Policy</h2>
            <p>We want you and your little one to be 100% delighted with your Little Creation order. If for any reason you are not completely satisfied, you may return unopened, unused items in their original packaging within <strong>30 days of delivery</strong> for a full refund or exchange.</p>

            <h2>How to Return an Item</h2>
            <ol>
              <li>Contact our customer support team at <strong>hello@littlecreation.co.uk</strong> with your Order Number and reason for return.</li>
              <li>Our team will issue a return confirmation and instructions on how to ship your package back to us.</li>
              <li>Once received and inspected, your refund will be processed back to your original payment method within 3-5 business days.</li>
            </ol>
          </div>
        {%- else -%}
          <div class="main-page__empty text-center animate-on-scroll delay-1">
            <p class="main-page__empty-text">This page content is currently empty. You can add content to this page in <strong>Shopify Admin → Pages → Edit {{ page.title | escape }}</strong>.</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">Explore Products</a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </section>

  {%- if page.handle contains 'affiliate' or page.title contains 'Affiliate' -%}
    {% render 'contact-form-snippet' %}
  {%- endif -%}

  {%- if page.handle contains 'wholesale' or page.handle contains 'distributor' or page.title contains 'Distributor' -%}
    {% render 'wholesale-form-snippet' %}
  {%- endif -%}

{%- endif -%}

<style>
.main-page {
  padding-top: var(--spacing-xl);
  padding-bottom: var(--spacing-xxl);
}
.main-page__inner {
  max-width: 1080px;
  margin: 0 auto;
}
.main-page__header {
  margin-bottom: 36px;
  text-align: left;
}
.main-page__title {
  font-family: var(--font-heading-family);
  font-size: clamp(2.2rem, 4.5vw, 3.2rem);
  font-weight: 800;
  color: var(--color-heading, #111111);
  margin: 0 0 10px 0;
  line-height: 1.2;
  letter-spacing: -0.01em;
}
.main-page__divider {
  width: 65px;
  height: 3.5px;
  background: linear-gradient(to right, var(--color-primary, #C69A7C), var(--color-primary-dark, #A07855));
  border-radius: var(--radius-pill, 2px);
  margin: 10px 0 0 0;
}

.main-page__content {
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--color-text);
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
}
@media screen and (max-width: 767px) {
  .main-page__content {
    padding: var(--spacing-lg) var(--spacing-md);
  }
}
.main-page__content p {
  margin-bottom: 1.25em;
}
.main-page__content p:last-child {
  margin-bottom: 0;
}
.main-page__content img,
.rte img {
  max-width: 100% !important;
  height: auto !important;
  object-fit: contain !important;
  display: block !important;
  margin: 24px auto !important;
  border-radius: 16px !important;
}

/* Enforce bold 800 fonts ONLY for real heading tags, NOT paragraph strong tags */
.main-page__content h1,
.main-page__content h2,
.main-page__content h3,
.main-page__content h4,
.main-page__content h5,
.main-page__content h6,
.rte h1,
.rte h2,
.rte h3,
.rte h4,
.rte h5,
.rte h6 {
  display: block;
  font-family: var(--font-heading-family);
  color: var(--color-heading, #111111) !important;
  font-weight: 800 !important;
  line-height: 1.25;
  margin-top: 1.8em;
  margin-bottom: 0.65em;
  padding-bottom: 8px;
  border-bottom: 1.5px solid var(--color-border, #E8D5C4) !important;
  width: 100%;
}

.main-page__content h1, .rte h1 {
  font-size: clamp(1.85rem, 4.5vw, 2.8rem);
}
.main-page__content h2, .rte h2 {
  font-size: clamp(1.45rem, 3.2vw, 2.1rem);
}
.main-page__content h3, .rte h3 {
  font-size: clamp(1.3rem, 2.8vw, 1.7rem);
}
.main-page__content h4, .rte h4 {
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
}

.main-page__content > h1:first-child,
.main-page__content > h2:first-child,
.main-page__content > h3:first-child,
.rte > h1:first-child,
.rte > h2:first-child,
.rte > h3:first-child {
  margin-top: 0 !important;
  padding-bottom: 8px !important;
  border-bottom: 1.5px solid var(--color-border, #E8D5C4) !important;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  line-height: 1.2;
}

/* Standalone paragraph strong tags (e.g. <p><strong>Why Join Us?</strong></p>) render as bold section headings with dividers */
.main-page__content p > strong:only-child,
.main-page__content p > b:only-child,
.rte p > strong:only-child,
.rte p > b:only-child {
  display: block !important;
  font-family: var(--font-heading-family) !important;
  font-size: clamp(1.2rem, 2.5vw, 1.45rem) !important;
  font-weight: 800 !important;
  color: var(--color-heading, #111111) !important;
  margin-top: 1.6em !important;
  margin-bottom: 0.6em !important;
  padding-bottom: 6px !important;
  border-bottom: 1.5px solid var(--color-border, #E8D5C4) !important;
  width: 100% !important;
}

/* Inline paragraph strong tags stay clean inline bold text without block underlines */
.main-page__content p strong,
.main-page__content p b,
.rte p strong,
.rte p b {
  display: inline;
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  margin: 0;
  padding: 0;
  border-bottom: none;
  color: var(--color-heading, #111111);
  font-weight: 700;
}

.main-page__content ul,
.main-page__content ol,
.rte ul,
.rte ol {
  padding-left: 1.4rem;
  margin-bottom: 1.5em;
}
.main-page__content li,
.rte li {
  margin-bottom: 0.6em;
  line-height: 1.65;
  color: var(--color-text, #3A2E27);
}

@media screen and (max-width: 768px) {
  .main-page__content p,
  .main-page__inner p,
  .main-page__content .rte p {
    text-align: justify !important;
    text-justify: inter-word;
    hyphens: auto;
  }
}
</style>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
