{%- if page.handle == 'contact' or page.handle == 'contact-us' or page.title == 'Contact' or page.title == 'Contact Us' -%}
  {% section 'contact-form' %}
{%- else -%}
  <section class="main-page section-padding">
    <div class="container">
      <div class="main-page__inner">

        <header class="main-page__header text-center animate-on-scroll">
          <h1 class="main-page__title">{{ page.title | escape }}</h1>
          <div class="main-page__divider"></div>
        </header>

        {%- if page.content != blank -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            {{ page.content }}
          </div>
        {%- elsif page.handle contains 'safety' or page.title contains 'Safety' -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            <h2>Product Safety & Quality Commitment</h2>
            <p>At Little Creation, your baby’s safety and health are at the heart of everything we do. As a brand rooted in Montessori philosophy and maternal care, we refuse to compromise on material purity or safety testing. Every teether and rattle we produce undergoes rigorous quality control and lab testing to exceed UK, EU, and international baby safety standards.</p>

            <h3>Our Premium 100% Food-Grade Silicone</h3>
            <ul>
              <li><strong>100% Non-Toxic & Food-Grade:</strong> Crafted exclusively from pure, premium-grade silicone certified safe for infant teething.</li>
              <li><strong>100% Free From Harmful Chemicals:</strong> Guaranteed 0% BPA, BPS, PVC, Phthalates, Lead, Latex, or Cadmium.</li>
              <li><strong>Hypoallergenic & Bacteria Resistant:</strong> Non-porous surface resists mold, fungus, and bacteria growth.</li>
              <li><strong>Soft & Gentle on Gums:</strong> Perfectly calibrated flexibility to soothe swollen, tender gums without causing oral trauma.</li>
            </ul>

            <h3>UKCA & EN71 Independent Certification</h3>
            <p>Every Little Creation product is independently tested by accredited safety laboratories to comply strictly with:</p>
            <ul>
              <li><strong>EN71-1, 2, 3:</strong> European Toy Safety Standards (Mechanical, Physical, Flammability, and Chemical migration properties).</li>
              <li><strong>UKCA Standard:</strong> UK Conformity Assessed safety certification.</li>
              <li><strong>FDA & LFGB Food Safety Standard:</strong> Meets the world’s strictest food contact safety benchmarks.</li>
            </ul>
            <p>We test for tear strength, bite endurance, choking hazard safety, and heavy metal migration so you can give our teethers to your baby with complete confidence.</p>

            <h3>Sanitisation & High Durability</h3>
            <p>Our silicone products are built to last through intense daily use while remaining effortless to sanitize:</p>
            <ul>
              <li>Can be hand washed with warm soapy water.</li>
              <li>Certain silicone teethers can be disinfected in boiling water or cooled in the refrigerator for extra soothing relief.</li>
              <li>Resistant to extreme temperature variations without warping, cracking, or degrading.</li>
            </ul>
          </div>
        {%- elsif page.handle contains 'declaration' or page.title contains 'Declaration' -%}
          <div class="main-page__content rte animate-on-scroll delay-1">
            <h2>Declaration of Conformity</h2>
            <p>This page contains the official Declaration of Conformity documents for Little Creation products, certifying compliance with UKCA and EU Toy Safety Regulations (EN71 standards).</p>
            <p><em>The official certificates will be updated here.</em></p>
          </div>
        {%- else -%}
          <div class="main-page__empty text-center animate-on-scroll delay-1">
            <p class="main-page__empty-text">This page content is currently empty. You can add content to this page in <strong>Shopify Admin → Pages → Edit {{ page.title | escape }}</strong>.</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">Explore Products</a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </section>

  <style>
  .main-page {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xxl);
  }
  .main-page__inner {
    max-width: 840px;
    margin: 0 auto;
  }
  .main-page__header {
    margin-bottom: var(--spacing-xl);
  }
  .main-page__title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    color: var(--color-heading);
    margin: 0 0 var(--spacing-sm);
    line-height: 1.15;
  }
  .main-page__divider {
    width: 60px;
    height: 3px;
    background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius-pill);
    margin: var(--spacing-sm) auto 0;
  }

  .main-page__content {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl) var(--spacing-lg);
    box-shadow: var(--shadow-sm);
  }
  @media screen and (max-width: 767px) {
    .main-page__content {
      padding: var(--spacing-lg) var(--spacing-md);
    }
  }
  .main-page__content p {
    margin-bottom: 1.25em;
  }
  .main-page__content p:last-child {
    margin-bottom: 0;
  }
  .main-page__content h2, .main-page__content h3, .main-page__content h4 {
    color: var(--color-heading);
    margin-top: 1.5em;
    margin-bottom: 0.6em;
  }
  .main-page__content ul, .main-page__content ol {
    padding-left: 1.4rem;
    margin-bottom: 1.25em;
  }
  .main-page__content li {
    margin-bottom: 0.5em;
  }

  .main-page__empty {
    background: var(--color-skin-pale);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl) var(--spacing-lg);
    margin-top: var(--spacing-md);
  }
  .main-page__empty-text {
    font-size: 1rem;
    color: var(--color-text);
    opacity: 0.8;
    margin-bottom: var(--spacing-md);
    line-height: 1.6;
  }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
