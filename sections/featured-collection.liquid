<section class="featured-collection section-padding" style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="featured-collection__header text-center">
        {%- if section.settings.label != blank -%}
          <span class="section-label">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- assign target_collection = collections[section.settings.collection] -%}
    {%- if target_collection == blank or target_collection.products.size == 0 -%}
      {%- assign target_collection = collections['all'] -%}
    {%- endif -%}

    <div class="featured-collection__grid-wrapper">
      {%- if target_collection != blank and target_collection.products.size > 0 -%}
        {%- assign shown_count = 0 -%}
        {%- for prod in target_collection.products -%}
          {%- if prod.tags contains 'hidden' or prod.handle == 'customised-gift-box' -%}
            {%- continue -%}
          {%- endif -%}
          {%- if prod.id == product.id and target_collection.products.size > 1 -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown_count >= section.settings.products_to_show -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown_count = shown_count | plus: 1 -%}
          <div class="featured-collection__item-wrap">
            {% render 'product-card', product: prod, show_secondary_image: section.settings.show_secondary_image %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="featured-collection__item-wrap">
            <div class="product-card">
              <div class="product-card__image-wrapper">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Little Creation Teether</h3>
                <div class="product-card__price">£8.99</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank and collection.all_products_count > section.settings.products_to_show -%}
      <div class="text-center mt-lg" style="margin-top: 40px;">
        <a href="{{ collection.url }}" class="button button--outline">
          View All Products
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
.featured-collection {
  padding: 48px 0;
  width: 100%;
  clear: both;
  overflow: hidden;
}
.featured-collection .container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 24px;
}
.featured-collection__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 40px;
}
.featured-collection__heading {
  font-family: var(--font-heading-family);
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  color: var(--color-heading, #111111);
  margin: 8px 0 0;
  font-weight: 600;
}
.section-label {
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 0.05em;
  color: var(--color-primary, #C69A7C);
  font-weight: 700;
}

/* Bulletproof Grid */
.featured-collection__grid-wrapper {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: stretch;
  gap: 16px;
  width: 100%;
}

.featured-collection__item-wrap {
  width: calc(50% - 8px); /* 2 columns on mobile */
  max-width: 300px; /* Force strict boundary so images can NEVER be giant */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

@media screen and (min-width: 640px) and (max-width: 1023px) {
  .featured-collection__grid-wrapper {
    gap: 24px;
  }
  .featured-collection__item-wrap {
    width: calc(33.333% - 16px); /* 3 columns on tablet */
    max-width: 300px;
  }
}

@media screen and (min-width: 1024px) {
  .featured-collection__grid-wrapper {
    gap: 28px;
  }
  .featured-collection__item-wrap {
    width: calc(20% - 22.4px); /* 5 columns on desktop */
    max-width: 270px;
  }
}

/* Redefining Product Card exactly for this section to prevent bleed */
.featured-collection__item-wrap .product-card {
  background: var(--color-white, #fff);
  border-radius: var(--radius-lg, 20px);
  overflow: hidden;
  border: 1px solid var(--color-border, #E8D5C4);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 4px 14px rgba(0,0,0,0.05);
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.featured-collection__item-wrap .product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 28px rgba(198,154,124,0.22);
}
.featured-collection__item-wrap .product-card__link {
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
}
.featured-collection__item-wrap .product-card__image-wrapper {
  width: 100%;
  aspect-ratio: 1/1;
  max-height: 300px; /* Failsafe */
  background: var(--color-skin-pale, #FBF0E8);
  position: relative;
  overflow: hidden;
  border-radius: 0; /* Reset border radius inside card to stretch full width */
  flex-shrink: 0;
}
.featured-collection__item-wrap .product-card__image-wrapper img,
.featured-collection__item-wrap .product-card__image-wrapper svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.featured-collection__item-wrap .product-card__info {
  padding: 20px 16px;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-grow: 1;
  min-height: 125px;
}
.featured-collection__item-wrap .product-card__title {
  font-family: var(--font-body-family);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-heading, #111111);
  margin: 0 0 10px;
  line-height: 1.35;
}
.featured-collection__item-wrap .product-card__price {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-primary-dark, #A07855);
}

@media screen and (max-width: 768px) {
  .featured-collection__item-wrap .product-card__info {
    padding: 10px 6px;
    min-height: auto;
  }
  .featured-collection__item-wrap .product-card__title {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 6px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.25em;
  }
  .featured-collection__item-wrap .product-card__image-wrapper {
    aspect-ratio: 1/1;
    width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label above heading",
      "default": "Our bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
