<section class="featured-collection section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="featured-collection__header text-center mb-lg">
        {%- if section.settings.label != blank -%}
          <span class="section-label animate-on-scroll">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="animate-on-scroll delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}

    <!-- Desktop grid / Mobile scroll carousel -->
    <div class="product-carousel">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="product-carousel__item animate-on-scroll delay-{{ forloop.index | modulo: 4 | plus: 1 }}">
            {% render 'product-card', product: product, show_secondary_image: section.settings.show_secondary_image %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-carousel__item">
            <div class="product-card">
              <div class="product-card__image-wrapper">
                <div class="product-card__placeholder">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Little Creation Teether</h3>
                <div class="product-card__price">£19.99</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank and collection.all_products_count > section.settings.products_to_show -%}
      <div class="text-center mt-lg">
        <a href="{{ collection.url }}" class="button button--outline">
          View All Products
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
.featured-collection__header { max-width: 600px; margin-left: auto; margin-right: auto; }

/* Mobile: horizontal scroll carousel */
.product-carousel {
  display: flex;
  gap: var(--spacing-md);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding-bottom: var(--spacing-sm);
  margin: 0;
  padding-left: 0;
  padding-right: 0;
  scrollbar-width: none;
}
.product-carousel::-webkit-scrollbar { display: none; }

.product-carousel__item {
  scroll-snap-align: start;
  flex: 0 0 78%;
  min-width: 78%;
}

/* Desktop: CSS grid */
@media screen and (min-width: 640px) {
  .product-carousel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow-x: visible;
    margin: 0;
    padding: 0;
  }
  .product-carousel__item {
    flex: unset;
    min-width: unset;
  }
}
@media screen and (min-width: 1024px) {
  .product-carousel {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* Product card base */
.product-card {
  background: var(--color-white);
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--color-border);
  transition: box-shadow var(--transition-base), transform var(--transition-base);
  box-shadow: var(--shadow-sm);
}
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-skin);
}
.product-card__image-wrapper {
  aspect-ratio: 4/5;
  background: var(--color-skin-pale);
  overflow: hidden;
  position: relative;
}
.product-card__image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-slow);
}
.product-card:hover .product-card__image-wrapper img {
  transform: scale(1.04);
}
.product-card__placeholder {
  width: 100%;
  height: 100%;
}
.product-card__placeholder svg {
  width: 100%;
  height: 100%;
  fill: rgba(0,0,0,0.06);
}
.product-card__info {
  padding: 16px 20px 20px;
}
.product-card__title {
  font-family: var(--font-body-family);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-heading);
  margin: 0 0 6px;
  line-height: 1.4;
  overflow-wrap: break-word;
}
.product-card__price {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-primary-dark, #A07855);
}
.price-item--sale { color: var(--color-primary); }
.price-item--compare { text-decoration: line-through; opacity: 0.5; font-size: 0.85rem; margin-left: 6px; }
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label above heading",
      "default": "Our bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
