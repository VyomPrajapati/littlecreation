<div class="product section-padding">
  <div class="container">
    <div class="product__grid">

      <!-- Media column -->
      <div class="product__media-col">
        {%- if product.media.size > 0 -%}
          <div class="product__main-image-wrapper">
            <img id="ProductMainImage"
                 src="{{ product.featured_media | image_url: width: 1000 }}"
                 alt="{{ product.featured_media.alt | escape }}"
                 width="{{ product.featured_media.width }}"
                 height="{{ product.featured_media.height }}"
                 loading="eager"
                 class="product__main-image">
          </div>
          {%- if product.media.size > 1 -%}
            <div class="product__thumbnails">
              {%- for media in product.media -%}
                <button class="product__thumb-btn {% if forloop.first %}is-active{% endif %}"
                        data-src="{{ media | image_url: width: 1000 }}"
                        aria-label="View image {{ forloop.index }}">
                  <img src="{{ media | image_url: width: 150 }}"
                       alt="{{ media.alt | escape }}"
                       loading="lazy"
                       width="80" height="80">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="product__media-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        <!-- Trust Badges under image -->
        <div class="product__trust">
          <p class="product__trust-heading">OUR PROMISE TO YOU</p>
          <div class="product__trust-grid">
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <span>100% Safe</span>
            </div>
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              </div>
              <span>BPA Free</span>
            </div>
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <span>UK Tested</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Info column -->
      <div class="product__info-col">
        <div class="product__info-inner" id="ProductInfo-{{ section.id }}">

          <h1 class="product__title">
            {{ product.title | escape }}
          </h1>

          <div class="product__price" id="price-{{ section.id }}">
            {% render 'price', product: product, show_shipping: true %}
          </div>

          {%- if product.description != blank -%}
            <div class="product__description rte">
              {{ product.description }}
            </div>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            <variant-radios class="no-js-hidden product__variants" data-section="{{ section.id }}" data-url="{{ product.url }}">
              {%- for option in product.options_with_values -%}
                <fieldset class="product__option js">
                  <legend class="product__option-label">{{ option.name }}</legend>
                  <div class="product__option-values">
                    {%- for value in option.values -%}
                      <input type="radio"
                             id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                             name="{{ option.name }}"
                             value="{{ value | escape }}"
                             form="product-form-{{ section.id }}"
                             {% if option.selected_value == value %}checked{% endif %}>
                      <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                             class="product__option-value">
                        {{ value }}
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </variant-radios>
          {%- endunless -%}

          <div>
            {%- form 'product', product, id: 'product-form-{{ section.id }}', class: 'product__form' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              <div class="product__quantity-row">
                <label class="product__qty-label" for="Qty-{{ section.id }}">Qty</label>
                <div class="qty-stepper">
                  <button type="button" class="qty-stepper__btn" name="minus" aria-label="Decrease quantity">−</button>
                  <input class="qty-stepper__input" type="number" name="quantity"
                         id="Qty-{{ section.id }}" min="1" value="1" form="product-form-{{ section.id }}">
                  <button type="button" class="qty-stepper__btn" name="plus" aria-label="Increase quantity">+</button>
                </div>
              </div>

              <!-- ---- Gift Option ---- -->
              {%- assign gift_variant_id = section.settings.gift_wrapping_variant_id -%}
              {%- assign gift_price = section.settings.gift_wrapping_price | default: '' -%}
              <div class="product__gift-option" id="GiftOption-{{ section.id }}"
                data-gift-variant="{{ gift_variant_id }}"
                data-gift-price="{{ gift_price }}"
              >
                <label class="gift-toggle" for="GiftCheck-{{ section.id }}">
                  <input
                    type="checkbox"
                    id="GiftCheck-{{ section.id }}"
                    name="properties[🎁 Gift]"
                    value="Yes"
                    class="gift-toggle__input"
                    data-gift-toggle
                  >
                  <span class="gift-toggle__box">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="gift-toggle__label">
                    🎁 Is this a gift?
                    <span class="gift-toggle__hint">
                      {%- if gift_price != blank -%}
                        Add gift wrapping for <strong>{{ gift_price }}</strong> &middot; We'll make it extra special
                      {%- else -%}
                        We'll make it extra special
                      {%- endif -%}
                    </span>
                  </span>
                </label>

                <div class="gift-message-wrap" id="GiftMessageWrap-{{ section.id }}" style="display:none">
                  <label class="gift-message__label" for="GiftMsg-{{ section.id }}">Gift message <span class="gift-message__optional">(optional)</span></label>
                  <textarea
                    id="GiftMsg-{{ section.id }}"
                    name="properties[Gift message]"
                    class="gift-message__input"
                    placeholder="Write a personal message for the recipient…"
                    rows="3"
                    maxlength="200"
                  ></textarea>
                  <span class="gift-message__chars"><span id="GiftMsgCount-{{ section.id }}">0</span>/200</span>
                </div>
              </div>

              <div class="product__buy-buttons">
                <button type="submit" name="add" class="button button--full-width product__atc"
                        {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                  <span>
                    {%- if product.selected_or_first_available_variant.available -%}
                      Add to Bag
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </button>
                <div class="product__dynamic-checkout">
                  {{ form | payment_button }}
                </div>
              </div>
            {%- endform -%}
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<style>
/* ---- Product grid ---- */
.product__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg, 32px);
  align-items: start;
}
@media screen and (min-width: 768px) {
  .product__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl, 48px);
  }
}

/* ---- Media ---- */
.product__main-image-wrapper {
  border-radius: var(--radius-xl, 24px);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  background: var(--color-skin-pale, #FBF0E8);
  aspect-ratio: 1/1;
}
.product__main-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-slow);
}
.product__main-image-wrapper:hover .product__main-image { transform: scale(1.03); }

.product__thumbnails {
  display: flex;
  gap: 10px;
  margin-top: var(--spacing-sm);
  flex-wrap: wrap;
}
.product__thumb-btn {
  background: none;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0;
  cursor: pointer;
  width: 72px;
  height: 72px;
  overflow: hidden;
  flex-shrink: 0;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  box-shadow: none;
}
.product__thumb-btn img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.product__thumb-btn:hover,
.product__thumb-btn.is-active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px rgba(198,154,124,0.25);
}

.product__media-placeholder {
  aspect-ratio: 1/1;
  background: var(--color-skin-pale);
  border-radius: var(--radius-xl);
}
.product__media-placeholder svg { width: 100%; height: 100%; fill: rgba(0,0,0,0.06); }

/* ---- Trust badges under images ---- */
.product__trust {
  background: var(--color-skin-pale, #FBF0E8);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  padding: var(--spacing-lg, 24px) var(--spacing-md, 20px);
  margin-top: var(--spacing-lg, 24px);
}
.product__trust-heading {
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-heading);
  text-align: center;
  margin: 0 0 var(--spacing-md, 20px);
}
.product__trust-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
}
.trust-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-heading);
  text-align: center;
}
.trust-badge__icon {
  width: 50px;
  height: 50px;
  background: linear-gradient(135deg, var(--color-skin-light), var(--color-secondary));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(198,154,124,0.18);
}
.trust-badge__icon svg {
  width: 24px;
  height: 24px;
  stroke: var(--color-primary-dark, #A07855);
}

/* ---- Info column ---- */
.product__info-inner {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 24px);
}
.product__title {
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  color: var(--color-heading);
  margin: 0 0 var(--spacing-xs, 8px) 0;
  line-height: 1.2;
  overflow-wrap: break-word;
}
.product__price {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary-dark, #A07855);
}

/* ---- Description (Above buttons) ---- */
.product__description {
  font-size: 0.98rem;
  line-height: 1.8;
  color: var(--color-text);
  padding: var(--spacing-sm, 16px) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.product__description p { margin-bottom: 0.75em; }
.product__description p:last-child { margin-bottom: 0; }
.product__description ul, .product__description ol {
  padding-left: 1.2rem;
  margin-bottom: 0.75em;
}
.product__description li {
  margin-bottom: 0.5em;
  line-height: 1.65;
}

/* ---- Form & Buy Buttons ---- */
.product__form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 20px);
}

/* ---- Variants ---- */
.product__option {
  border: none;
  padding: 0;
  margin: 0 0 var(--spacing-sm, 16px) 0;
}
.product__option-label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-heading);
  margin-bottom: 10px;
}
.product__option-values {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.product__option-values input[type="radio"] {
  position: absolute;
  width: 1px; height: 1px;
  overflow: hidden; clip: rect(0,0,0,0);
}
.product__option-value {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-pill);
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text);
  background: var(--color-white);
  transition: all var(--transition-fast);
  user-select: none;
}
.product__option-value:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.product__option-values input:checked + .product__option-value {
  background: var(--color-primary);
  color: var(--color-white);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-skin);
}

/* ---- Quantity ---- */
.product__quantity-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm, 16px);
  margin-bottom: var(--spacing-xs, 8px);
}
.product__qty-label {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-heading);
}
.qty-stepper {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-pill);
  overflow: hidden;
  background: var(--color-white);
}
.qty-stepper__btn {
  background: none;
  border: none;
  width: 44px;
  height: 44px;
  cursor: pointer;
  font-size: 1.2rem;
  color: var(--color-heading);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--transition-fast);
  box-shadow: none;
  padding: 0;
}
.qty-stepper__btn:hover { background: var(--color-skin-pale); }
.qty-stepper__input {
  width: 52px;
  text-align: center;
  border: none;
  border-left: 1.5px solid var(--color-border);
  border-right: 1.5px solid var(--color-border);
  background: none;
  font-family: var(--font-body-family);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-heading);
  padding: 8px 0;
  -moz-appearance: textfield;
  border-radius: 0;
  box-shadow: none;
}
.qty-stepper__input::-webkit-outer-spin-button,
.qty-stepper__input::-webkit-inner-spin-button { -webkit-appearance: none; }

/* ---- Buy buttons ---- */
.product__buy-buttons {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.product__atc {
  font-size: 1.05rem;
  padding: 18px 28px;
  letter-spacing: 0.04em;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-skin);
}
.product__dynamic-checkout {
  text-align: center;
}
.product__dynamic-checkout .shopify-payment-button {
  margin: 0;
}
.product__dynamic-checkout .shopify-payment-button__button {
  border-radius: var(--radius-pill) !important;
  min-height: 52px !important;
}
.product__dynamic-checkout .shopify-payment-button__more-options {
  margin-top: 10px !important;
  font-size: 0.88rem !important;
  color: var(--color-primary-dark, #A07855) !important;
  text-decoration: underline !important;
}

/* ---- Gift Option ---- */
.product__gift-option {
  margin: var(--spacing-md, 24px) 0;
  padding: 16px 20px;
  border: 2px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  background: var(--color-skin-pale, #FBF0E8);
  transition: border-color 0.2s, background-color 0.2s;
}
.product__gift-option:has(.gift-toggle__input:checked) {
  border-color: var(--color-primary, #C69A7C);
  background: #fff;
}

/* Custom checkbox */
.gift-toggle {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  user-select: none;
}
.gift-toggle__input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.gift-toggle__box {
  width: 22px;
  height: 22px;
  border: 2px solid var(--color-border, #E8D5C4);
  border-radius: 6px;
  background: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s, background-color 0.2s;
}
.gift-toggle__box svg {
  opacity: 0;
  color: #fff;
  transition: opacity 0.15s;
}
.gift-toggle__input:checked ~ .gift-toggle__box {
  background: var(--color-primary, #C69A7C);
  border-color: var(--color-primary, #C69A7C);
}
.gift-toggle__input:checked ~ .gift-toggle__box svg { opacity: 1; }

.gift-toggle__label {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-family: var(--font-heading-family);
  font-size: 1rem;
  color: var(--color-heading);
}
.gift-toggle__hint {
  font-family: var(--font-body-family);
  font-size: 0.78rem;
  color: var(--color-text);
  opacity: 0.6;
  font-weight: 400;
}

/* Gift message textarea */
.gift-message-wrap {
  margin-top: 14px;
  position: relative;
}
.gift-message__label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-heading);
  margin-bottom: 6px;
}
.gift-message__optional { font-weight: 400; opacity: 0.55; }
.gift-message__input {
  width: 100%;
  padding: 12px 14px;
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 16px);
  font-family: var(--font-body-family);
  font-size: 0.9rem;
  color: var(--color-text);
  background: #fff;
  resize: vertical;
  min-height: 80px;
  box-sizing: border-box;
  transition: border-color 0.2s;
  box-shadow: none;
}
.gift-message__input:focus {
  outline: none;
  border-color: var(--color-primary, #C69A7C);
}
.gift-message__chars {
  position: absolute;
  bottom: 8px;
  right: 12px;
  font-size: 0.72rem;
  color: var(--color-text);
  opacity: 0.4;
  pointer-events: none;
}
</style>

<script>
(function() {
  var giftOptionEl = document.querySelector('[data-gift-variant]');
  var checkbox = document.querySelector('[data-gift-toggle]');
  if (!checkbox || !giftOptionEl) return;

  var sectionId    = checkbox.id.replace('GiftCheck-', '');
  var variantId    = giftOptionEl.dataset.giftVariant;   // from section setting
  var messageWrap  = document.getElementById('GiftMessageWrap-' + sectionId);
  var textarea     = messageWrap ? messageWrap.querySelector('textarea') : null;
  var counter      = document.getElementById('GiftMsgCount-' + sectionId);
  var giftLineKey  = null;  // tracks which cart line is the gift wrap item

  // Find existing gift wrap line in cart (on page load)
  async function findGiftLine() {
    if (!variantId) return null;
    try {
      var res  = await fetch('/cart.js');
      var cart = await res.json();
      var line = cart.items.find(function(i) { return String(i.variant_id) === String(variantId); });
      return line ? line.key : null;
    } catch(e) { return null; }
  }

  async function addGiftWrap() {
    if (!variantId) return;
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: parseInt(variantId), quantity: 1, properties: { 'Order note': 'Gift wrapping' } })
      });
      // Refresh CartDrawer if it exists
      if (window.CartDrawer && typeof window.CartDrawer.refresh === 'function') {
        await window.CartDrawer.refresh();
      }
    } catch(e) { console.error('Could not add gift wrap', e); }
  }

  async function removeGiftWrap() {
    if (!variantId) return;
    try {
      // Find the line with this variant and set qty to 0
      var res  = await fetch('/cart.js');
      var cart = await res.json();
      var lineIdx = null;
      cart.items.forEach(function(item, idx) {
        if (String(item.variant_id) === String(variantId)) lineIdx = idx + 1;
      });
      if (lineIdx) {
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ line: lineIdx, quantity: 0 })
        });
        if (window.CartDrawer && typeof window.CartDrawer.refresh === 'function') {
          await window.CartDrawer.refresh();
        }
      }
    } catch(e) { console.error('Could not remove gift wrap', e); }
  }

  checkbox.addEventListener('change', async function() {
    if (messageWrap) {
      messageWrap.style.display = this.checked ? 'block' : 'none';
      if (this.checked && textarea) textarea.focus();
    }
    if (!this.checked && textarea) textarea.value = '';

    // Add/remove the gift wrap product from cart
    if (variantId) {
      checkbox.disabled = true;
      if (this.checked) {
        await addGiftWrap();
      } else {
        await removeGiftWrap();
      }
      checkbox.disabled = false;
    }
  });

  if (textarea && counter) {
    textarea.addEventListener('input', function() {
      counter.textContent = this.value.length;
    });
  }
})();
</script>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "header",
      "content": "🎁 Gift Wrapping"
    },
    {
      "type": "text",
      "id": "gift_wrapping_variant_id",
      "label": "Gift Wrapping product Variant ID",
      "info": "Create a 'Gift Wrapping' product in Products, then paste its Variant ID here. Customers will be charged this product's price when they tick the gift box."
    },
    {
      "type": "text",
      "id": "gift_wrapping_price",
      "label": "Gift Wrapping price (display only, e.g. £2.99)",
      "info": "Shown next to the checkbox so customers know the cost. Must match the actual product price."
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Picker", "limit": 1 },
