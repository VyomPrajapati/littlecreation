<section class="spotlight-grid section-padding">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="spotlight-grid__header text-center mb-xl">
        {%- if section.settings.subtitle != blank -%}
          <span class="section-label animate-on-scroll">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        <h2 class="animate-on-scroll delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="spotlight-grid__layout">

      <!-- Main product -->
      <div class="spotlight-grid__main animate-on-scroll delay-1">
        {%- assign main_product = all_products[section.settings.main_product] -%}
        {%- if main_product != empty -%}
          {% render 'product-card', product: main_product, show_secondary_image: true %}
        {%- else -%}
          <div class="spotlight-placeholder spotlight-placeholder--tall">
            <img src="https://placehold.co/600x760/F5DEC8/C69A7C?text=Main+Product" alt="Main product placeholder" style="width:100%;height:100%;object-fit:cover;">
            <div class="spotlight-placeholder__label">Highlight Product</div>
          </div>
        {%- endif -%}
      </div>

      <!-- Secondary products stacked -->
      <div class="spotlight-grid__secondary">
        <div class="spotlight-grid__item animate-on-scroll delay-2">
          {%- assign sec1 = all_products[section.settings.secondary_product_1] -%}
          {%- if sec1 != empty -%}
            {% render 'product-card', product: sec1, show_secondary_image: true %}
          {%- else -%}
            <div class="spotlight-placeholder">
              <img src="https://placehold.co/500x500/F5DEC8/C69A7C?text=Product+2" alt="Product placeholder" style="width:100%;height:100%;object-fit:cover;">
            </div>
          {%- endif -%}
        </div>

        <div class="spotlight-grid__item animate-on-scroll delay-3">
          {%- assign sec2 = all_products[section.settings.secondary_product_2] -%}
          {%- if sec2 != empty -%}
            {% render 'product-card', product: sec2, show_secondary_image: true %}
          {%- else -%}
            <div class="spotlight-placeholder">
              <img src="https://placehold.co/500x500/F5DEC8/C69A7C?text=Product+3" alt="Product placeholder" style="width:100%;height:100%;object-fit:cover;">
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.spotlight-grid__header { max-width: 560px; margin-left: auto; margin-right: auto; }

.spotlight-grid__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-md);
}
@media screen and (min-width: 768px) {
  .spotlight-grid__layout {
    grid-template-columns: 1.5fr 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }
}

.spotlight-grid__secondary {
  display: flex;
  gap: var(--spacing-md);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  margin: 0 calc(-1 * var(--spacing-sm, 16px));
  padding-left: var(--spacing-sm, 16px);
  padding-right: var(--spacing-sm, 16px);
  padding-bottom: var(--spacing-xs);
  scrollbar-width: none;
}
.spotlight-grid__secondary::-webkit-scrollbar { display: none; }

.spotlight-grid__item {
  scroll-snap-align: start;
  flex: 0 0 75%;
  min-width: 75%;
}

@media screen and (min-width: 768px) {
  .spotlight-grid__secondary {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
    overflow-x: visible;
    margin: 0;
    padding: 0;
  }
  .spotlight-grid__item {
    flex: unset;
    min-width: unset;
  }
}

/* Placeholder */
.spotlight-placeholder {
  aspect-ratio: 1 / 1;
  background: var(--color-skin-light);
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-md);
}
.spotlight-placeholder--tall {
  aspect-ratio: 1 / 1;
}
@media screen and (min-width: 768px) {
  .spotlight-placeholder--tall {
    aspect-ratio: 3 / 4;
  }
}
.spotlight-placeholder__label {
  position: absolute;
  bottom: var(--spacing-sm);
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.9);
  padding: 8px 20px;
  border-radius: var(--radius-pill);
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--color-heading);
  white-space: nowrap;
}
</style>

{% schema %}
{
  "name": "Weekly Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Label above heading",
      "default": "Made with love"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Weekly Spotlight"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main highlight product"
    },
    {
      "type": "product",
      "id": "secondary_product_1",
      "label": "Secondary product 1"
    },
    {
      "type": "product",
      "id": "secondary_product_2",
      "label": "Secondary product 2"
    }
  ],
  "presets": [
    { "name": "Weekly Spotlight" }
  ]
}
{% endschema %}
