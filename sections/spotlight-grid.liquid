<section class="spotlight-section section-padding" style="background-color: {{ section.settings.bg_color | default: '#FBF0E8' }};">
  <div class="container">

    <!-- Header -->
    <div class="spotlight-section__header text-center mb-xl">
      {%- if section.settings.subtitle != blank -%}
        <span class="section-label animate-on-scroll">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      <h2 class="spotlight-section__title animate-on-scroll delay-1">{{ section.settings.heading | default: 'Weekly Spotlight' }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="spotlight-section__subtext animate-on-scroll delay-2">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <!-- Spotlight Cards Grid -->
    <div class="spotlight-grid">

      <!-- Main Featured Product Card -->
      <div class="spotlight-card spotlight-card--main animate-on-scroll delay-1">
        {%- assign main_prod = all_products[section.settings.main_product] -%}
        {%- if main_prod != empty -%}
          {% render 'product-card', product: main_prod, show_secondary_image: true %}
        {%- else -%}
          <div class="spotlight-card__inner">
            <div class="spotlight-card__badge">★ Top Pick</div>
            <div class="spotlight-card__image-box">
              <img src="https://placehold.co/600x600/F5DEC8/3A2E27?text=Mighty+Lion+Teether" alt="Mighty Lion Teether" loading="lazy">
            </div>
            <div class="spotlight-card__content">
              <span class="spotlight-card__tag">Montessori Sensory</span>
              <h3 class="spotlight-card__title">Mighty Lion Rattle Teether</h3>
              <p class="spotlight-card__desc">Dual-action rattle & textured silicone teether designed for tiny hands.</p>
              <div class="spotlight-card__price-row">
                <span class="spotlight-card__price">£19.99 GBP</span>
                <a href="/collections/all" class="button button--small">Shop Now →</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Secondary Product Card 1 -->
      <div class="spotlight-card animate-on-scroll delay-2">
        {%- assign sec_prod_1 = all_products[section.settings.secondary_product_1] -%}
        {%- if sec_prod_1 != empty -%}
          {% render 'product-card', product: sec_prod_1, show_secondary_image: true %}
        {%- else -%}
          <div class="spotlight-card__inner">
            <div class="spotlight-card__image-box">
              <img src="https://placehold.co/500x500/F5DEC8/3A2E27?text=Crown+Swan+Teether" alt="Crown Swan Teether" loading="lazy">
            </div>
            <div class="spotlight-card__content">
              <span class="spotlight-card__tag">Cooling Relief</span>
              <h3 class="spotlight-card__title">Crown Swan Water Teether</h3>
              <div class="spotlight-card__price-row">
                <span class="spotlight-card__price">£19.99 GBP</span>
                <a href="/collections/all" class="button button--small button--outline">View →</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Secondary Product Card 2 -->
      <div class="spotlight-card animate-on-scroll delay-3">
        {%- assign sec_prod_2 = all_products[section.settings.secondary_product_2] -%}
        {%- if sec_prod_2 != empty -%}
          {% render 'product-card', product: sec_prod_2, show_secondary_image: true %}
        {%- else -%}
          <div class="spotlight-card__inner">
            <div class="spotlight-card__image-box">
              <img src="https://placehold.co/500x500/F5DEC8/3A2E27?text=Bear+Cooling+Teether" alt="Bear Cooling Teether" loading="lazy">
            </div>
            <div class="spotlight-card__content">
              <span class="spotlight-card__tag">Easy Grip</span>
              <h3 class="spotlight-card__title">Bear Cooling Teether Ring</h3>
              <div class="spotlight-card__price-row">
                <span class="spotlight-card__price">£19.99 GBP</span>
                <a href="/collections/all" class="button button--small button--outline">View →</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

<style>
.spotlight-section {
  position: relative;
  overflow: hidden;
}
.spotlight-section__header {
  max-width: 580px;
  margin-left: auto;
  margin-right: auto;
}
.spotlight-section__subtext {
  font-size: 1.05rem;
  color: var(--color-text);
  opacity: 0.85;
  margin-top: 8px;
}

/* Grid layout */
.spotlight-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-md, 24px);
  align-items: stretch;
}
@media screen and (min-width: 768px) {
  .spotlight-grid {
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: var(--spacing-lg, 32px);
  }
}

/* Spotlight Card */
.spotlight-card {
  background: var(--color-white, #FFFFFF);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
}
.spotlight-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-skin);
}

.spotlight-card__inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
  padding: 20px;
}

.spotlight-card__badge {
  position: absolute;
  top: 30px;
  left: 30px;
  z-index: 2;
  background: var(--color-button-background, #C69A7C);
  color: #FFFFFF;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 5px 14px;
  border-radius: var(--radius-pill, 50px);
  box-shadow: 0 4px 12px rgba(198, 154, 124, 0.3);
}

.spotlight-card__image-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--radius-lg, 16px);
  overflow: hidden;
  background: var(--color-skin-pale, #FBF0E8);
  margin-bottom: 16px;
}
.spotlight-card__image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.spotlight-card:hover .spotlight-card__image-box img {
  transform: scale(1.05);
}

.spotlight-card__content {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.spotlight-card__tag {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-primary, #C69A7C);
  margin-bottom: 4px;
}

.spotlight-card__title {
  font-size: 1.2rem;
  color: var(--color-heading, #111111);
  margin-bottom: 8px;
  line-height: 1.25;
}

.spotlight-card__desc {
  font-size: 0.9rem;
  color: var(--color-text, #3A2E27);
  opacity: 0.85;
  line-height: 1.5;
  margin-bottom: 16px;
}

.spotlight-card__price-row {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border, #E8D5C4);
}

.spotlight-card__price {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-heading);
}

.button--small {
  padding: 8px 18px !important;
  font-size: 0.85rem !important;
}
</style>

{% schema %}
{
  "name": "Weekly Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Label above heading",
      "default": "Handpicked for baby"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Weekly Spotlight"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Explore our flagship Montessori teethers designed for comfort and early development."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FBF0E8"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Featured Product (Card 1)"
    },
    {
      "type": "product",
      "id": "secondary_product_1",
      "label": "Featured Product 2 (Card 2)"
    },
    {
      "type": "product",
      "id": "secondary_product_2",
      "label": "Featured Product 3 (Card 3)"
    }
  ],
  "presets": [
    {
      "name": "Weekly Spotlight"
    }
  ]
}
{% endschema %}
