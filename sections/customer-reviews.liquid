<section class="customer-reviews section-padding" id="CustomerReviews-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    <!-- Header row: summary + write a review -->
    <div class="cr-header animate-on-scroll">
      <h2 class="cr-heading">{{ section.settings.heading | default: 'Customer reviews' }}</h2>

      <div class="cr-summary">
        <!-- Score box -->
        <div class="cr-score-box">
          <span class="cr-score-number">{{ section.settings.aggregate_score }}</span>
        </div>

        <!-- Stars + count -->
        <div class="cr-score-meta">
          <div class="cr-stars">★★★★★</div>
          <p class="cr-count">Based on {{ section.blocks.size }} Reviews</p>
        </div>

        <!-- Bar chart – each row is clickable to filter -->
        <div class="cr-bars">
          {%- assign star_rows = '5,4,3,2,1' | split: ',' -%}
          {%- assign pct_vals = section.settings.five_star_pct | append: ',' | append: section.settings.four_star_pct | append: ',' | append: section.settings.three_star_pct | append: ',' | append: section.settings.two_star_pct | append: ',' | append: section.settings.one_star_pct | split: ',' -%}
          {%- assign cnt_vals = section.settings.five_star_count | append: ',' | append: section.settings.four_star_count | append: ',' | append: section.settings.three_star_count | append: ',' | append: section.settings.two_star_count | append: ',' | append: section.settings.one_star_count | split: ',' -%}
          {%- for star in star_rows -%}
            {%- assign idx = forloop.index0 -%}
            <button class="cr-bar-row" data-filter-star="{{ star }}" aria-label="Filter by {{ star }} stars" type="button">
              <span class="cr-bar-label">{{ star }}</span>
              <span class="cr-bar-star">★</span>
              <div class="cr-bar-track">
                <div class="cr-bar-fill" style="width: {{ pct_vals[idx] }}%;"></div>
              </div>
              <span class="cr-bar-count">({{ cnt_vals[idx] }})</span>
            </button>
          {%- endfor -%}
        </div>

        <!-- Write a review button -->
        <div class="cr-write-wrap">
          {%- if section.settings.review_link != blank -%}
            <a href="{{ section.settings.review_link }}" class="cr-write-btn" target="_blank" rel="noopener">Write a Review</a>
          {%- else -%}
            <button class="cr-write-btn" type="button" onclick="alert('Review form coming soon!')">Write a Review</button>
          {%- endif -%}
        </div>
      </div>

      <!-- Active filter indicator -->
      <div class="cr-filter-status" id="cr-filter-status-{{ section.id }}" style="display:none;">
        Showing <strong id="cr-filter-label-{{ section.id }}"></strong> star reviews
        <button class="cr-clear-filter" data-clear-filter type="button">× Clear</button>
      </div>
    </div>

    <!-- Review Cards -->
    <div class="cr-grid" id="cr-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="review-card animate-on-scroll" data-rating="{{ block.settings.rating }}" {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank or block.settings.fallback_image_url != blank -%}
            <div class="review-card__image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="Review image from {{ block.settings.author }}" loading="lazy">
              {%- else -%}
                <img src="{{ block.settings.fallback_image_url }}" alt="Review image from {{ block.settings.author }}" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="review-card__body">
            <div class="review-card__stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <span class="star star--filled">★</span>
                {%- else -%}
                  <span class="star star--empty">☆</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="review-card__text">{{ block.settings.text }}</p>
            <div class="review-card__author-row">
              <div class="review-card__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</div>
              <div class="review-card__meta">
                <strong class="review-card__author-name">{{ block.settings.author }}</strong>
                <span class="review-card__verified">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#4CAF50"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  Verified
                </span>
              </div>
              <time class="review-card__date">{{ block.settings.date }}</time>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

    <!-- Empty state when filter has no results -->
    <p class="cr-no-results" id="cr-no-results-{{ section.id }}" style="display:none;">No reviews found for this rating.</p>

  </div>
</section>

<style>
/* ---- Section wrapper ---- */
.customer-reviews { padding: var(--spacing-xl, 64px) 0; }

/* ---- Header ---- */
.cr-header { margin-bottom: var(--spacing-lg, 40px); }
.cr-heading {
  font-family: var(--font-heading-family);
  font-size: clamp(1.4rem, 3vw, 2rem);
  color: var(--color-heading);
  margin: 0 0 var(--spacing-md, 24px);
}

/* ---- Summary row ---- */
.cr-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: var(--spacing-md, 24px);
}

/* Score box */
.cr-score-box {
  width: 68px;
  height: 68px;
  background: var(--color-primary, #C69A7C);
  border-radius: var(--radius-lg, 16px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cr-score-number {
  font-family: var(--font-heading-family);
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

/* Stars + count */
.cr-score-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
  flex-shrink: 0;
}
.cr-stars {
  font-size: 1.35rem;
  color: #F5A623;
  letter-spacing: 2px;
}
.cr-count {
  font-size: 0.82rem;
  color: var(--color-text);
  opacity: 0.65;
  margin: 0;
  white-space: nowrap;
}

/* Bar chart */
.cr-bars {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
  min-width: 180px;
  max-width: 320px;
}
.cr-bar-row {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  padding: 3px 6px;
  border-radius: var(--radius-md, 8px);
  cursor: pointer;
  transition: background-color 0.2s;
  text-align: left;
  width: 100%;
}
.cr-bar-row:hover,
.cr-bar-row.is-active {
  background: var(--color-skin-pale, #FBF0E8);
}
.cr-bar-label {
  font-size: 0.8rem;
  color: var(--color-text);
  width: 10px;
  text-align: right;
  flex-shrink: 0;
}
.cr-bar-star {
  color: #F5A623;
  font-size: 0.78rem;
  flex-shrink: 0;
}
.cr-bar-track {
  flex: 1;
  height: 8px;
  background: var(--color-skin-light, #F5DEC8);
  border-radius: var(--radius-pill, 50px);
  overflow: hidden;
}
.cr-bar-fill {
  height: 100%;
  background: var(--color-primary, #C69A7C);
  border-radius: var(--radius-pill, 50px);
  transition: width 0.4s ease;
}
.cr-bar-row.is-active .cr-bar-fill {
  background: var(--color-primary-dark, #A07855);
}
.cr-bar-count {
  font-size: 0.78rem;
  color: var(--color-text);
  opacity: 0.6;
  min-width: 28px;
  flex-shrink: 0;
}

/* Write a review button */
.cr-write-wrap {
  display: flex;
  align-items: flex-start;
  margin-left: auto;
  flex-shrink: 0;
}
.cr-write-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  background: var(--color-heading, #111111);
  color: #fff;
  font-family: var(--font-heading-family);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 2px solid var(--color-heading, #111111);
  border-radius: var(--radius-md, 8px);
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 0.2s, color 0.2s;
}
.cr-write-btn:hover {
  background: transparent;
  color: var(--color-heading, #111111);
}

/* Filter status pill */
.cr-filter-status {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: var(--spacing-sm, 16px);
  font-size: 0.85rem;
  color: var(--color-text);
  background: var(--color-skin-pale, #FBF0E8);
  border-radius: var(--radius-pill, 50px);
  padding: 6px 16px;
  width: fit-content;
}
.cr-clear-filter {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-primary, #C69A7C);
  font-size: 1rem;
  padding: 0;
  line-height: 1;
}

/* ---- Review Grid ---- */
.cr-grid {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 16px;
  gap: var(--spacing-md, 24px);
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
}
.cr-grid::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}
.cr-grid > .review-card {
  scroll-snap-align: center;
  flex: 0 0 85%;
}

@media screen and (min-width: 640px) {
  .cr-grid { 
    display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    overflow-x: visible;
  }
  .cr-grid > .review-card { flex: auto; }
}
@media screen and (min-width: 1024px) {
  .cr-grid { grid-template-columns: repeat(3, 1fr); }
}
@media screen and (min-width: 1280px) {
  .cr-grid { grid-template-columns: repeat(4, 1fr); }
}

.cr-no-results {
  text-align: center;
  padding: var(--spacing-lg, 40px);
  color: var(--color-text);
  opacity: 0.6;
  font-size: 0.95rem;
}

/* ---- Review Card (keep existing styles) ---- */
.review-card {
  background: var(--color-white, #fff);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.3s, transform 0.3s;
}
.review-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-skin);
}
.review-card__image { overflow: hidden; max-height: 200px; }
.review-card__image img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform 0.5s; }
.review-card:hover .review-card__image img { transform: scale(1.04); }
.review-card__body { padding: 20px; display: flex; flex-direction: column; flex: 1; gap: 12px; }
.review-card__stars { display: flex; gap: 2px; }
.star--filled { color: #F5A623; font-size: 1rem; }
.star--empty  { color: #E0D5C8; font-size: 1rem; }
.review-card__text { font-size: 0.9rem; line-height: 1.65; color: var(--color-text); flex: 1; margin: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden; }
.review-card__author-row { display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--color-border, #E8D5C4); }
.review-card__avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--color-secondary, #E0B898), var(--color-primary, #C69A7C)); color: #fff; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.review-card__meta { flex: 1; min-width: 0; }
.review-card__author-name { display: block; font-size: 0.85rem; color: var(--color-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.review-card__verified { display: inline-flex; align-items: center; gap: 3px; font-size: 0.72rem; color: #4CAF50; font-weight: 500; }
.review-card__date { font-size: 0.72rem; color: var(--color-text); opacity: 0.45; white-space: nowrap; flex-shrink: 0; }

/* Hidden card when filtered */
.review-card[hidden] { display: none !important; }
</style>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var grid = document.getElementById('cr-grid-' + sectionId);
  var filterStatus = document.getElementById('cr-filter-status-' + sectionId);
  var filterLabel = document.getElementById('cr-filter-label-' + sectionId);
  var noResults = document.getElementById('cr-no-results-' + sectionId);
  var activeStar = null;

  function applyFilter(star) {
    activeStar = star;
    var cards = grid.querySelectorAll('.review-card');
    var visible = 0;
    cards.forEach(function(card) {
      if (!star || card.dataset.rating === String(star)) {
        card.removeAttribute('hidden');
        visible++;
      } else {
        card.setAttribute('hidden', '');
      }
    });
    // Update bar row active state
    document.querySelectorAll('[data-filter-star]').forEach(function(btn) {
      btn.classList.toggle('is-active', btn.dataset.filterStar === String(star));
    });
    // Filter status
    if (star) {
      filterStatus.style.display = 'flex';
      filterLabel.textContent = star;
    } else {
      filterStatus.style.display = 'none';
    }
    noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  // Bar click
  document.querySelectorAll('[data-filter-star]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var star = btn.dataset.filterStar;
      if (activeStar === star) {
        applyFilter(null); // toggle off
      } else {
        applyFilter(star);
      }
    });
  });

  // Clear filter
  document.querySelectorAll('[data-clear-filter]').forEach(function(btn) {
    btn.addEventListener('click', function() { applyFilter(null); });
  });
})();
</script>

