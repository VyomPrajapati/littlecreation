    {
      "type": "range",
      "id": "four_star_pct",
      "min": 0, "max": 100, "step": 5, "default": 20,
      "label": "4-star bar %"
    },
    {
      "type": "text",
      "id": "four_star_count",
      "label": "4-star count",
      "default": "2"
    },
    {
      "type": "range",
      "id": "three_star_pct",
      "min": 0, "max": 100, "step": 5, "default": 0,
      "label": "3-star bar %"
    },
    {
      "type": "text",
      "id": "three_star_count",
      "label": "3-star count",
      "default": "0"
    },
    {
      "type": "range",
      "id": "two_star_pct",
      "min": 0, "max": 100, "step": 5, "default": 0,
      "label": "2-star bar %"
    },
    {
      "type": "text",
      "id": "two_star_count",
      "label": "2-star count",
      "default": "0"
    },
    {
      "type": "range",
      "id": "one_star_pct",
      "min": 0, "max": 100, "step": 5, "default": 0,
      "label": "1-star bar %"
    },
    {
      "type": "text",
      "id": "one_star_count",
      "label": "1-star count",
      "default": "0"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FBF0E8"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
