<section class="customer-reviews section-padding" id="CustomerReviews-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    {%- assign total_rating = 0 -%}
    {%- assign one_star = 0 -%}
    {%- assign two_star = 0 -%}
    {%- assign three_star = 0 -%}
    {%- assign four_star = 0 -%}
    {%- assign five_star = 0 -%}
    {%- assign review_count = section.blocks.size -%}

    {%- for block in section.blocks -%}
      {%- assign block_rating = block.settings.rating | plus: 0 -%}
      {%- assign total_rating = total_rating | plus: block_rating -%}
      {%- if block_rating == 5 -%}
        {%- assign five_star = five_star | plus: 1 -%}
      {%- elsif block_rating == 4 -%}
        {%- assign four_star = four_star | plus: 1 -%}
      {%- elsif block_rating == 3 -%}
        {%- assign three_star = three_star | plus: 1 -%}
      {%- elsif block_rating == 2 -%}
        {%- assign two_star = two_star | plus: 1 -%}
      {%- elsif block_rating == 1 -%}
        {%- assign one_star = one_star | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if review_count > 0 -%}
      {%- assign avg_rating = total_rating | times: 10 | divided_by: review_count | divided_by: 10.0 -%}
      {%- assign five_pct = five_star | times: 100 | divided_by: review_count -%}
      {%- assign four_pct = four_star | times: 100 | divided_by: review_count -%}
      {%- assign three_pct = three_star | times: 100 | divided_by: review_count -%}
      {%- assign two_pct = two_star | times: 100 | divided_by: review_count -%}
      {%- assign one_pct = one_star | times: 100 | divided_by: review_count -%}
    {%- else -%}
      {%- assign avg_rating = 0 -%}
      {%- assign five_pct = 0 -%}
      {%- assign four_pct = 0 -%}
      {%- assign three_pct = 0 -%}
      {%- assign two_pct = 0 -%}
      {%- assign one_pct = 0 -%}
    {%- endif -%}

    <!-- Header row: summary + write a review -->
    <div class="cr-header animate-on-scroll">
      <h2 class="cr-heading">{{ section.settings.heading | default: 'Customer reviews' }}</h2>

      <div class="cr-summary">
        <!-- Score box -->
        <div class="cr-score-box">
          <span class="cr-score-number">{{ avg_rating }}</span>
        </div>

        <!-- Stars + count -->
        <div class="cr-score-meta">
          <div class="cr-stars">★★★★★</div>
          <p class="cr-count">Based on {{ review_count }} Reviews</p>
        </div>

        <!-- Bar chart – each row is clickable to filter -->
        <div class="cr-bars">
          {%- assign star_rows = '5,4,3,2,1' | split: ',' -%}
          {%- assign pct_vals = five_pct | append: ',' | append: four_pct | append: ',' | append: three_pct | append: ',' | append: two_pct | append: ',' | append: one_pct | split: ',' -%}
          {%- assign cnt_vals = five_star | append: ',' | append: four_star | append: ',' | append: three_star | append: ',' | append: two_star | append: ',' | append: one_star | split: ',' -%}
          {%- for star in star_rows -%}
            {%- assign idx = forloop.index0 -%}
            <button class="cr-bar-row" data-filter-star="{{ star }}" aria-label="Filter by {{ star }} stars" type="button">
              <span class="cr-bar-label">{{ star }}</span>
              <span class="cr-bar-star">★</span>
              <div class="cr-bar-track">
                <div class="cr-bar-fill" style="width: {{ pct_vals[idx] }}%;"></div>
              </div>
              <span class="cr-bar-count">({{ cnt_vals[idx] }})</span>
            </button>
          {%- endfor -%}
        </div>

        <!-- Write a review button -->
        <div class="cr-write-wrap">
          {%- if section.settings.review_link != blank -%}
            <a href="{{ section.settings.review_link }}" class="cr-write-btn" target="_blank" rel="noopener">Write a Review</a>
          {%- else -%}
            <button class="cr-write-btn" type="button" onclick="const jmBtn = document.querySelector('.jdgm-write-rev-link'); if (jmBtn) { jmBtn.click(); } else { alert('Please enable the Judge.me widget on this page first to write a review!'); }">Write a Review</button>
          {%- endif -%}
        </div>
      </div>

      <!-- Active filter indicator -->
      <div class="cr-filter-status" id="cr-filter-status-{{ section.id }}" style="display:none;">
        Showing <strong id="cr-filter-label-{{ section.id }}"></strong> star reviews
        <button class="cr-clear-filter" data-clear-filter type="button">× Clear</button>
      </div>
    </div>

    <!-- Review Cards -->
    <div class="cr-grid" id="cr-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="review-card animate-on-scroll" data-rating="{{ block.settings.rating }}" {{ block.shopify_attributes }}>

          {%- assign has_images = false -%}
          {%- if block.settings.image != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.image_4 != blank or block.settings.fallback_image_url != blank -%}
            {%- assign has_images = true -%}
          {%- endif -%}

          {%- if has_images -%}
            <div class="review-card__images-wrap">
              <div class="review-card__images-scroller">
                {%- if block.settings.image != blank -%}
                  <div class="review-card__img-item"><img src="{{ block.settings.image | image_url: width: 500 }}" alt="Review photo 1" loading="lazy"></div>
                {%- elsif block.settings.fallback_image_url != blank -%}
                  <div class="review-card__img-item"><img src="{{ block.settings.fallback_image_url }}" alt="Review photo 1" loading="lazy"></div>
                {%- endif -%}
                {%- if block.settings.image_2 != blank -%}
                  <div class="review-card__img-item"><img src="{{ block.settings.image_2 | image_url: width: 500 }}" alt="Review photo 2" loading="lazy"></div>
                {%- endif -%}
                {%- if block.settings.image_3 != blank -%}
                  <div class="review-card__img-item"><img src="{{ block.settings.image_3 | image_url: width: 500 }}" alt="Review photo 3" loading="lazy"></div>
                {%- endif -%}
                {%- if block.settings.image_4 != blank -%}
                  <div class="review-card__img-item"><img src="{{ block.settings.image_4 | image_url: width: 500 }}" alt="Review photo 4" loading="lazy"></div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div class="review-card__body">
            <div class="review-card__stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <span class="star star--filled">★</span>
                {%- else -%}
                  <span class="star star--empty">☆</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            
            <div class="review-card__text-wrap">
              <p class="review-card__text">{{ block.settings.text }}</p>
              <button class="review-card__read-more" type="button" onclick="this.previousElementSibling.classList.toggle('is-expanded'); this.textContent = this.textContent === 'Read more' ? 'Read less' : 'Read more';">Read more</button>
            </div>

            <div class="review-card__author-row">
              <div class="review-card__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</div>
              <div class="review-card__meta">
                <strong class="review-card__author-name">{{ block.settings.author }}</strong>
                <span class="review-card__verified">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#4CAF50"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  Verified
                </span>
              </div>
              <time class="review-card__date">{{ block.settings.date }}</time>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

    <!-- Empty state when filter has no results -->
    <p class="cr-no-results" id="cr-no-results-{{ section.id }}" style="display:none;">No reviews found for this rating.</p>

    <!-- Write a Review Modal -->
    <dialog id="cr-modal-{{ section.id }}" class="cr-modal">
      <div class="cr-modal-content">
        <div class="cr-modal-header">
          <h3>Write a Review</h3>
          <button class="cr-modal-close" type="button" aria-label="Close" onclick="document.getElementById('cr-modal-{{ section.id }}').close()">&times;</button>
        </div>
        <div class="cr-modal-body">
          <p class="cr-modal-sub">Please share your experience with us! We will review it and add it to our site.</p>
          {%- form 'contact', id: 'ReviewForm' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus style="color: green; margin-bottom: 15px;">
                Thanks for your review! It has been submitted for approval.
              </div>
            {%- endif -%}
            <div class="cr-field">
              <label for="ReviewName">Name</label>
              <input type="text" id="ReviewName" name="contact[Name]" required>
            </div>
            <div class="cr-field">
              <label for="ReviewEmail">Email</label>
              <input type="email" id="ReviewEmail" name="contact[email]" required>
            </div>
            <div class="cr-field">
              <label for="ReviewRating">Rating</label>
              <select id="ReviewRating" name="contact[Rating]" required>
                <option value="5">★★★★★ (5/5)</option>
                <option value="4">★★★★☆ (4/5)</option>
                <option value="3">★★★☆☆ (3/5)</option>
                <option value="2">★★☆☆☆ (2/5)</option>
                <option value="1">★☆☆☆☆ (1/5)</option>
              </select>
            </div>
            <div class="cr-field">
              <label for="ReviewBody">Review</label>
              <textarea id="ReviewBody" name="contact[Review]" rows="4" required></textarea>
            </div>
            <div class="cr-field cr-modal-actions">
              <button type="submit" class="cr-write-btn">Submit Review</button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </dialog>

  </div>
</section>

<style>
/* ---- Section wrapper ---- */
.customer-reviews { padding: var(--spacing-xl, 64px) 0; }

/* ---- Header ---- */
.cr-header { margin-bottom: var(--spacing-lg, 40px); }
.cr-heading {
  font-family: var(--font-heading-family);
  font-size: clamp(1.4rem, 3vw, 2rem);
  color: var(--color-heading);
  margin: 0 0 var(--spacing-md, 24px);
}

/* ---- Summary row ---- */
.cr-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: var(--spacing-md, 24px);
}

/* Score box */
.cr-score-box {
  width: 68px;
  height: 68px;
  background: var(--color-primary, #C69A7C);
  border-radius: var(--radius-lg, 16px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cr-score-number {
  font-family: var(--font-heading-family);
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

/* Stars + count */
.cr-score-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
  flex-shrink: 0;
}
.cr-stars {
  font-size: 1.35rem;
  color: #F5A623;
  letter-spacing: 2px;
}
.cr-count {
  font-size: 0.82rem;
  color: var(--color-text);
  opacity: 0.65;
  margin: 0;
  white-space: nowrap;
}

/* Bar chart */
.cr-bars {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
  min-width: 180px;
  max-width: 320px;
}
.cr-bar-row {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  padding: 3px 6px;
  border-radius: var(--radius-md, 8px);
  cursor: pointer;
  transition: background-color 0.2s;
  text-align: left;
  width: 100%;
}
.cr-bar-row:hover,
.cr-bar-row.is-active {
  background: var(--color-skin-pale, #FBF0E8);
}
.cr-bar-label {
  font-size: 0.8rem;
  color: var(--color-text);
  width: 10px;
  text-align: right;
  flex-shrink: 0;
}
.cr-bar-star {
  color: #F5A623;
  font-size: 0.78rem;
  flex-shrink: 0;
}
.cr-bar-track {
  flex: 1;
  height: 8px;
  background: var(--color-skin-light, #F5DEC8);
  border-radius: var(--radius-pill, 50px);
  overflow: hidden;
}
.cr-bar-fill {
  height: 100%;
  background: var(--color-primary, #C69A7C);
  border-radius: var(--radius-pill, 50px);
  transition: width 0.4s ease;
}
.cr-bar-row.is-active .cr-bar-fill {
  background: var(--color-primary-dark, #A07855);
}
.cr-bar-count {
  font-size: 0.78rem;
  color: var(--color-text);
  opacity: 0.6;
  min-width: 28px;
  flex-shrink: 0;
}

/* Write a review button */
.cr-write-wrap {
  display: flex;
  align-items: flex-start;
  margin-left: auto;
  flex-shrink: 0;
}
.cr-write-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  background: var(--color-heading, #111111);
  color: #fff;
  font-family: var(--font-heading-family);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 2px solid var(--color-heading, #111111);
  border-radius: var(--radius-md, 8px);
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 0.2s, color 0.2s;
}
.cr-write-btn:hover {
  background: transparent;
  color: var(--color-heading, #111111);
}

/* Filter status pill */
.cr-filter-status {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: var(--spacing-sm, 16px);
  font-size: 0.85rem;
  color: var(--color-text);
  background: var(--color-skin-pale, #FBF0E8);
  border-radius: var(--radius-pill, 50px);
  padding: 6px 16px;
  width: fit-content;
}
.cr-clear-filter {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-primary, #C69A7C);
  font-size: 1rem;
  padding: 0;
  line-height: 1;
}

/* ---- Review Grid ---- */
.cr-grid {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 16px;
  gap: var(--spacing-md, 24px);
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
}
.cr-grid::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}
.cr-grid > .review-card {
  scroll-snap-align: center;
  flex: 0 0 85%;
}

@media screen and (min-width: 640px) {
  .cr-grid { 
    display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    overflow-x: visible;
  }
  .cr-grid > .review-card { flex: auto; }
}
@media screen and (min-width: 1024px) {
  .cr-grid { grid-template-columns: repeat(3, 1fr); }
}
@media screen and (min-width: 1280px) {
  .cr-grid { grid-template-columns: repeat(4, 1fr); }
}

.cr-no-results {
  text-align: center;
  padding: var(--spacing-lg, 40px);
  color: var(--color-text);
  opacity: 0.6;
  font-size: 0.95rem;
}

/* ---- Review Card (keep existing styles) ---- */
.review-card {
  background: var(--color-white, #fff);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.3s, transform 0.3s;
}
.review-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-skin);
}
.review-card__images-wrap { width: 100%; border-bottom: 1px solid var(--color-border, #E8D5C4); }
.review-card__images-scroller { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.review-card__images-scroller::-webkit-scrollbar { display: none; }
.review-card__img-item { flex: 0 0 100%; scroll-snap-align: center; height: 220px; background: var(--color-skin-light); display: flex; align-items: center; justify-content: center; }
.review-card__img-item img { width: 100%; height: 100%; object-fit: contain; }
.review-card__body { padding: 20px; display: flex; flex-direction: column; flex: 1; gap: 12px; }
.review-card__stars { display: flex; gap: 2px; }
.star--filled { color: #F5A623; font-size: 1rem; }
.star--empty  { color: #E0D5C8; font-size: 1rem; }

.review-card__text-wrap { display: flex; flex-direction: column; align-items: flex-start; flex: 1; min-height: 0; }
.review-card__text { font-size: 0.9rem; line-height: 1.65; color: var(--color-text); margin: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; transition: all 0.3s ease; }
.review-card__text.is-expanded { -webkit-line-clamp: unset; }
.review-card__read-more { background: none; border: none; color: var(--color-primary); font-weight: 600; font-size: 0.85rem; padding: 0; margin-top: 8px; cursor: pointer; display: none; }
.review-card__author-row { display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--color-border, #E8D5C4); }
.review-card__avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--color-secondary, #E0B898), var(--color-primary, #C69A7C)); color: #fff; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.review-card__meta { flex: 1; min-width: 0; }
.review-card__author-name { display: block; font-size: 0.85rem; color: var(--color-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.review-card__verified { display: inline-flex; align-items: center; gap: 3px; font-size: 0.72rem; color: #4CAF50; font-weight: 500; }
.review-card__date { font-size: 0.72rem; color: var(--color-text); opacity: 0.45; white-space: nowrap; flex-shrink: 0; }

/* Hidden card when filtered */
.review-card[hidden] { display: none !important; }

/* Modal Styles */
.cr-modal { border: none; border-radius: var(--radius-xl, 24px); padding: 0; max-width: 500px; width: 90%; box-shadow: var(--shadow-xl, 0 10px 40px rgba(0,0,0,0.2)); background: #fff; margin: auto; }
.cr-modal::backdrop { background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); }
.cr-modal-content { display: flex; flex-direction: column; }
.cr-modal-header { padding: 20px 24px; border-bottom: 1px solid var(--color-border, #eee); display: flex; justify-content: space-between; align-items: center; }
.cr-modal-header h3 { margin: 0; font-family: var(--font-heading-family); font-size: 1.4rem; color: var(--color-heading); }
.cr-modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0; color: #999; transition: color 0.2s; }
.cr-modal-close:hover { color: #111; }
.cr-modal-body { padding: 24px; }
.cr-modal-sub { margin-top: 0; margin-bottom: 20px; font-size: 0.9rem; color: var(--color-text); opacity: 0.8; }
.cr-field { margin-bottom: 16px; display: flex; flex-direction: column; gap: 6px; }
.cr-field label { font-size: 0.85rem; font-weight: 600; color: var(--color-heading); }
.cr-field input, .cr-field select, .cr-field textarea { width: 100%; padding: 12px; border: 1px solid var(--color-border, #ddd); border-radius: var(--radius-md, 8px); font-family: inherit; font-size: 1rem; }
.cr-field input:focus, .cr-field select:focus, .cr-field textarea:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(198,154,124,0.2); }
.cr-modal-actions { margin-top: 24px; margin-bottom: 0; }
.cr-modal-actions .cr-write-btn { width: 100%; font-size: 1rem; }
</style>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var grid = document.getElementById('cr-grid-' + sectionId);
  var filterStatus = document.getElementById('cr-filter-status-' + sectionId);
  var filterLabel = document.getElementById('cr-filter-label-' + sectionId);
  var noResults = document.getElementById('cr-no-results-' + sectionId);
  var activeStar = null;

  function applyFilter(star) {
    activeStar = star;
    var cards = grid.querySelectorAll('.review-card');
    var visible = 0;
    cards.forEach(function(card) {
      if (!star || card.dataset.rating === String(star)) {
        card.removeAttribute('hidden');
        visible++;
      } else {
        card.setAttribute('hidden', '');
      }
    });
    // Update bar row active state
    document.querySelectorAll('[data-filter-star]').forEach(function(btn) {
      btn.classList.toggle('is-active', btn.dataset.filterStar === String(star));
    });
    // Filter status
    if (star) {
      filterStatus.style.display = 'flex';
      filterLabel.textContent = star;
    } else {
      filterStatus.style.display = 'none';
    }
    noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  // Bar click
  document.querySelectorAll('[data-filter-star]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var star = btn.dataset.filterStar;
      if (activeStar === star) {
        applyFilter(null); // toggle off
      } else {
        applyFilter(star);
      }
    });
  });

  // Clear filter
  document.querySelectorAll('[data-clear-filter]').forEach(function(btn) {
    btn.addEventListener('click', function() { applyFilter(null); });
  });

  // Read more toggle logic
  function checkReadMore() {
    var textElements = document.querySelectorAll('.review-card__text');
    textElements.forEach(function(el) {
      if (el.scrollHeight > el.clientHeight) {
        // Needs a read more button
        var btn = el.nextElementSibling;
        if (btn && btn.classList.contains('review-card__read-more')) {
          btn.style.display = 'block';
        }
      }
    });
  }
  // Wait for fonts to load then check
  if (document.readyState === 'complete') {
    checkReadMore();
  } else {
    window.addEventListener('load', checkReadMore);
  }
})();
</script>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Customer reviews"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Write a Review link (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Happy Parent"
        },
        {
