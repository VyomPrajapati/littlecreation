          "label": "Star rating"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Great product!"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "April 2026"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Review photo (optional)"
        },
        {
          "type": "url",
          "id": "fallback_image_url",
          "label": "External image URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Grid",
      "blocks": [
        { "type": "review", "settings": { "author": "Kindle Customer", "rating": 5, "text": "Grandson loved it easy to hold and shake and made him laugh", "date": "April 2026" } },
        { "type": "review", "settings": { "author": "Ebiere", "rating": 5, "text": "I got this teeth rattle my little one, good quality with grip and teething aid.", "date": "April 2026" } },
        { "type": "review", "settings": { "author": "Kiera", "rating": 4, "text": "Smaller than expected and rattle isn't very loud, great teether toy though", "date": "April 2026" } },
        { "type": "review", "settings": { "author": "Daniel Boden", "rating": 5, "text": "I absolutely love this Little Creation Teether. It's a sweet, understated toy with a really lovely, soft colour palette that feels modern and calming.", "date": "February 2026" } },
        { "type": "review", "settings": { "author": "EllieBelle", "rating": 5, "text": "I ordered the dusky pink lion rattle as a present for my nephew's baby. It has a cute little face and comes in a little presentation box. Perfect to gift!", "date": "February 2026" } },
