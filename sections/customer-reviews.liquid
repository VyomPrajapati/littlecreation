<section class="customer-reviews section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    <!-- Header -->
    <div class="customer-reviews__header text-center mb-xl animate-on-scroll">
      <span class="section-label">{{ section.settings.label | default: 'Real parents, real stories' }}</span>
      <h2 class="mt-sm mb-lg">{{ section.settings.heading }}</h2>

      <!-- Rating summary -->
      <div class="reviews-summary">
        <div class="reviews-summary__score">
          <span class="reviews-summary__number">{{ section.settings.aggregate_score }}</span>
          <div class="reviews-summary__stars">
            <span>★★★★★</span>
          </div>
          <p class="reviews-summary__count">Based on {{ section.blocks.size }} verified reviews</p>
        </div>

        <div class="reviews-summary__bars">
          <div class="bar-row"><span class="bar-label">5</span><span class="bar-star">★</span><div class="bar-track"><div class="bar-fill" style="width: {{ section.settings.five_star_pct }}%;"></div></div><span class="bar-count">{{ section.settings.five_star_count }}</span></div>
          <div class="bar-row"><span class="bar-label">4</span><span class="bar-star">★</span><div class="bar-track"><div class="bar-fill" style="width: {{ section.settings.four_star_pct }}%;"></div></div><span class="bar-count">{{ section.settings.four_star_count }}</span></div>
          <div class="bar-row"><span class="bar-label">3</span><span class="bar-star">★</span><div class="bar-track"><div class="bar-fill" style="width: {{ section.settings.three_star_pct }}%;"></div></div><span class="bar-count">{{ section.settings.three_star_count }}</span></div>
          <div class="bar-row"><span class="bar-label">2</span><span class="bar-star">★</span><div class="bar-track"><div class="bar-fill" style="width: {{ section.settings.two_star_pct }}%;"></div></div><span class="bar-count">{{ section.settings.two_star_count }}</span></div>
          <div class="bar-row"><span class="bar-label">1</span><span class="bar-star">★</span><div class="bar-track"><div class="bar-fill" style="width: {{ section.settings.one_star_pct }}%;"></div></div><span class="bar-count">{{ section.settings.one_star_count }}</span></div>
        </div>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <div class="review-card animate-on-scroll delay-{{ forloop.index | modulo: 4 | plus: 1 }}" {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank or block.settings.fallback_image_url != blank -%}
            <div class="review-card__image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="Review image from {{ block.settings.author }}" loading="lazy">
              {%- elsif block.settings.fallback_image_url != blank -%}
                <img src="{{ block.settings.fallback_image_url }}" alt="Review image from {{ block.settings.author }}" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="review-card__body">
            <!-- Stars -->
            <div class="review-card__stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <span class="star star--filled">★</span>
                {%- else -%}
                  <span class="star star--empty">☆</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <!-- Quote -->
            <p class="review-card__text">{{ block.settings.text }}</p>

            <!-- Author row -->
            <div class="review-card__author-row">
              <div class="review-card__avatar" aria-hidden="true">
                {{ block.settings.author | slice: 0 | upcase }}
              </div>
              <div class="review-card__meta">
                <strong class="review-card__author-name">{{ block.settings.author }}</strong>
                <span class="review-card__verified">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#4CAF50"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  Verified
                </span>
              </div>
              <time class="review-card__date">{{ block.settings.date }}</time>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
/* ---- Rating Summary ---- */
.reviews-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-lg);
  max-width: 720px;
  margin: 0 auto;
}
@media screen and (min-width: 640px) {
  .reviews-summary {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
  }
}

.reviews-summary__score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.reviews-summary__number {
  font-family: var(--font-heading-family);
  font-size: 3.5rem;
  line-height: 1;
  color: var(--color-heading);
}
.reviews-summary__stars {
  font-size: 1.4rem;
  color: #F5A623;
  letter-spacing: 2px;
}
.reviews-summary__count {
  font-size: 0.8rem;
  color: var(--color-text);
  opacity: 0.6;
  margin: 0;
  white-space: nowrap;
}

.reviews-summary__bars {
  flex: 1;
  max-width: 280px;
  width: 100%;
}
.bar-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
  font-size: 0.78rem;
}
.bar-label { width: 10px; text-align: right; color: var(--color-text); opacity: 0.7; }
.bar-star { color: #F5A623; font-size: 0.7rem; }
.bar-track {
  flex: 1;
  height: 7px;
  background: var(--color-skin-light);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-pill);
}
.bar-count { color: var(--color-text); opacity: 0.6; min-width: 20px; }

/* ---- Review Grid ---- */
.reviews-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-md);
}
@media screen and (min-width: 640px) {
  .reviews-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media screen and (min-width: 1024px) {
  .reviews-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media screen and (min-width: 1280px) {
  .reviews-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

/* ---- Review Card ---- */
.review-card {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: box-shadow var(--transition-base), transform var(--transition-base);
}
.review-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-skin);
}

.review-card__image {
  overflow: hidden;
  max-height: 200px;
}
.review-card__image img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-slow);
}
.review-card:hover .review-card__image img { transform: scale(1.04); }

.review-card__body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 12px;
}

.review-card__stars {
  display: flex;
  gap: 2px;
}
.star--filled { color: #F5A623; font-size: 1rem; }
.star--empty  { color: #E0D5C8; font-size: 1rem; }

.review-card__text {
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-text);
  flex: 1;
  margin: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
}

.review-card__author-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
}
.review-card__avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
  color: var(--color-white);
  font-weight: 700;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.review-card__meta {
  flex: 1;
  min-width: 0;
}
.review-card__author-name {
  display: block;
  font-size: 0.85rem;
  color: var(--color-heading);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.review-card__verified {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 0.72rem;
  color: #4CAF50;
  font-weight: 500;
}
.review-card__date {
  font-size: 0.72rem;
  color: var(--color-text);
  opacity: 0.45;
  white-space: nowrap;
  flex-shrink: 0;
}
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "label",
