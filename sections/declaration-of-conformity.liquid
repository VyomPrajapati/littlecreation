<section class="declaration-section section-padding" style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};">
  <div class="container">
    <div class="declaration__inner">

      <header class="declaration__header text-center animate-on-scroll">
        {% if section.settings.heading != blank %}
          <h2 class="declaration__title">{{ section.settings.heading }}</h2>
        {% else %}
          <h2 class="declaration__title">Declaration of Conformity</h2>
        {% endif %}
        
        {% if section.settings.subtext != blank %}
          <p class="declaration__subtext">{{ section.settings.subtext }}</p>
        {% else %}
          <p class="declaration__subtext">Official UKCA and EN71 Toy Safety Regulation compliance certificates for Little Creation products.</p>
        {% endif %}
        <div class="declaration__divider"></div>
      </header>

      <div class="declaration__pdf-grid">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <a href="{{ block.settings.pdf_url | default: '#' }}" 
               class="pdf-item-card animate-on-scroll" 
               {% if block.settings.pdf_url != blank %}target="_blank" rel="noopener"{% endif %} 
               {{ block.shopify_attributes }}>
              <div class="pdf-item-card__icon-wrap">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div class="pdf-item-card__info">
                <h4 class="pdf-item-card__title">{{ block.settings.title | default: 'Product Safety Certificate' }}</h4>
                {% if block.settings.subtitle != blank %}
                  <span class="pdf-item-card__subtitle">{{ block.settings.subtitle }}</span>
                {% endif %}
              </div>
              <div class="pdf-item-card__action">
                <span>{{ block.settings.button_text | default: 'View PDF' }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </div>
            </a>
          {% endfor %}
        {% else %}
          <!-- Default Example Cards (Clickable Placeholders) -->
          <div class="pdf-item-card">
            <div class="pdf-item-card__icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="pdf-item-card__info">
              <h4 class="pdf-item-card__title">Lion Rattle Teether Declaration</h4>
              <span class="pdf-item-card__subtitle">EN71-1, 2, 3 & UKCA Certified</span>
            </div>
            <div class="pdf-item-card__action">
              <span>PDF File (Upload in Customizer)</span>
            </div>
          </div>
          <div class="pdf-item-card">
            <div class="pdf-item-card__icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="pdf-item-card__info">
              <h4 class="pdf-item-card__title">Cooling Teether Declaration</h4>
              <span class="pdf-item-card__subtitle">EN71-1, 2, 3 & UKCA Certified</span>
            </div>
            <div class="pdf-item-card__action">
              <span>PDF File (Upload in Customizer)</span>
            </div>
          </div>
          <div class="pdf-item-card">
            <div class="pdf-item-card__icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="pdf-item-card__info">
              <h4 class="pdf-item-card__title">Swan Wooden Ring Teether Declaration</h4>
              <span class="pdf-item-card__subtitle">EN71-1, 2, 3 & UKCA Certified</span>
            </div>
            <div class="pdf-item-card__action">
              <span>PDF File (Upload in Customizer)</span>
            </div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
.declaration__inner {
  max-width: 800px;
  margin: 0 auto;
}
.declaration__header {
  margin-bottom: var(--spacing-xl, 40px);
}
.declaration__title {
  font-family: var(--font-heading-family);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  color: var(--color-heading, #111111);
  margin: 0 0 12px 0;
}
.declaration__subtext {
  font-size: 1rem;
  color: var(--color-text);
  opacity: 0.85;
  margin: 0 0 16px 0;
}
.declaration__divider {
  width: 60px;
  height: 3px;
  background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-pill);
  margin: 0 auto;
}

.declaration__pdf-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.pdf-item-card {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--color-white, #FFFFFF);
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 20px);
  padding: 18px 24px;
  text-decoration: none !important;
  box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.04));
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
.pdf-item-card:hover {
  transform: translateY(-2px);
  border-color: var(--color-primary, #C69A7C);
  box-shadow: var(--shadow-md, 0 6px 20px rgba(0,0,0,0.08));
}
.pdf-item-card__icon-wrap {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--color-skin-pale, #FBF0E8);
  color: var(--color-primary-dark, #A07855);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pdf-item-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.pdf-item-card__title {
  font-family: var(--font-heading-family);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-heading, #111111);
  margin: 0 0 2px 0;
  line-height: 1.3;
}
.pdf-item-card__subtitle {
  font-size: 0.8rem;
  color: var(--color-primary-dark, #A07855);
  font-weight: 600;
}
.pdf-item-card__action {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-white, #FFFFFF);
  background: var(--color-primary, #C69A7C);
  padding: 10px 18px;
  border-radius: var(--radius-pill, 999px);
  transition: background 0.2s ease;
}
.pdf-item-card:hover .pdf-item-card__action {
  background: var(--color-primary-dark, #A07855);
}
@media screen and (max-width: 600px) {
  .pdf-item-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .pdf-item-card__action {
    width: 100%;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Declaration of Conformity",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Declaration of Conformity" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Official UKCA and EN71 Toy Safety Regulation compliance certificates for Little Creation products." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "pdf_document",
      "name": "PDF Document",
      "settings": [
        { "type": "text", "id": "title", "label": "Document Title", "default": "Safety Certificate" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "EN71-1, 2, 3 & UKCA Certified" },
        { "type": "url", "id": "pdf_url", "label": "Select PDF File / Enter PDF Link" },
        { "type": "text", "id": "button_text", "label": "Button Label", "default": "Download PDF" }
      ]
    }
  ]
}
{% endschema %}
