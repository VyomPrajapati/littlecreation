<section class="features-grid section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="features-grid__header text-center mb-lg">
        {%- if section.settings.subtitle != blank -%}
          <span class="section-label animate-on-scroll">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        <h2 class="animate-on-scroll delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="features-grid__wrapper">
      {%- for block in section.blocks -%}
        <div class="features-grid__item animate-on-scroll delay-{{ forloop.index }}" {{ block.shopify_attributes }}>

          <div class="features-grid__icon-wrap">
            <div class="features-grid__icon">
              {%- if block.settings.icon_name == 'senses' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18M18.364 5.636l-12.728 12.728M5.636 5.636l12.728 12.728"/></svg>
              {%- elsif block.settings.icon_name == 'gums' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              {%- elsif block.settings.icon_name == 'motor' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-4 0v4M14 11V4a2 2 0 0 0-4 0v6M10 10V5a2 2 0 0 0-4 0v7M6 12v-1a2 2 0 0 0-4 0v5a6 6 0 0 0 6 6h4a8 8 0 0 0 6-2.69l2-2.31V14a3 3 0 0 0-3-3h-1"/></svg>
              {%- elsif block.settings.icon_name == 'grows' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-9M12 13C8 13 4 10.5 4 6c4 0 8 2.5 8 7zM12 13c4 0 8-2.5 8-7-4 0-8 2.5-8 7z"/></svg>
              {%- elsif block.settings.icon_name == 'safe' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endif -%}
            </div>
          </div>

          <h3 class="features-grid__title">{{ block.settings.title }}</h3>
          <p class="features-grid__text">{{ block.settings.text }}</p>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
/* ---- Wrapper ---- */
.features-grid__header { max-width: 640px; margin-left: auto; margin-right: auto; }

.features-grid__wrapper {
  display: flex;
  gap: var(--spacing-md);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  margin: 0 calc(var(--spacing-md) * -1);
  padding: 0 var(--spacing-md) var(--spacing-xs);
  scroll-padding: 0 var(--spacing-md);
  scrollbar-width: none;
}
.features-grid__wrapper::-webkit-scrollbar { display: none; }

.features-grid__item {
  scroll-snap-align: center;
  flex: 0 0 calc(100% - (var(--spacing-md) * 2));
  min-width: calc(100% - (var(--spacing-md) * 2));
  margin: 0 auto;
}

@media screen and (min-width: 600px) {
  .features-grid__wrapper {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow-x: visible;
    margin: 0;
    padding: 0;
  }
  .features-grid__item {
    flex: unset;
    min-width: unset;
  }
}
@media screen and (min-width: 1024px) {
  .features-grid__wrapper { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--spacing-lg); }
}

/* ---- Card ---- */
.features-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--spacing-md);
  transition: box-shadow var(--transition-base), transform var(--transition-base), border-color var(--transition-base);
  box-shadow: var(--shadow-sm);
}
@media (hover: hover) {
  .features-grid__item:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-skin);
    border-color: var(--color-primary);
  }
}

/* ---- Icon ---- */
.features-grid__icon-wrap {
  margin-bottom: var(--spacing-md);
}
.features-grid__icon {
  width: 72px;
  height: 72px;
  background: linear-gradient(135deg, var(--color-skin-light), var(--color-secondary));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-dark, #A07855);
  transition: transform var(--transition-base);
  box-shadow: 0 4px 16px rgba(198, 154, 124, 0.20);
}
@media (hover: hover) {
  .features-grid__item:hover .features-grid__icon {
    transform: scale(1.08) rotate(5deg);
  }
}
.features-grid__icon svg {
  width: 34px;
  height: 34px;
}

/* ---- Text ---- */
.features-grid__title {
  font-size: 1.05rem;
  margin-bottom: 10px;
  font-weight: 600;
  color: var(--color-heading);
  font-family: var(--font-body-family);
}
.features-grid__text {
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-text);
  opacity: 0.85;
  margin: 0;
}
</style>

{% schema %}
{
  "name": "Features Grid",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Label above heading",
      "default": "Why parents choose us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why parents choose Little Creation"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FBF0E8"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            { "value": "senses", "label": "Sparkle (Senses)" },
            { "value": "gums", "label": "Smile (Gums)" },
            { "value": "motor", "label": "Hand (Motor Skills)" },
            { "value": "grows", "label": "Sprout (Grows)" },
            { "value": "safe", "label": "Shield (Safe)" },
            { "value": "star", "label": "Star" }
          ],
          "default": "senses"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Stimulates senses"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Sight, sound, and touch all at once. The gentle rattle sparks natural curiosity from 3 months."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Grid",
      "blocks": [
        { "type": "feature", "settings": { "icon_name": "senses", "title": "Stimulates senses", "text": "Sight, sound, and touch all at once. The gentle rattle sparks natural curiosity from 3 months." } },
        { "type": "feature", "settings": { "icon_name": "gums", "title": "Soothes every gum", "text": "Multi-texture ridges reach front, back, and side gums where ordinary teethers can't." } },
        { "type": "feature", "settings": { "icon_name": "motor", "title": "Builds motor skills", "text": "Ergonomic grip sized for tiny hands encourages grasping and transferring milestones." } },
        { "type": "feature", "settings": { "icon_name": "grows", "title": "Grows with baby", "text": "Useful from 3 to 18 months. Long after teething passes, the rattle keeps developing." } }
      ]
    }
  ]
}
{% endschema %}
