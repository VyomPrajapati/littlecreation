<section class="faq-accordion section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="faq-accordion__inner">

      {%- if section.settings.heading != blank -%}
        <div class="faq-accordion__header text-center mb-lg animate-on-scroll">
          {%- if section.settings.label != blank -%}
            <span class="section-label">{{ section.settings.label }}</span>
          {%- endif -%}
          <h2 class="mt-sm">{{ section.settings.heading }}</h2>
          {%- if section.settings.subtext != blank -%}
            <p class="faq-accordion__subtext">{{ section.settings.subtext }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="faq-accordion__list">
        {%- for block in section.blocks -%}
          <details class="faq-accordion__item animate-on-scroll delay-{{ forloop.index | modulo: 4 | plus: 1 }}" {{ block.shopify_attributes }}>
            <summary class="faq-accordion__summary">
              <span class="faq-accordion__question">{{ block.settings.question }}</span>
              <span class="faq-accordion__icon" aria-hidden="true">
                <svg class="icon-plus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                <svg class="icon-minus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"/></svg>
              </span>
            </summary>
            <div class="faq-accordion__answer">
              <div class="faq-accordion__answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<style>
.faq-accordion__inner {
  max-width: 760px;
  margin: 0 auto;
}
.faq-accordion__header { max-width: 600px; margin-left: auto; margin-right: auto; }
.faq-accordion__subtext {
  font-size: 1rem;
  color: var(--color-text);
  opacity: 0.75;
  margin-top: var(--spacing-sm);
  margin-bottom: 0;
}

/* ---- List ---- */
.faq-accordion__list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* ---- Item ---- */
.faq-accordion__item {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border-left: 4px solid transparent;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}
.faq-accordion__item[open] {
  border-left-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}
.faq-accordion__item:hover {
  box-shadow: var(--shadow-md);
}

/* ---- Summary ---- */
.faq-accordion__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: background-color var(--transition-fast);
}
.faq-accordion__summary::-webkit-details-marker { display: none; }
.faq-accordion__summary:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: -2px;
  border-radius: var(--radius-lg);
}

.faq-accordion__question {
  font-family: var(--font-body-family);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-heading);
  line-height: 1.5;
  overflow-wrap: break-word;
}

.faq-accordion__icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-skin-pale);
  border-radius: 50%;
  color: var(--color-primary);
  transition: background-color var(--transition-fast), transform var(--transition-base);
}
.faq-accordion__item[open] .faq-accordion__icon {
  background: var(--color-primary);
  color: var(--color-white);
}

/* Toggle + / - icons */
.icon-plus  { display: block; }
.icon-minus { display: none; }
.faq-accordion__item[open] .icon-plus  { display: none; }
.faq-accordion__item[open] .icon-minus { display: block; }

/* ---- Answer ---- */
.faq-accordion__answer {
  animation: sweep 0.3s ease-out;
}
.faq-accordion__answer-inner {
  padding: 0 var(--spacing-md) var(--spacing-md);
  font-size: 0.95rem;
  line-height: 1.75;
  color: var(--color-text);
  opacity: 0.9;
  border-top: 1px solid var(--color-border);
  padding-top: var(--spacing-sm);
}
.faq-accordion__answer-inner p { margin-bottom: 0.5em; }
.faq-accordion__answer-inner p:last-child { margin-bottom: 0; }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label above heading",
      "default": "Got questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)",
      "default": "Everything you need to know about our teethers."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#F5DEC8"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What materials are your teethers made from?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our teethers are made from 100% food-grade silicone that is BPA-free, phthalate-free, and non-toxic. All products meet EU and UK safety standards.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "question", "settings": { "question": "What materials are your teethers made from?", "answer": "<p>Our teethers are made from 100% food-grade silicone that is BPA-free, phthalate-free, and non-toxic. All products meet EU and UK safety standards.</p>" } },
        { "type": "question", "settings": { "question": "From what age can my baby use these?", "answer": "<p>Our teethers are designed for babies from 3 months upwards. They are ergonomically shaped for tiny hands to grasp and explore safely.</p>" } },
        { "type": "question", "settings": { "question": "How do I clean the teether?", "answer": "<p>Simply wash with warm soapy water or place in the top rack of your dishwasher. Our silicone is heat-resistant and won't degrade with regular cleaning.</p>" } },
        { "type": "question", "settings": { "question": "What is your returns policy?", "answer": "<p>We offer a 30-day hassle-free returns policy. If you're not completely satisfied, contact us and we'll arrange a full refund or exchange.</p>" } }
      ]
    }
  ]
}
{% endschema %}
