<section class="hero-banner" style="background-color: {{ section.settings.bg_color }};">
  <div class="hero-banner__container">

    <!-- Text Column -->
    <div class="hero-banner__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="section-label animate-on-scroll">
          <span>✦</span>
          {{ section.settings.badge_text }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading animate-on-scroll delay-1">
          {{ section.settings.heading }}
          {%- if section.settings.accent_text != blank -%}
            <em class="hero-banner__accent">{{ section.settings.accent_text }}</em>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero-banner__text animate-on-scroll delay-2">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      <div class="hero-banner__actions animate-on-scroll delay-3">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank and section.settings.button_2_link != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="button button--outline">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Trust row -->
      <div class="hero-banner__trust animate-on-scroll delay-4">
        <span class="hero-banner__trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          BPA Free
        </span>
        <span class="hero-banner__trust-sep">·</span>
        <span class="hero-banner__trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          UK Designed
        </span>
        <span class="hero-banner__trust-sep">·</span>
        <span class="hero-banner__trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          30-Day Returns
        </span>
      </div>
    </div>

    <!-- Image Column -->
    <div class="hero-banner__image-col animate-on-scroll delay-2">
      <div class="hero-banner__image-blob"></div>
      <div class="hero-banner__image-frame">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
               width="{{ section.settings.image.width }}"
               height="{{ section.settings.image.height }}"
               loading="eager"
               class="hero-banner__image">
        {%- else -%}
          <div class="hero-banner__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
/* ---- Hero Shell ---- */
.hero-banner {
  overflow: hidden;
  position: relative;
  padding: var(--spacing-xl) 0;
}
@media screen and (max-width: 767px) {
  .hero-banner { padding: var(--spacing-lg) 0 var(--spacing-md); }
}

/* ---- Grid ---- */
.hero-banner__container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 var(--spacing-md);
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  align-items: center;
}
@media screen and (max-width: 767px) {
  .hero-banner__container { padding: 0 var(--spacing-sm); gap: var(--spacing-md); }
}
@media screen and (min-width: 768px) {
  .hero-banner__container {
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    min-height: 75vh;
  }
}
@media screen and (min-width: 1024px) {
  .hero-banner__container {
    grid-template-columns: 1.1fr 0.9fr;
  }
}

/* ---- Content ---- */
.hero-banner__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}
@media screen and (max-width: 767px) {
  .hero-banner__content { align-items: center; text-align: center; }
}

.hero-banner__heading {
  font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
  font-size: clamp(2.4rem, 5.5vw, 4.4rem);
  font-weight: 600 !important;
  line-height: 1.08;
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
  margin-top: var(--spacing-xs);
  max-width: 580px;
}
.hero-banner__accent {
  display: block;
  font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
  font-style: normal !important;
  color: var(--color-primary);
}
.hero-banner__text {
  font-size: 1.05rem;
  color: var(--color-text);
  line-height: 1.7;
  max-width: 460px;
  margin-bottom: var(--spacing-md);
  opacity: 0.9;
}

/* Buttons row */
.hero-banner__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
@media screen and (max-width: 767px) {
  .hero-banner__actions { justify-content: center; }
}

/* Trust row */
.hero-banner__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 0.78rem;
  color: var(--color-text);
  opacity: 0.75;
}
.hero-banner__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-weight: 500;
}
.hero-banner__trust-item svg { color: var(--color-primary); flex-shrink: 0; }
.hero-banner__trust-sep { opacity: 0.4; }
@media screen and (max-width: 767px) {
  .hero-banner__trust { justify-content: center; }
}

/* ---- Image Column ---- */
.hero-banner__image-col {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  order: -1;
}
@media screen and (min-width: 768px) {
  .hero-banner__image-col { order: 0; }
}

/* Decorative blob */
.hero-banner__image-blob {
  position: absolute;
  width: 88%;
  height: 88%;
  background: var(--color-skin-light);
  border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%;
  z-index: 0;
  top: 6%;
  left: 6%;
}

/* Image frame */
.hero-banner__image-frame {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 480px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  animation: float 7s ease-in-out infinite;
}
@media screen and (max-width: 767px) {
  .hero-banner__image-frame { max-width: 300px; border-radius: var(--radius-lg); }
}

.hero-banner__image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: inherit;
}

.hero-banner__placeholder {
  aspect-ratio: 4/5;
  background: var(--color-skin-light);
}
.hero-banner__placeholder svg {
  width: 100%;
  height: 100%;
  fill: rgba(0,0,0,0.06);
}
</style>

{% schema %}
{
  "name": "Asymmetrical Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label (above heading)",
      "default": "As Seen On Amazon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Safe, Soothing Teethers for"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Heading accent line (italic, skin colour)",
      "default": "Your Little One"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading text",
      "default": "<p>Discover our premium collection of non-toxic, beautifully designed teethers trusted by parents across the UK.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FBF0E8"
    }
  ],
  "presets": [
    {
      "name": "Asymmetrical Hero"
    }
  ]
}
{% endschema %}
