<section class="hero-banner" style="position: relative; overflow: hidden; {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2000 }}"
         alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
         loading="eager"
         class="hero-banner__bg-image">
  {%- endif -%}
  
  <div class="hero-banner__overlay"></div>

  <div class="hero-banner__container">
    <div class="hero-banner__content-box animate-on-scroll">
      {%- if section.settings.badge_text != blank -%}
        <span class="section-label" style="justify-content: flex-start;">
          <span>✦</span>
          {{ section.settings.badge_text }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading">
          {{ section.settings.heading }}
          {%- if section.settings.accent_text != blank -%}
            <em class="hero-banner__accent">{{ section.settings.accent_text }}</em>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero-banner__text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      <div class="hero-banner__actions">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank and section.settings.button_2_link != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="button button--outline" style="background: rgba(255,255,255,0.8);">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Trust row -->
      <div class="hero-banner__trust">
        <span class="hero-banner__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          BPA Free
        </span>
        <span class="hero-banner__trust-sep">·</span>
        <span class="hero-banner__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          UK Designed
        </span>
        <span class="hero-banner__trust-sep">·</span>
        <span class="hero-banner__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          30-Day Returns
        </span>
      </div>
    </div>
  </div>
</section>

<style>
/* ---- Hero Shell ---- */
.hero-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}
@media screen and (max-width: 767px) {
  .hero-banner { min-height: 70vh; padding: var(--spacing-xl) 0; }
}

.hero-banner__bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.hero-banner__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ---- Grid ---- */
.hero-banner__container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 var(--spacing-md);
  display: flex;
  justify-content: flex-start;
}

/* ---- Content ---- */
.hero-banner__content-box {
  padding: var(--spacing-xl) 0;
  max-width: 550px;
  text-align: left;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
@media screen and (max-width: 767px) {
  .hero-banner__content-box {
    padding: var(--spacing-lg) var(--spacing-md);
    margin: var(--spacing-md) 0;
    text-align: center;
    align-items: center;
  }
}

.hero-banner__heading {
  font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 500 !important;
  line-height: 1.2;
  color: {{ section.settings.text_color | default: 'var(--color-heading)' }};
  margin-bottom: var(--spacing-sm);
  margin-top: var(--spacing-xs);
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.4);
}
.hero-banner__accent {
  display: block;
  font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
  font-weight: 500 !important;
  font-style: normal !important;
  color: {{ section.settings.text_color | default: 'var(--color-text)' }};
  font-size: 0.85em;
  margin-top: 8px;
}
.hero-banner__text {
  font-size: 1.1rem;
  color: {{ section.settings.text_color | default: 'var(--color-text)' }};
  line-height: 1.6;
  margin-bottom: var(--spacing-md);
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.4);
}

/* Buttons row */
.hero-banner__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: var(--spacing-sm);
}
@media screen and (max-width: 767px) {
  .hero-banner__actions {
    justify-content: center;
  }
}

/* Trust row */
.hero-banner__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  font-size: 0.95rem;
  color: {{ section.settings.text_color | default: 'var(--color-text)' }};
  margin-top: var(--spacing-lg);
  opacity: 0.9;
}
.hero-banner__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 500;
}
.hero-banner__trust-item svg { 
  color: {{ section.settings.text_color | default: 'var(--color-text)' }}; 
  flex-shrink: 0; 
}
.hero-banner__trust-sep { opacity: 0.4; font-size: 1.2em; }
@media screen and (max-width: 767px) {
  .hero-banner__trust { justify-content: center; gap: 8px; font-size: 0.85rem; }
}
</style>

{% schema %}
{
  "name": "Full Width Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#5A4538"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label (above heading)",
      "default": "As Seen On Amazon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Safe, Soothing Teethers for"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Heading accent line (italic, skin colour)",
      "default": "Your Little One"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading text",
      "default": "<p>Discover our premium collection of non-toxic, beautifully designed teethers trusted by parents across the UK.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background fallback colour",
      "default": "#FBF0E8"
    }
  ],
  "presets": [
    {
      "name": "Full Width Hero"
    }
  ]
}
{% endschema %}
