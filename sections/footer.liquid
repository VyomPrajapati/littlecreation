<footer class="footer" style="background-color: {{ section.settings.bg_color | default: '#2C221E' }}; color: {{ section.settings.text_color | default: '#F5DEC8' }};">
  <div class="footer__inner container">

    <!-- Top section: blocks grid -->
    <div class="footer__blocks">
      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>

          {%- if block.settings.title != blank -%}
            <h3 class="footer__col-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- case block.type -%}

            {%- when 'brand' -%}
              <p class="footer__brand-text">{{ block.settings.text }}</p>
              <!-- Social icons -->
              <div class="footer__social">
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.24a8.16 8.16 0 004.77 1.52V7.31a4.85 4.85 0 01-1-.62z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                  </a>
                {%- endif -%}
              </div>

            {%- when 'link_list' -%}
              <ul class="footer__links">
                {%- if block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a href="{{ routes.all_products_collection_url }}" class="footer__link">Shop All</a></li>
                  <li><a href="/pages/our-story" class="footer__link">Our Story</a></li>
                  <li><a href="/pages/contact" class="footer__link">Contact Us</a></li>
                  <li><a href="/pages/shipping-returns" class="footer__link">Shipping & Returns</a></li>
                {%- endif -%}
              </ul>

            {%- when 'text' -%}
              <div class="footer__text-block">{{ block.settings.text }}</div>

            {%- when 'newsletter' -%}
              <p class="footer__newsletter-desc">{{ block.settings.text }}</p>
              {%- form 'customer', id: 'FooterNewsletter', class: 'footer__newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter, footer">
                <div class="footer__newsletter-field">
                  <input type="email"
                         name="contact[email]"
                         id="FooterEmail-{{ section.id }}"
                         class="footer__email-input"
                         placeholder="Enter your email address"
                         value="{{ form.email }}"
                         autocomplete="email"
                         autocorrect="off"
                         autocapitalize="off"
                         required
                         aria-label="Email address">
                  <button type="submit" class="footer__subscribe-btn" name="commit" id="FooterSubscribe">
                    Join
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="footer__success">Thanks for subscribing! 🎉</p>
                {%- endif -%}
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Bottom bar -->
    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <p class="footer__copyright">
          <span>&copy; {{ 'now' | date: '%Y' }} LITTLE CREATION. All rights reserved.</span>
          {%- if section.settings.developer_credit_text != blank -%}
            <span class="footer__compliance-sep" style="margin: 0 4px;">&bull;</span>
            <a
              href="{{ section.settings.developer_credit_link | default: '#' }}"
              class="footer__developer-credit-link"
              {% if section.settings.developer_credit_link != blank and section.settings.developer_credit_link contains '://' %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              {{ section.settings.developer_credit_text }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          {%- endif -%}
        </p>
        <div class="footer__compliance-links">
          <a href="/pages/product-safety-standards" class="footer__compliance-link">Product Safety Standards</a>
          <span class="footer__compliance-sep">&bull;</span>
          <a href="/pages/product-safety-standards#declaration-of-conformity" class="footer__compliance-link">Declaration of Conformity</a>
        </div>
      </div>

      {%- if section.settings.payment_enable -%}
        <ul class="footer__payment-list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="footer__payment-item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</footer>

<style>
/* ---- Footer Shell ---- */
.footer {
  background-color: var(--color-footer-bg, #2C221E);
  color: var(--color-footer-text, #F5DEC8);
  padding-top: var(--spacing-xxl, 100px);
  padding-bottom: 0;
  overflow: hidden;
}
.footer__inner {
  padding-bottom: 0;
}

/* ---- Blocks grid ---- */
.footer__blocks {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  padding-bottom: var(--spacing-xl);
  border-bottom: 1px solid rgba(245, 222, 200, 0.12);
}
@media screen and (min-width: 600px) {
  .footer__blocks { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media screen and (min-width: 1024px) {
  .footer__blocks { grid-template-columns: 1.5fr repeat(3, 1fr); }
}

/* ---- Column ---- */
.footer__col-title {
  font-family: var(--font-body-family);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-secondary, #E0B898);
  margin-bottom: var(--spacing-md);
  margin-top: 0;
}

/* ---- Brand block ---- */
.footer__brand-text {
  font-size: 0.92rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.8);
  margin-bottom: var(--spacing-md);
  max-width: 290px;
}

/* ---- Social icons ---- */
.footer__social {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.footer__social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%;
  color: #F5DEC8;
  text-decoration: none;
  transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}
.footer__social-link:hover {
  background: var(--color-primary, #C69A7C);
  border-color: var(--color-primary, #C69A7C);
  color: var(--color-white);
  text-decoration: none;
}

/* ---- Links ---- */
.footer__links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.footer__link {
  color: rgba(255,255,255,0.78);
  text-decoration: none;
  font-size: 0.92rem;
  transition: color var(--transition-fast), padding-left var(--transition-fast);
  display: inline-block;
}
.footer__link:hover {
  color: var(--color-secondary, #E0B898);
  padding-left: 4px;
  text-decoration: none;
}

/* ---- Text block ---- */
.footer__text-block {
  font-size: 0.9rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.8);
}

/* ---- Newsletter ---- */
.footer__newsletter-desc {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.75);
  margin-bottom: var(--spacing-md);
  line-height: 1.6;
}
.footer__newsletter-field {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.footer__email-input {
  flex: 1;
  min-width: 180px;
  padding: 13px 20px;
  background: #FFFFFF !important;
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-pill);
  color: #111111 !important;
  font-family: var(--font-body-family);
  font-size: 0.9rem;
  outline: none;
  appearance: none;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  box-shadow: none;
}
.footer__email-input::placeholder {
  color: #77665B !important;
  opacity: 1 !important;
}
.footer__email-input:focus {
  border-color: var(--color-primary, #C69A7C);
  box-shadow: 0 0 0 3px rgba(198, 154, 124, 0.25);
}
.footer__subscribe-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 13px 24px;
  background: var(--color-primary, #C69A7C);
  color: var(--color-white);
  border: none;
  border-radius: var(--radius-pill);
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: 0.88rem;
  cursor: pointer;
  transition: background-color var(--transition-fast), transform var(--transition-fast);
  box-shadow: var(--shadow-skin);
  white-space: nowrap;
}
.footer__subscribe-btn:hover {
  background: var(--color-primary-dark, #A07855);
  transform: translateY(-1px);
}
.footer__success {
  color: #7ED321;
  font-size: 0.85rem;
  margin-top: 10px;
  margin-bottom: 0;
}

/* ---- Bottom bar ---- */
.footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) 0;
  border-top: 1px solid rgba(245, 222, 200, 0.08);
}
.footer__bottom-left {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.footer__copyright {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.6);
  margin: 0;
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
}
.footer__developer-credit-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: #FFE6C9 !important;
  background: linear-gradient(135deg, rgba(198, 154, 124, 0.3), rgba(224, 184, 152, 0.18));
  border: 1px solid rgba(224, 184, 152, 0.45);
  padding: 2px 10px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 0.78rem;
  text-decoration: none !important;
  transition: all 0.25s ease;
  box-shadow: 0 0 10px rgba(198, 154, 124, 0.2);
  margin-left: 2px;
}
.footer__developer-credit-link:hover {
  color: #FFFFFF !important;
  background: linear-gradient(135deg, #C69A7C, #E0B898);
  border-color: #E0B898;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(198, 154, 124, 0.4);
  text-decoration: none !important;
}
.footer__developer-credit-link svg {
  transition: transform 0.2s ease;
}
.footer__developer-credit-link:hover svg {
  transform: translate(1px, -1px);
}
.footer__compliance-links {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.footer__compliance-link {
  font-size: 0.78rem;
  color: var(--color-secondary, #E0B898);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: opacity 0.2s ease;
}
.footer__compliance-link:hover {
  opacity: 0.8;
  color: #ffffff;
}
.footer__compliance-sep {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.4);
}
.footer__payment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 0;
  list-style: none;
  align-items: center;
}
.footer__payment-item {
  height: 22px;
  display: flex;
  align-items: center;
}
.footer__payment-item svg {
  height: 22px;
  width: auto;
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2C221E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5DEC8"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    },
    {
      "type": "header",
      "content": "Developer / Agency Credit"
    },
    {
      "type": "text",
      "id": "developer_credit_text",
      "label": "Developer / Agency Credit Text",
      "default": "Developed by Gandhi Media Solution"
    },
    {
      "type": "url",
      "id": "developer_credit_link",
      "label": "Developer / Agency Credit Link / Redirect URL"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand / About",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Little Creation"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Brand description",
          "default": "<p>Dedicated to reimagining the teether as a tool for early childhood development, rooted in Montessori philosophy.</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Support"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Need help? Email us at hello@littlecreation.co.uk</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Join our family"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Description",
          "default": "Be the first to know about new collections and exclusive offers."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "link_list", "settings": { "title": "SHOP" } },
      { "type": "link_list", "settings": { "title": "HELP" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
