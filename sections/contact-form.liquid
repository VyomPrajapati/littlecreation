<section class="contact-section section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    <div class="contact-section__header text-center mb-xl animate-on-scroll">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      <h1 class="contact-section__title mt-xs mb-sm">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="contact-section__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="contact-section__grid">

      <!-- Info Cards Column -->
      <div class="contact-info animate-on-scroll delay-1">
        <div class="contact-info__card">
          <h2 class="contact-info__heading">{{ section.settings.info_heading | default: 'We are here to help' }}</h2>
          <p class="contact-info__text">{{ section.settings.info_text | default: 'Have a question about our teethers, orders, or wholesale inquiries? Reach out to our team anytime.' }}</p>

          <div class="contact-info__list">

            <div class="contact-info__item">
              <div class="contact-info__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="contact-info__details">
                <span class="contact-info__label">Email Us</span>
                <a href="mailto:{{ section.settings.email | default: 'hello@littlecreation.co.uk' }}" class="contact-info__value">
                  {{ section.settings.email | default: 'hello@littlecreation.co.uk' }}
                </a>
              </div>
            </div>

            <div class="contact-info__item">
              <div class="contact-info__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="contact-info__details">
                <span class="contact-info__label">Location</span>
                <span class="contact-info__value">{{ section.settings.location | default: 'United Kingdom' }}</span>
              </div>
            </div>

            <div class="contact-info__item">
              <div class="contact-info__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="contact-info__details">
                <span class="contact-info__label">Support Hours</span>
                <span class="contact-info__value">{{ section.settings.hours | default: 'Mon - Fri: 9:00 - 17:00 GMT' }}</span>
              </div>
            </div>

            <div class="contact-info__item">
              <div class="contact-info__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <div class="contact-info__details">
                <span class="contact-info__label">Response Time</span>
                <span class="contact-info__value">Within 24 Business Hours</span>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Form Column -->
      <div class="contact-form-card animate-on-scroll delay-2">
        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}

          {%- if form.posted_successfully? -%}
            <div class="contact-form__alert contact-form__alert--success" tabindex="-1" autofocus>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>{{ 'templates.contact.form.post_success' | t | default: "Thanks for reaching out! We'll get back to you shortly." }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="contact-form__alert contact-form__alert--error" role="alert" tabindex="-1" autofocus>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span>Please check your details and try again.</span>
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <div class="contact-form__field">
              <label class="contact-form__label" for="ContactForm-name">Full Name *</label>
              <input class="contact-form__input"
                     type="text"
                     id="ContactForm-name"
                     name="contact[{{ 'templates.contact.form.name' | t }}]"
                     value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                     placeholder="e.g. Sarah Jenkins"
                     required>
            </div>

            <div class="contact-form__field">
              <label class="contact-form__label" for="ContactForm-email">Email Address *</label>
              <input class="contact-form__input"
                     type="email"
                     id="ContactForm-email"
                     name="contact[email]"
                     value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                     placeholder="e.g. sarah@example.com"
                     autocomplete="email"
                     autocapitalize="off"
                     required>
            </div>
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="ContactForm-phone">Phone Number (Optional)</label>
            <input class="contact-form__input"
                   type="tel"
                   id="ContactForm-phone"
                   name="contact[{{ 'templates.contact.form.phone' | t }}]"
                   value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                   placeholder="+44 7123 456789">
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="ContactForm-body">Your Message *</label>
            <textarea rows="5"
                      id="ContactForm-body"
                      class="contact-form__input contact-form__textarea"
                      name="contact[{{ 'templates.contact.form.comment' | t }}]"
                      placeholder="How can we help you today?"
                      required>{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="button button--full-width contact-form__submit">
            <span>Send Message</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

        {%- endform -%}
      </div>

    </div>

  </div>
</section>

<style>
/* ---- Contact Header ---- */
.contact-section__header {
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}
.contact-section__title {
  font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  color: var(--color-heading);
}
.contact-section__subtext {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--color-text);
  opacity: 0.85;
}

/* ---- Grid Layout ---- */
.contact-section__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-xl, 32px);
  max-width: 1100px;
  margin: 0 auto;
  align-items: start;
}
@media screen and (min-width: 640px) {
  .contact-section__grid {
    grid-template-columns: 1fr 1.2fr;
    gap: var(--spacing-lg, 40px);
  }
}

/* ---- Info Card (Left) ---- */
.contact-info__card {
  background: var(--color-skin-pale, #FBF0E8);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  padding: var(--spacing-xl, 40px) var(--spacing-lg, 32px);
  box-shadow: var(--shadow-sm);
}
@media screen and (max-width: 767px) {
  .contact-info__card {
    padding: var(--spacing-lg, 28px) var(--spacing-md, 20px);
  }
}
.contact-info__heading {
  font-size: 1.5rem;
  color: var(--color-heading);
  margin: 0 0 var(--spacing-xs);
}
.contact-info__text {
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--color-text);
  opacity: 0.85;
  margin-bottom: var(--spacing-lg, 32px);
}

.contact-info__list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 24px);
}
.contact-info__item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm, 16px);
}
.contact-info__icon {
  width: 46px;
  height: 46px;
  background: linear-gradient(135deg, var(--color-skin-light), var(--color-secondary));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-dark, #A07855);
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(198, 154, 124, 0.2);
}
.contact-info__details {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.contact-info__label {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-text);
  opacity: 0.6;
}
.contact-info__value {
  font-size: 0.98rem;
  font-weight: 600;
  color: var(--color-heading);
  text-decoration: none;
  word-break: break-word;
}
a.contact-info__value:hover {
  color: var(--color-primary);
}

/* ---- Form Card (Right) ---- */
.contact-form-card {
  background: var(--color-white, #FFFFFF);
  border: 1px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-xl, 24px);
  padding: var(--spacing-xl, 40px) var(--spacing-lg, 32px);
  box-shadow: var(--shadow-md);
}
@media screen and (max-width: 767px) {
  .contact-form-card {
    padding: var(--spacing-lg, 28px) var(--spacing-md, 20px);
  }
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 20px);
}
.contact-form__row {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-md, 20px);
}
@media screen and (min-width: 600px) {
  .contact-form__row {
    grid-template-columns: 1fr 1fr;
  }
}

.contact-form__field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.contact-form__label {
  font-size: 0.82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-heading);
}
.contact-form__input {
  width: 100%;
  padding: 14px 18px;
  background: var(--color-white, #FFFFFF);
  border: 1.5px solid var(--color-border, #E8D5C4);
  border-radius: var(--radius-lg, 14px);
  color: #111111 !important;
  font-family: var(--font-body-family);
  font-size: 0.95rem;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  box-sizing: border-box;
}
.contact-form__input::placeholder {
  color: #77665B !important;
  opacity: 1 !important;
}
.contact-form__input:focus {
  border-color: var(--color-primary, #C69A7C);
  box-shadow: 0 0 0 3px rgba(198, 154, 124, 0.25);
}
.contact-form__textarea {
  resize: vertical;
  min-height: 120px;
}

.contact-form__submit {
  padding: 16px 28px;
  font-size: 1rem;
  margin-top: var(--spacing-xs);
}

.contact-form__alert {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  border-radius: var(--radius-lg);
  font-size: 0.92rem;
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}
.contact-form__alert--success {
  background: rgba(76, 175, 80, 0.12);
  color: #2E7D32;
  border: 1px solid rgba(76, 175, 80, 0.3);
}
.contact-form__alert--error {
  background: rgba(211, 47, 47, 0.12);
  color: #C62828;
  border: 1px solid rgba(211, 47, 47, 0.3);
}
</style>

{% schema %}
{
  "name": "Contact section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label above heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Little Creation"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading text",
      "default": "Have a question or feedback? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info card heading",
      "default": "We are here to help"
    },
    {
      "type": "textarea",
      "id": "info_text",
      "label": "Info card text",
      "default": "Have a question about our teethers, orders, or wholesale inquiries? Reach out to our team anytime."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "hello@littlecreation.co.uk"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location text",
      "default": "United Kingdom"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Support hours",
      "default": "Mon - Fri: 9:00 - 17:00 GMT"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    { "name": "Contact section" }
  ]
}
{% endschema %}
