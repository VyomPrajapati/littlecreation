<section class="insta-section section-padding">
  <div class="container" style="max-width: 1600px; padding: 0 var(--spacing-sm);">
    
    {%- if section.settings.heading != blank -%}
      <div class="insta-header animate-on-scroll">
        <h2>
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.heading }}</a>
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
      </div>
    {%- endif -%}

    <div class="insta-scroll-container animate-on-scroll delay-1">
      <div class="insta-grid">
        {%- for block in section.blocks -%}
          <div class="insta-item" {{ block.shopify_attributes }}>
            <a href="{{ section.settings.link | default: '#' }}" target="_blank" rel="noopener" class="insta-item__link">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}"
                     alt="{{ block.settings.image.alt | default: 'Instagram photo' | escape }}"
                     loading="lazy"
                     class="insta-item__img">
              {%- else -%}
                <div class="insta-item__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              
              <!-- Instagram Icon Overlay -->
              <div class="insta-item__overlay">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
    
  </div>
</section>

<style>
.insta-header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}
.insta-header h2 {
  font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 500;
  color: var(--color-heading);
}
.insta-header a {
  text-decoration: none;
  color: inherit;
  transition: opacity 0.3s ease;
}
.insta-header a:hover {
  opacity: 0.7;
}

.insta-scroll-container {
  width: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 16px;
  scrollbar-width: thin;
  scrollbar-color: rgba(0,0,0,0.2) transparent;
}
.insta-scroll-container::-webkit-scrollbar {
  height: 6px;
}
.insta-scroll-container::-webkit-scrollbar-track {
  background: transparent;
}
.insta-scroll-container::-webkit-scrollbar-thumb {
  background-color: rgba(0,0,0,0.2);
  border-radius: 10px;
}

.insta-grid {
  display: grid;
  gap: 4px;
  grid-template-rows: repeat(2, 45vw);
  grid-auto-columns: 45vw;
  grid-auto-flow: column;
}

@media screen and (min-width: 768px) {
  .insta-grid {
    grid-template-rows: repeat(2, clamp(150px, 18vw, 300px));
    grid-auto-columns: clamp(150px, 18vw, 300px);
  }
}

.insta-item {
  position: relative;
  background: var(--color-skin-light);
  scroll-snap-align: start;
  overflow: hidden;
}

/* Make the first item take up 2x2 grid */
.insta-item:nth-child(1) {
  grid-row: span 2;
  grid-column: span 2;
}

.insta-item__link {
  display: block;
  width: 100%;
  height: 100%;
}

.insta-item__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.insta-item__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.insta-item__placeholder svg {
  width: 30%;
  height: 30%;
  fill: rgba(0,0,0,0.1);
}

.insta-item__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  color: white;
}
.insta-item:hover .insta-item__overlay {
  opacity: 1;
}
.insta-item:hover .insta-item__img {
  transform: scale(1.05);
}
</style>

{% schema %}
{
  "name": "Instagram Collage",
  "max_blocks": 25,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow @littlecreationofficial on Instagram"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Collage",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
