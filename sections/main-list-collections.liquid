<div class="container section-padding">
  <h1 class="text-center mb-lg">All Collections</h1>
  <div class="grid grid--3-col-desktop">
    {%- for collection in collections -%}
      <div class="collection-card">
        <a href="{{ collection.url }}">
          <div class="collection-card__image-wrapper">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}"
                   alt="{{ collection.title | escape }}"
                   loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <h3 class="collection-card__title text-center mt-sm">{{ collection.title }}</h3>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
.collection-card a {
  text-decoration: none;
  color: inherit;
}
.collection-card__image-wrapper {
  aspect-ratio: 1/1;
  border-radius: var(--border-radius);
  overflow: hidden;
  background: var(--color-secondary);
}
.collection-card__image-wrapper img, .collection-card__image-wrapper svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.collection-card:hover .collection-card__image-wrapper img {
  transform: scale(1.05);
}
</style>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
