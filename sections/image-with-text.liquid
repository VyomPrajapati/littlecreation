<section class="image-with-text section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="image-with-text__grid {% if section.settings.layout == 'text_first' %}image-with-text__grid--reversed{% endif %}">

      {%- assign assigned_product = section.settings.product -%}
      {%- assign image_to_show = section.settings.image -%}
      {%- if assigned_product != blank and assigned_product.featured_image != blank -%}
        {%- assign image_to_show = assigned_product.featured_image -%}
      {%- endif -%}

      <!-- Image -->
      <div class="image-with-text__image-col animate-on-scroll">
        <div class="image-with-text__image-outer">
          <div class="image-with-text__blob"></div>
          <div class="image-with-text__frame">
            {%- if image_to_show != blank -%}
              <img src="{{ image_to_show | image_url: width: 900 }}"
                   alt="{{ image_to_show.alt | default: section.settings.heading | escape }}"
                   width="{{ image_to_show.width }}"
                   height="{{ image_to_show.height }}"
                   loading="lazy"
                   class="image-with-text__img">
            {%- else -%}
              <div class="image-with-text__placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Text -->
      <div class="image-with-text__text-col">
        {%- if section.settings.label != blank -%}
          <span class="section-label animate-on-scroll">{{ section.settings.label }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading animate-on-scroll delay-1">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- assign text_to_show = section.settings.text -%}
        {%- if assigned_product != blank and assigned_product.description != blank -%}
          {%- assign text_to_show = assigned_product.description -%}
        {%- endif -%}

        {%- if text_to_show != blank -%}
          <div class="image-with-text__body rte animate-on-scroll delay-2">{{ text_to_show }}</div>
        {%- endif -%}

        {%- assign link_to_show = section.settings.button_link -%}
        {%- if assigned_product != blank -%}
          {%- assign link_to_show = assigned_product.url -%}
        {%- endif -%}

        {%- if section.settings.button_label != blank and link_to_show != blank -%}
          <div class="animate-on-scroll delay-3">
            <a href="{{ link_to_show }}" class="button">
              {{ section.settings.button_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
/* ---- Grid ---- */
.image-with-text__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  align-items: center;
}
@media screen and (min-width: 768px) {
  .image-with-text__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }
  .image-with-text__grid--reversed .image-with-text__image-col {
    order: 2;
  }
  .image-with-text__grid--reversed .image-with-text__text-col {
    order: 1;
  }
}

/* ---- Image column ---- */
.image-with-text__image-col {
  display: flex;
  justify-content: center;
}
.image-with-text__image-outer {
  position: relative;
  width: 100%;
  max-width: 480px;
}
.image-with-text__blob {
  position: absolute;
  width: 85%;
  height: 85%;
  background: var(--color-skin-light);
  border-radius: 55% 45% 60% 40% / 40% 60% 45% 55%;
  top: 8%;
  left: 8%;
  z-index: 0;
  opacity: 0.7;
}
.image-with-text__frame {
  position: relative;
  z-index: 1;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  aspect-ratio: 1 / 1;
}
.image-with-text__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-slow);
}
.image-with-text__frame:hover .image-with-text__img {
  transform: scale(1.03);
}
.image-with-text__placeholder {
  width: 100%;
  height: 100%;
  background: var(--color-skin-light);
}
.image-with-text__placeholder svg {
  width: 100%;
  height: 100%;
  fill: rgba(0,0,0,0.06);
}

/* ---- Text column ---- */
.image-with-text__text-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--spacing-xs);
}
@media screen and (max-width: 767px) {
  .image-with-text__text-col { align-items: center; text-align: center; }
  .image-with-text__text-col .button { align-self: center; }
}
.image-with-text__heading {
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
  margin-top: var(--spacing-xs);
}
.image-with-text__body {
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-text);
  opacity: 0.9;
  margin-bottom: var(--spacing-md);
  max-width: 480px;
}
.image-with-text__body p { margin-bottom: 0.75em; }
.image-with-text__body p:last-child { margin-bottom: 0; }
.image-with-text__body ul {
  padding-left: 0;
  margin-bottom: 1em;
  list-style-type: none;
}
.image-with-text__body li {
  margin-bottom: 0.85em;
}
.image-with-text__body strong {
  font-weight: 600;
  color: var(--color-heading);
}
</style>

{% schema %}
{
  "name": "Image & Text Reveal",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used as a fallback if no product is selected."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select a product to automatically show its image, description, and link."
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image on left" },
        { "value": "text_first", "label": "Image on right" }
      ],
      "default": "image_first",
      "label": "Desktop image placement"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label pill (above heading)",
      "default": "Crafted with care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted with Love, Trusted by Parents"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our teething toys are designed in the UK with your baby's safety as our highest priority. Every product is made from 100% food-grade silicone — BPA free, phthalate free, and non-toxic.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    { "name": "Image & Text Reveal" }
  ]
}
{% endschema %}
