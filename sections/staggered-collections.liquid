<section class="staggered-collections section-padding">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="staggered-collections__header text-center mb-xl">
        {%- if section.settings.subtitle != blank -%}
          <span class="section-label animate-on-scroll">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        <h2 class="animate-on-scroll delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="staggered-collections__grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <div class="staggered-collections__item animate-on-scroll delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: '#' }}" class="staggered-collections__card" aria-label="{{ collection.title | default: 'Collection' }}">

            <div class="staggered-collections__image-wrapper">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.image.alt | default: collection.title | escape }}"
                     loading="lazy">
              {%- elsif collection.image != blank -%}
                <img src="{{ collection.image | image_url: width: 700 }}"
                     alt="{{ collection.image.alt | escape }}"
                     loading="lazy">
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg staggered-collections__placeholder' }}
              {%- endif -%}
              <!-- Overlay -->
              <div class="staggered-collections__overlay"></div>
            </div>

            <div class="staggered-collections__label">
              <span>{{ collection.title | default: 'Collection' }}</span>
              <span class="staggered-collections__arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>

          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
.staggered-collections__header { max-width: 560px; margin-left: auto; margin-right: auto; }

.staggered-collections__grid {
  display: flex;
  gap: var(--spacing-md);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  margin: 0 calc(-1 * var(--spacing-sm, 16px));
  padding-left: var(--spacing-sm, 16px);
  padding-right: var(--spacing-sm, 16px);
  padding-bottom: var(--spacing-xs);
  scrollbar-width: none;
}
.staggered-collections__grid::-webkit-scrollbar { display: none; }

.staggered-collections__item {
  scroll-snap-align: start;
  flex: 0 0 82%;
  min-width: 82%;
}

@media screen and (min-width: 600px) {
  .staggered-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow-x: visible;
    margin: 0;
    padding: 0;
  }
  .staggered-collections__item {
    flex: unset;
    min-width: unset;
  }
}
@media screen and (min-width: 1024px) {
  .staggered-collections__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-xl);
    align-items: start;
  }
  .staggered-collections__item:nth-child(2) { margin-top: 48px; }
  .staggered-collections__item:nth-child(3) { margin-top: 96px; }
}

.staggered-collections__card {
  display: block;
  position: relative;
  text-decoration: none;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: box-shadow var(--transition-base), transform var(--transition-base);
}
.staggered-collections__card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-skin);
}

.staggered-collections__image-wrapper {
  aspect-ratio: 4/5;
  background: var(--color-skin-light);
  position: relative;
  overflow: hidden;
}
.staggered-collections__image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-slow);
}
.staggered-collections__card:hover .staggered-collections__image-wrapper img {
  transform: scale(1.05);
}
.staggered-collections__placeholder {
  width: 100%;
  height: 100%;
  fill: rgba(0,0,0,0.07);
}

.staggered-collections__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(17,17,17,0.5) 0%, transparent 50%);
  opacity: 0.6;
  transition: opacity var(--transition-base);
}
.staggered-collections__card:hover .staggered-collections__overlay {
  opacity: 0.8;
}

/* Label pill */
.staggered-collections__label {
  position: absolute;
  bottom: var(--spacing-sm);
  left: var(--spacing-sm);
  right: var(--spacing-sm);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 12px 18px;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 0.88rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-heading);
  transform: translateY(4px);
  opacity: 0.96;
  transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
}
.staggered-collections__card:hover .staggered-collections__label {
  background: var(--color-primary);
  color: var(--color-white);
  transform: translateY(0);
}
.staggered-collections__arrow {
  display: flex;
  align-items: center;
  transition: transform var(--transition-base);
}
.staggered-collections__card:hover .staggered-collections__arrow {
  transform: translateX(3px);
}
</style>

{% schema %}
{
  "name": "Staggered Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Label above heading",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional, overrides collection image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Staggered Collection Grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
