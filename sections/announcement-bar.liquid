{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="announcement-bar__inner">
      <div class="announcement-bar__message">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="announcement-bar__link">
        {%- endif -%}
          <span class="announcement-bar__icon">✦</span>
          {{ section.settings.text | escape }}
          <span class="announcement-bar__icon">✦</span>
        {%- if section.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

<style>
.announcement-bar {
  padding: 10px 0;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  overflow: hidden;
}
.announcement-bar__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 0 var(--spacing-md);
}
.announcement-bar__message {
  display: flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.announcement-bar__icon {
  color: var(--color-primary);
  font-size: 0.6rem;
  opacity: 0.8;
  flex-shrink: 0;
}
.announcement-bar__link {
  color: inherit;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: opacity 0.2s ease;
}
.announcement-bar__link:hover {
  opacity: 0.8;
  text-decoration: none;
}
@media screen and (max-width: 767px) {
  .announcement-bar__message {
    font-size: 0.75rem;
    white-space: normal;
    text-align: center;
  }
  .announcement-bar { padding: 8px 0; }
}
</style>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free Shipping on Orders over £40 · 30-Day Returns · UK Designed"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5DEC8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3A2E27"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
