<!-- Little Creation Theme v3.5 -->
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#C69A7C' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="index, follow">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Open Graph / WhatsApp / Facebook SEO -->
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- assign og_description = page_description | default: shop.description | default: page_title | strip_html | escape -%}
    <meta property="og:description" content="{{ og_description }}">

    {%- if template.name == 'product' -%}
      <meta property="og:type" content="product">
      <meta property="og:price:amount" content="{{ product.price | money_without_currency | remove: ',' }}">
      <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    {%- elsif template.name == 'article' -%}
      <meta property="og:type" content="article">
    {%- else -%}
      <meta property="og:type" content="website">
    {%- endif -%}

    {%- assign og_image_src = page_image -%}
    {%- if template.name == 'product' and product.featured_media -%}
      {%- assign og_image_src = product.featured_media -%}
    {%- elsif template.name == 'article' and article.image -%}
      {%- assign og_image_src = article.image -%}
    {%- elsif page_image != blank -%}
      {%- assign og_image_src = page_image -%}
    {%- elsif settings.logo != blank -%}
      {%- assign og_image_src = settings.logo -%}
    {%- elsif settings.favicon != blank -%}
      {%- assign og_image_src = settings.favicon -%}
    {%- endif -%}

    {%- if og_image_src != blank -%}
      <meta property="og:image" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
      <meta property="og:image:secure_url" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    {%- endif -%}

    <!-- Twitter Cards SEO -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ og_description }}">
    {%- if og_image_src != blank -%}
      <meta name="twitter:image" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
    {%- endif -%}

    <!-- Schema.org JSON-LD Structured Data for Google -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo != blank -%}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- elsif settings.favicon != blank -%}
        "logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }},
      {%- endif -%}
      "sameAs": [
        {{ settings.social_instagram_link | json }},
        {{ settings.social_tiktok_link | json }},
        {{ settings.social_facebook_link | json }},
        {{ settings.social_pinterest_link | json }}
      ]
    }
    </script>

    {% capture search_url_template %}{{ shop.url }}/search?q={search_term_string}{% endcapture %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_url_template | json }},
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    {%- if template.name == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      {%- if product.featured_media -%}
        "image": [
          {{ product.featured_media | image_url: width: 1000 | prepend: 'https:' | json }}
        ],
      {%- endif -%}
      "description": {{ product.description | strip_html | truncatewords: 100 | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | money_without_currency | remove: ',' | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ shop.url | append: product.url | json }}
      }
    }
    </script>
    {%- endif -%}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if template.name == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif template.name == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {%- elsif template.name == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ shop.url | append: page.url | json }}
          }
        {%- endif -%}
      ]
    }
    </script>

    {{ content_for_header }}

    <!-- Google Fonts: Fredoka (Funky Kids Headings) + Plus Jakarta Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <!-- Judge.me Early Settings Brand Interceptor -->
    <script>
      (function() {
        var _s = window.jdgmSettings || {};
        function patchJdgm(s) {
          if (!s || typeof s !== 'object') return;
          s.widget_primary_color = '#C69A7C';
          s.review_form_button_color = '#C69A7C';
          s.review_form_star_color = '#FFB800';
          s.widget_star_use_custom_color = true;
          s.widget_custom_star_color = '#FFB800';
          s.featured_carousel_header_background_color = '#C69A7C';
          s.featured_carousel_full_star_background = '#FFB800';
          s.verified_count_badge_color = '#C69A7C';
          s.all_reviews_text_color = '#C69A7C';
          s.widget_load_more_color = '#C69A7C';
          s.widget_ugc_primary_button_background_color = '#C69A7C';
          s.widget_ugc_primary_button_border_color = '#C69A7C';
        }
        patchJdgm(_s);
        try {
          Object.defineProperty(window, 'jdgmSettings', {
            configurable: true,
            enumerable: true,
            get: function() { return _s; },
            set: function(v) { _s = v; patchJdgm(_s); }
          });
        } catch(e) {}
      })();
    </script>

    <style id="GlobalKidsTypography">
      :root {
        --font-heading-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        --font-body-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;

        --jdgm-primary-color: #C69A7C !important;
        --jdgm-secondary-color: rgba(198, 154, 124, 0.15) !important;
        --jdgm-star-color: #FFB800 !important;
        --jdgm-button-color: #C69A7C !important;
        --jdgm-write-review-bg: #C69A7C !important;
        --jdgm-badge-color: #FFB800 !important;

        --jm-primary-color: #C69A7C !important;
        --jm-star-color: #FFB800 !important;
        --jm-star-color-active: #FFB800 !important;
        --jm-rating-color: #FFB800 !important;
        --jm-secondary-color: rgba(198, 154, 124, 0.15) !important;
        --jm-btn-primary-bg: #C69A7C !important;
        --jm-btn-primary-color: #FFFFFF !important;
        --jm-btn-primary-border: #C69A7C !important;
        --jm-btn-primary-hover-bg: #A07855 !important;
        --jm-btn-primary-hover-border: #A07855 !important;
        --jm-btn-primary-hover-color: #FFFFFF !important;
      }
      /* Body font — applied safely without clobbering icon fonts or review modals */
      body, p, li {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      input:not([class*="jdgm"]):not([class*="jm-"]),
      select:not([class*="jdgm"]):not([class*="jm-"]),
      textarea:not([class*="jdgm"]):not([class*="jm-"]) {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      span:not([class*="jdgm"]):not([class*="jm-"]):not([class*="icon"]):not([class*="star"]):not([data-score]):not([data-rating]),
      a:not([class*="jdgm"]):not([class*="jm-"]):not([class*="icon"]):not([class*="star"]):not([class*="btn"]):not([class*="button"]) {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, h5, h6,
      .h1, .h2, .h3, .h4, .h5, .h6,
      [class*="title"],
      [class*="heading"],
      [class*="subtitle"],
      .section-label,
      .header__logo-text,
      .button,
      .btn,
      .product-card__title,
      .mobile-menu-drawer__title,
      .contact-info__heading,
      .faq-accordion__question,
      .footer__column-title,
      .cart-drawer__title {
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
      }
      /* Judge.me Stars: colour ONLY — font-family untouched */
      :root .jdgm-star,
      :root .jdgm-rev-widg__star,
      :root .jdgm-form__star,
      :root [class*="jdgm-star"],
      :root .jm-star,
      :root .jm-rating__star,
      :root .jm-form-rating__star,
      :root .jm-form__star,
      :root [class*="jm-star"],
      :root .jdgm-prev-badge__stars .jdgm-star,
      :root .jdgm-rev-widg__summary-stars .jdgm-star,
      :root .jdgm-rev__rating .jdgm-star {
        color: #FFB800 !important;
      }

      :root .jdgm-star.jdgm--on,
      :root .jdgm-star.jdgm--full,
      :root .jdgm-rev-widg__star.jdgm--on,
      :root .jdgm-rev-widg__star.jdgm--full,
      :root .jm-star.is-active,
      :root .jm-star.is-selected {
        color: #FFB800 !important;
      }

      :root .jdgm-star.jdgm--off,
      :root .jdgm-star.jdgm--empty,
      :root .jdgm-rev-widg__star.jdgm--off,
      :root .jdgm-rev-widg__star.jdgm--empty,
      :root .jm-star--off,
      :root .jm-star--empty {
        color: #D1D5DB !important;
        opacity: 0.6 !important;
      }

      /* Ultimate Overrides for Judge.me Buttons (v2 + v3 + Popups) */
      #judgeme_product_reviews .jdgm-write-rev-btn,
      #judgeme_product_reviews .jdgm-rev-widg__write-rev-btn,
      .jdgm-widget .jdgm-write-rev-btn,
      .jdgm-widget .jdgm-rev-widg__write-rev-btn,
      .jdgm-rev-widg .jdgm-write-rev-btn,
      .jdgm-rev-widg .jdgm-rev-widg__write-rev-btn,
      a.jdgm-write-rev-btn,
      button.jdgm-write-rev-btn,
      .jdgm-write-rev-btn,
      .jdgm-rev-widg__write-rev-btn,
      .jm-button--primary,
      .jm-action-buttons__button,
      .jm-btn--primary,
      .jm-btn,
      .jm-button,
      .jdgm-btn--solid,
      input.jdgm-submit-rev,
      button.jdgm-submit-rev,
      .jdgm-submit-rev,
      .jm-modal button.jm-button--primary,
      .jm-form button[type="submit"] {
        background-color: #C69A7C !important;
        background: #C69A7C !important;
        color: #FFFFFF !important;
        border-color: #C69A7C !important;
        border-radius: 50px !important;
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        box-shadow: 0 4px 12px rgba(198, 154, 124, 0.25) !important;
        padding: 12px 28px !important;
        font-weight: 600 !important;
        text-decoration: none !important;
      }

      a.jdgm-write-rev-btn:hover,
      button.jdgm-write-rev-btn:hover,
      .jdgm-write-rev-btn:hover,
      .jdgm-rev-widg__write-rev-btn:hover,
      .jm-button--primary:hover,
      .jm-action-buttons__button:hover,
      .jm-btn--primary:hover,
      .jm-btn:hover,
      .jm-button:hover,
      .jdgm-btn--solid:hover,
      button.jdgm-submit-rev:hover,
      .jm-form button[type="submit"]:hover {
        background-color: #A07855 !important;
        background: #A07855 !important;
        border-color: #A07855 !important;
        color: #FFFFFF !important;
      }

      {%- if request.path contains 'unsubscribe' -%}
      /* Brand Styling for Shopify Native Unsubscribe Page */
      body {
        background-color: #FBF0E8 !important;
      }
      #MainContent,
      main {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 60px 20px !important;
        min-height: 55vh !important;
      }
      #MainContent > div,
      main > div,
      .page-width {
        background: #FFFFFF !important;
        border: 1.5px solid #E8D5C4 !important;
        border-radius: 24px !important;
        padding: 48px 36px !important;
        max-width: 580px !important;
        width: 100% !important;
        text-align: center !important;
        box-shadow: 0 10px 30px rgba(58, 46, 39, 0.06) !important;
      }
      #MainContent h1,
      main h1 {
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        font-size: 2.2rem !important;
        color: #111111 !important;
        margin-bottom: 16px !important;
      }
      #MainContent p,
      main p {
        font-size: 1.05rem !important;
        color: #3A2E27 !important;
        line-height: 1.6 !important;
      }
      {%- endif -%}
    </style>

