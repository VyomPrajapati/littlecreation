      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}
    {% render 'newsletter-popup' %}

    <!-- Judge.me Free Plan: Brand Colour Overrider -->
    <script>
    (function jdgmBrandOverride() {
      var BRAND  = '#C69A7C';
      var BRANDD = '#A07855';
      var GOLD   = '#FFB800';
      var GREY   = '#D1D5DB';
      var running = false;
      var timer   = null;

      function setCSSVars() {
        var r = document.documentElement;
        r.style.setProperty('--jdgm-primary-color',   BRAND, 'important');
        r.style.setProperty('--jdgm-secondary-color', 'rgba(198, 154, 124, 0.15)', 'important');
        r.style.setProperty('--jdgm-star-color',      GOLD,  'important');
        r.style.setProperty('--jdgm-button-color',    BRAND, 'important');
        r.style.setProperty('--jdgm-write-review-bg', BRAND, 'important');
        r.style.setProperty('--jdgm-badge-color',     GOLD,  'important');

        r.style.setProperty('--jm-primary-color',          BRAND, 'important');
        r.style.setProperty('--jm-star-color',             GOLD,  'important');
        r.style.setProperty('--jm-star-color-active',      GOLD,  'important');
        r.style.setProperty('--jm-rating-color',           GOLD,  'important');
        r.style.setProperty('--jm-secondary-color',        'rgba(198, 154, 124, 0.15)', 'important');
        r.style.setProperty('--jm-btn-primary-bg',         BRAND, 'important');
        r.style.setProperty('--jm-btn-primary-color',      '#fff','important');
        r.style.setProperty('--jm-btn-primary-border',     BRAND, 'important');
        r.style.setProperty('--jm-btn-primary-hover-bg',   BRANDD,'important');
        r.style.setProperty('--jm-btn-primary-hover-border',BRANDD,'important');
        r.style.setProperty('--jm-button-primary-bg',      BRAND, 'important');
        r.style.setProperty('--jm-button-primary-color',   '#fff','important');
        r.style.setProperty('--jm-button-primary-border',  BRAND, 'important');
      }

      /* Re-colour one element — never touch font-family */
      function styleEl(el) {
        var cls = el.className || '';
        if (/jdgm-star|jm-star|jm-rating__star|jdgm-rev-widg__star|jdgm-form__star|jm-form__star/.test(cls)) {
          var off = el.classList.contains('jdgm--off') || el.classList.contains('jdgm--empty') || el.classList.contains('jm-star--off') || el.classList.contains('jm-star--empty');
          el.style.setProperty('color', off ? GREY : GOLD, 'important');
        }
        if (/jdgm-write-rev-btn|jdgm-submit-rev|jdgm-rev-widg__write-rev-btn|jm-button--primary|jm-action-buttons__button|jm-btn|jm-button/.test(cls)) {
          el.style.setProperty('background-color', BRAND, 'important');
          el.style.setProperty('background',       BRAND, 'important');
          el.style.setProperty('border-color',     BRAND, 'important');
          el.style.setProperty('color',            '#fff', 'important');
          el.style.setProperty('border-radius',    '50px', 'important');
        }
      }

      /* Override <style> — always re-appended to END of <head> so it wins cascade */
      var overrideEl = null;
      var CSS_TEXT =
        ':root .jdgm-write-rev-btn,:root a.jdgm-write-rev-btn,:root button.jdgm-write-rev-btn,' +
        ':root .jdgm-rev-widg__write-rev-btn,:root .jdgm-submit-rev,:root button.jdgm-submit-rev,' +
        ':root input.jdgm-submit-rev,:root .jm-button--primary,:root .jm-action-buttons__button,' +
        ':root .jm-btn--primary,:root .jm-btn,:root .jm-button,:root .jdgm-btn--solid,' +
        ':root .jm-modal button.jm-button--primary,:root .jm-form button[type="submit"]{' +
          'background-color:' + BRAND + '!important;background:' + BRAND + '!important;' +
          'border-color:' + BRAND + '!important;color:#fff!important;border-radius:50px!important;' +
          'font-family:Fredoka,Quicksand,sans-serif!important}' +
        ':root .jdgm-write-rev-btn:hover,:root a.jdgm-write-rev-btn:hover,' +
        ':root button.jdgm-write-rev-btn:hover,:root .jm-button--primary:hover,' +
        ':root .jm-action-buttons__button:hover,:root .jm-btn--primary:hover,' +
        ':root .jm-btn:hover,:root .jm-button:hover,:root .jdgm-btn--solid:hover,' +
        ':root button.jdgm-submit-rev:hover,:root .jm-form button[type="submit"]:hover{' +
          'background-color:' + BRANDD + '!important;background:' + BRANDD + '!important;' +
          'border-color:' + BRANDD + '!important;color:#fff!important}' +
        ':root .jdgm-star,:root [class*="jdgm-star"],:root .jdgm-rev-widg__star,' +
        ':root .jdgm-form__star,:root .jm-star,:root .jm-rating__star,' +
        ':root .jm-form-rating__star,:root .jm-form__star,:root [class*="jm-star"],' +
        ':root .jm-rating-item.is-selected,:root .jm-rating-item.is-active{color:' + GOLD + '!important}' +
        ':root .jdgm-star.jdgm--off,:root .jdgm-star.jdgm--empty,' +
        ':root .jdgm-rev-widg__star.jdgm--off,:root .jdgm-rev-widg__star.jdgm--empty,' +
        ':root .jm-star--off,:root .jm-star--empty{' +
          'color:' + GREY + '!important;opacity:0.6!important}' +
        ':root .jdgm-histogram__bar-content,:root .jm-histogram__bar-fill,' +
        ':root .jm-histogram__bar-content{background-color:' + GOLD + '!important;background:' + GOLD + '!important}' +
        ':root .jdgm-tab.jdgm--active{border-bottom-color:' + BRAND + '!important;color:' + BRAND + '!important}' +
        ':root .jdgm-widget a,:root .jdgm-rev-widg a,:root .jm-widget a{color:' + BRAND + '!important}';

      function ensureOverrideStyle() {
        var head = document.head || document.body;
        if (!overrideEl) {
          overrideEl = document.createElement('style');
          overrideEl.id = 'jdgm-brand-override';
          overrideEl.textContent = CSS_TEXT;
        }
        head.appendChild(overrideEl);
      }

      /* Main scan */
      function scanAll() {
        if (running) return;
        running = true;
        try {
          obs.disconnect();
          setCSSVars();
          document.querySelectorAll(
            ':root .jdgm-star,:root .jdgm-rev-widg__star,:root .jdgm-form__star,' +
            ':root [class*="jdgm-star"],:root .jm-star,:root .jm-rating__star,' +
            ':root .jm-form-rating__star,:root .jm-form__star,:root [class*="jm-star"],' +
            ':root a.jdgm-write-rev-btn,:root button.jdgm-write-rev-btn,:root .jdgm-write-rev-btn,' +
            ':root .jdgm-rev-widg__write-rev-btn,:root input.jdgm-submit-rev,' +
            ':root button.jdgm-submit-rev,:root .jdgm-submit-rev,' +
            ':root .jm-button--primary,:root .jm-action-buttons__button,:root .jm-btn--primary,' +
            ':root .jm-btn,:root .jm-button,:root .jdgm-btn--solid'
          ).forEach(styleEl);
          ensureOverrideStyle();
        } finally {
          running = false;
          startObserver();
        }
      }

      function debouncedScan() {
        if (timer) clearTimeout(timer);
        timer = setTimeout(function() { timer = null; scanAll(); }, 60);
      }

      var obs = new MutationObserver(function(mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var m = mutations[i];
          if (m.type === 'childList' && m.addedNodes.length) { debouncedScan(); return; }
          if (m.type === 'attributes') { debouncedScan(); return; }
        }
      });

      function startObserver() {
        var opts = { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] };
        if (document.head) obs.observe(document.head, opts);
        obs.observe(document.body, opts);
      }

      setCSSVars();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { scanAll(); });
      } else {
        scanAll();
      }
      window.addEventListener('load', debouncedScan);
    })();
    </script>
  </body>
</html>
