<!-- Little Creation Theme v3.5 -->
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#C69A7C' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="index, follow">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Open Graph / WhatsApp / Facebook SEO -->
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- assign og_description = page_description | default: shop.description | default: page_title | strip_html | escape -%}
    <meta property="og:description" content="{{ og_description }}">

    {%- if template.name == 'product' -%}
      <meta property="og:type" content="product">
      <meta property="og:price:amount" content="{{ product.price | money_without_currency | remove: ',' }}">
      <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    {%- elsif template.name == 'article' -%}
      <meta property="og:type" content="article">
    {%- else -%}
      <meta property="og:type" content="website">
    {%- endif -%}

    {%- assign og_image_src = page_image -%}
    {%- if template.name == 'product' and product.featured_media -%}
      {%- assign og_image_src = product.featured_media -%}
    {%- elsif template.name == 'article' and article.image -%}
      {%- assign og_image_src = article.image -%}
    {%- elsif page_image != blank -%}
      {%- assign og_image_src = page_image -%}
    {%- elsif settings.logo != blank -%}
      {%- assign og_image_src = settings.logo -%}
    {%- endif -%}

    {%- if og_image_src != blank -%}
      <meta property="og:image" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
      <meta property="og:image:secure_url" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    {%- endif -%}

    <!-- Twitter Cards SEO -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ og_description }}">
    {%- if og_image_src != blank -%}
      <meta name="twitter:image" content="https:{{ og_image_src | image_url: width: 1200, height: 630 }}">
    {%- endif -%}

    <!-- Schema.org JSON-LD Structured Data for Google -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo != blank -%}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif -%}
      "sameAs": [
        {{ settings.social_instagram_link | json }},
        {{ settings.social_tiktok_link | json }},
        {{ settings.social_facebook_link | json }},
        {{ settings.social_pinterest_link | json }}
      ]
    }
    </script>

    {% capture search_url_template %}{{ shop.url }}/search?q={search_term_string}{% endcapture %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_url_template | json }},
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    {%- if template.name == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      {%- if product.featured_media -%}
        "image": [
          {{ product.featured_media | image_url: width: 1000 | prepend: 'https:' | json }}
        ],
      {%- endif -%}
      "description": {{ product.description | strip_html | truncatewords: 100 | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | money_without_currency | remove: ',' | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ shop.url | append: product.url | json }}
      }
    }
    </script>
    {%- endif -%}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if template.name == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif template.name == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {%- elsif template.name == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ shop.url | append: page.url | json }}
          }
        {%- endif -%}
      ]
    }
    </script>

    {{ content_for_header }}

    <!-- Google Fonts: Fredoka (Funky Kids Headings) + Plus Jakarta Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style id="GlobalKidsTypography">
      :root {
        --font-heading-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        --font-body-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
      }
      body, p, span:not([class*="jdgm"]), li, a:not([class*="jdgm"]), input, select, textarea {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
      }
      h1, h2, h3, h4, h5, h6,
      .h1, .h2, .h3, .h4, .h5, .h6,
      [class*="title"],
      [class*="heading"],
      [class*="subtitle"],
      .section-label,
      .header__logo-text,
      .button,
      .btn,
      .product-card__title,
      .mobile-menu-drawer__title,
      .contact-info__heading,
      .faq-accordion__question,
      .footer__column-title,
      .cart-drawer__title {
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
      }
      /* ── Judge.me Stars: colour ONLY, font-family intentionally untouched ──
         Judge.me renders stars with a proprietary icon font loaded from their
         CDN. If you override font-family to any system font the icon glyphs
         (private-use Unicode) become empty squares. Only set color.
      ── ───────────────────────────────────────────────────────────────────── */
      .jdgm-star,
      .jdgm-rev-widg__star,
      .jdgm-form__star,
      [class*="jdgm-star"],
      .jdgm-prev-badge__stars .jdgm-star,
      .jdgm-rev-widg__summary-stars .jdgm-star,
      .jdgm-rev__rating .jdgm-star {
        color: #FFB800 !important;
        /* font-family: DO NOT set — icon font must be preserved */
      }

      .jdgm-star.jdgm--on,
      .jdgm-star.jdgm--full,
      .jdgm-rev-widg__star.jdgm--on,
      .jdgm-rev-widg__star.jdgm--full {
        color: #FFB800 !important;
      }

      .jdgm-star.jdgm--off,
      .jdgm-star.jdgm--empty,
      .jdgm-rev-widg__star.jdgm--off,
      .jdgm-rev-widg__star.jdgm--empty {
        color: #D1D5DB !important;
        opacity: 0.6 !important;
      }

      /* Ultimate Overrides for Judge.me Green Buttons */
      #judgeme_product_reviews .jdgm-write-rev-btn,
      #judgeme_product_reviews .jdgm-rev-widg__write-rev-btn,
      .jdgm-widget .jdgm-write-rev-btn,
      .jdgm-widget .jdgm-rev-widg__write-rev-btn,
      .jdgm-rev-widg .jdgm-write-rev-btn,
      .jdgm-rev-widg .jdgm-rev-widg__write-rev-btn,
      a.jdgm-write-rev-btn,
      button.jdgm-write-rev-btn,
      .jdgm-write-rev-btn,
      .jdgm-rev-widg__write-rev-btn,
      input.jdgm-submit-rev,
      button.jdgm-submit-rev,
      .jdgm-submit-rev {
        background-color: #C69A7C !important;
        background: #C69A7C !important;
        color: #FFFFFF !important;
        border-color: #C69A7C !important;
        border-radius: 50px !important;
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        box-shadow: 0 4px 12px rgba(198, 154, 124, 0.25) !important;
        padding: 12px 28px !important;
        font-weight: 600 !important;
        text-decoration: none !important;
      }

      a.jdgm-write-rev-btn:hover,
      button.jdgm-write-rev-btn:hover,
      .jdgm-write-rev-btn:hover,
      .jdgm-rev-widg__write-rev-btn:hover {
        background-color: #A07855 !important;
        background: #A07855 !important;
        border-color: #A07855 !important;
        color: #FFFFFF !important;
      }

      {%- if request.path contains 'unsubscribe' -%}
      /* Brand Styling for Shopify Native Unsubscribe Page */
      body {
        background-color: #FBF0E8 !important;
      }
      #MainContent,
      main {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 60px 20px !important;
        min-height: 55vh !important;
      }
      #MainContent > div,
      main > div,
      .page-width {
        background: #FFFFFF !important;
        border: 1.5px solid #E8D5C4 !important;
        border-radius: 24px !important;
        padding: 48px 36px !important;
        max-width: 580px !important;
        width: 100% !important;
        text-align: center !important;
        box-shadow: 0 10px 30px rgba(58, 46, 39, 0.06) !important;
      }
      #MainContent h1,
      main h1 {
        font-family: 'Fredoka', 'Quicksand', system-ui, sans-serif !important;
        font-size: 2.2rem !important;
        color: #111111 !important;
        margin-bottom: 16px !important;
      }
      #MainContent p,
      main p {
        font-size: 1.05rem !important;
        color: #3A2E27 !important;
        line-height: 1.6 !important;
      }
      {%- endif -%}
    </style>

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="visually-hidden skip-to-content" href="#MainContent">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}
    {% render 'newsletter-popup' %}

    <!-- Judge.me Free Plan: Brand Colour Overrider + MutationObserver -->
    <script>
    (function jdgmBrandOverride() {
      var BRAND  = '#C69A7C';
      var BRANDD = '#A07855';   /* darker hover */
      var GOLD   = '#FFB800';
      var GREY   = '#D1D5DB';

      /* Set CSS custom-properties at root so var() references resolve correctly */
      function setCSSVars() {
        var r = document.documentElement;
        r.style.setProperty('--jdgm-primary-color',    BRAND,  'important');
        r.style.setProperty('--jdgm-secondary-color',  BRAND,  'important');
        r.style.setProperty('--jdgm-star-color',       GOLD,   'important');
        r.style.setProperty('--jdgm-button-color',     BRAND,  'important');
        r.style.setProperty('--jdgm-write-review-bg',  BRAND,  'important');
        r.style.setProperty('--jdgm-badge-color',      GOLD,   'important');
      }

      /* Re-colour a single element. NEVER touch font-family on stars —
         Judge.me uses an icon font; overriding it causes squares. */
      function styleEl(el) {
        var cls = el.className || '';
        var isStar   = /jdgm-star|jdgm-rev-widg__star|jdgm-form__star/.test(cls);
        var isButton = /jdgm-write-rev-btn|jdgm-submit-rev|jdgm-rev-widg__write-rev-btn/.test(cls);
        var isLink   = /jdgm-tab/.test(cls);

        if (isStar) {
          var off = el.classList.contains('jdgm--off') || el.classList.contains('jdgm--empty');
          el.style.setProperty('color', off ? GREY : GOLD, 'important');
          /* Do NOT set font-family here */
        }

        if (isButton) {
          el.style.setProperty('background-color', BRAND, 'important');
          el.style.setProperty('background',       BRAND, 'important');
          el.style.setProperty('border-color',     BRAND, 'important');
          el.style.setProperty('color',            '#FFFFFF', 'important');
          el.style.setProperty('border-radius',    '50px', 'important');
          el.style.setProperty('box-shadow',       '0 4px 12px rgba(198,154,124,0.3)', 'important');
        }

        if (isLink && el.classList.contains('jdgm--active')) {
          el.style.setProperty('border-bottom-color', BRAND, 'important');
          el.style.setProperty('color', BRAND, 'important');
        }
      }

      /* Scan the whole widget area */
      function scanAll() {
        setCSSVars();
        document.querySelectorAll(
          '.jdgm-star, .jdgm-rev-widg__star, .jdgm-form__star, [class*="jdgm-star"],'
          + 'a.jdgm-write-rev-btn, button.jdgm-write-rev-btn, .jdgm-write-rev-btn,'
          + '.jdgm-rev-widg__write-rev-btn, input.jdgm-submit-rev, button.jdgm-submit-rev,'
          + '.jdgm-submit-rev, .jdgm-tab'
        ).forEach(styleEl);

        /* Inject a high-priority override <style> AFTER any Judge.me injected styles */
        injectOverrideStyle();
      }

      /* ── Nuclear override: inject our own <style> tag that beats Judge.me's ── */
      /* Judge.me injects a <style> tag into <head> with green colours via !important.
         We append our own <style> AFTER theirs so cascade order wins, plus use
         equal specificity + !important. We also rewrite their style tag text directly. */
      var overrideStyleEl = null;
      function injectOverrideStyle() {
        /* Rewrite text content of any Judge.me <style> tags to swap green → brand */
        document.querySelectorAll('head style, body style').forEach(function(st) {
          if (!st.textContent) return;
          /* Only touch Judge.me style tags */
          if (!st.textContent.includes('jdgm') && !st.textContent.includes('judge')) return;
          var newText = st.textContent
            /* Green button backgrounds Judge.me uses */
            .replace(/#168474/gi, BRAND)
            .replace(/#1a8a6c/gi, BRAND)
            .replace(/#0d6e56/gi, BRAND)
            .replace(/#159b6a/gi, BRAND)
            .replace(/#16a085/gi, BRAND)
            .replace(/#27ae60/gi, BRAND)
            .replace(/#2ecc71/gi, BRAND)
            .replace(/rgb\(\s*22\s*,\s*132\s*,\s*116\s*\)/gi, 'rgb(198,154,124)')
            .replace(/rgb\(\s*26\s*,\s*138\s*,\s*108\s*\)/gi, 'rgb(198,154,124)');
          if (newText !== st.textContent) {
            st.textContent = newText;
          }
        });

        /* Append / update our own override <style> tag at the very end of <head> */
        if (!overrideStyleEl) {
          overrideStyleEl = document.createElement('style');
          overrideStyleEl.id = 'jdgm-brand-override';
          (document.head || document.body).appendChild(overrideStyleEl);
        }
        overrideStyleEl.textContent = [
          /* Buttons */
          'html body .jdgm-write-rev-btn,',
          'html body a.jdgm-write-rev-btn,',
          'html body button.jdgm-write-rev-btn,',
          'html body .jdgm-rev-widg__write-rev-btn,',
          'html body .jdgm-submit-rev,',
          'html body button.jdgm-submit-rev,',
          'html body input.jdgm-submit-rev {',
          '  background-color: ' + BRAND + ' !important;',
          '  background: ' + BRAND + ' !important;',
          '  border-color: ' + BRAND + ' !important;',
          '  color: #ffffff !important;',
          '  border-radius: 50px !important;',
          '}',
          'html body .jdgm-write-rev-btn:hover,',
          'html body a.jdgm-write-rev-btn:hover,',
          'html body button.jdgm-write-rev-btn:hover {',
          '  background-color: ' + BRANDD + ' !important;',
          '  background: ' + BRANDD + ' !important;',
          '  border-color: ' + BRANDD + ' !important;',
          '}',
          /* Stars — colour only, no font-family */
          'html body .jdgm-star,',
          'html body [class*="jdgm-star"],',
          'html body .jdgm-rev-widg__star {',
          '  color: ' + GOLD + ' !important;',
          '}',
          'html body .jdgm-star.jdgm--off,',
          'html body .jdgm-star.jdgm--empty,',
          'html body .jdgm-rev-widg__star.jdgm--off,',
          'html body .jdgm-rev-widg__star.jdgm--empty {',
          '  color: ' + GREY + ' !important;',
          '  opacity: 0.6 !important;',
          '}',
          /* Tabs */
          'html body .jdgm-tab.jdgm--active {',
          '  border-bottom-color: ' + BRAND + ' !important;',
          '  color: ' + BRAND + ' !important;',
          '}',
          /* Links */
          'html body .jdgm-widget a, html body .jdgm-rev-widg a {',
          '  color: ' + BRAND + ' !important;',
          '}'
        ].join('\n');
      }

      /* MutationObserver — watches BOTH head and body for Judge.me injecting styles */
      var observer = new MutationObserver(function(mutations) {
        var needsScan = false;
        mutations.forEach(function(m) {
          if (m.type === 'childList' && m.addedNodes.length) {
            m.addedNodes.forEach(function(n) {
              /* If Judge.me injected a new <style> tag into <head> */
              if (n.tagName === 'STYLE') needsScan = true;
              if (n.tagName === 'SCRIPT') needsScan = true;
            });
            needsScan = true;
          }
          if (m.type === 'attributes') needsScan = true;
          if (m.type === 'characterData') needsScan = true;
        });
        if (needsScan) scanAll();
      });

      function startObserver() {
        var opts = { childList: true, subtree: true, attributes: true,
                     characterData: true, attributeFilter: ['style', 'class'] };
        /* Watch both <head> and <body> */
        if (document.head) observer.observe(document.head, opts);
        observer.observe(document.body, opts);
      }

      /* Bootstrap */
      setCSSVars();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { scanAll(); startObserver(); });
      } else {
        scanAll();
        startObserver();
      }
      /* Also run on full load (Judge.me JS loads async after page) */
      window.addEventListener('load', function() { scanAll(); });
    })();
    </script>
  </body>
</html>
